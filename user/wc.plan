// Plan word/line/byte counter using GLib & Gee compatibility layer (no C, no .vapi).

using GLib
using Gee

(int, int) count_lines_words (in string text) {
    int lines = 0
    int words = 0
    bool in_word = false
    for (int i = 0; i < text.length; i++) {
        uint8 c = text[i]
        if (c == '\n')
            lines = lines + 1
        bool is_ws = (c == ' ' || c == '\t' || c == '\r' || c == '\n')
        if (is_ws) {
            in_word = false
        } else if (!in_word) {
            in_word = true
            words = words + 1
        }
    }
    return (lines, words)
}

int main (string[] args) {
    var ctx = new OptionContext ("<file>")
    var opt_l = new OptionEntry ("lines", 'l', OptionFlags.NONE, OptionArg.NONE, "Print newline counts")
    var opt_w = new OptionEntry ("words", 'w', OptionFlags.NONE, OptionArg.NONE, "Print word counts")
    var opt_c = new OptionEntry ("bytes", 'c', OptionFlags.NONE, OptionArg.NONE, "Print byte counts")
    var opt_m = new OptionEntry ("chars", 'm', OptionFlags.NONE, OptionArg.NONE, "Print character counts")
    var counting = new OptionGroup ("Counts", "Select the counts to print", null)
    counting.add_entry (opt_l)
    counting.add_entry (opt_w)
    counting.add_entry (opt_c)
    counting.add_entry (opt_m)
    ctx.add_group (counting)
    try {
        ctx.parse (ref args)
    } catch (OptionError e) {
        printerr (@"wc: $(e.message)\n")
        return 1
    }

    if (args.length < 2) {
        printerr ("usage: wc.elf [-l] [-w] [-c] [-m] <file>\n")
        return 1
    }
    string path = args[1]
    if (!FileUtils.test (path, FileTest.EXISTS)) {
        printerr (@"wc: cannot open '$path'\n")
        return 1
    }
    string text = ""
    if (!FileUtils.get_contents (path, out text)) {
        printerr (@"wc: read failed '$path'\n")
        return 1
    }

    var (lines, words) = count_lines_words (text)

    var sb = new StringBuilder ()
    bool any_flag = opt_l.bool_val || opt_w.bool_val || opt_c.bool_val || opt_m.bool_val
    if (!any_flag) {
        sb.append (@"$path: lines=$lines words=$words bytes=$(text.length) chars=$(text.char_count())")
        if (text.contains ("PlanetOS"))
            sb.append (" [has PlanetOS]")
    } else {
        sb.append (@"$path:")
        if (opt_l.bool_val) sb.append (@" lines=$lines")
        if (opt_w.bool_val) sb.append (@" words=$words")
        if (opt_c.bool_val) sb.append (@" bytes=$(text.length)")
        if (opt_m.bool_val) sb.append (@" chars=$(text.char_count())")
    }

    var list = new ArrayList<string> ()
    list.add (sb.str)
    print (@"$(list.get(0))\n")
    return 0
}
