// plan2vala -- Translates PlanetOS `.plan` / extended Vala code into
// standard Vala compilable by `valac` for Stage 0 host bootstrap.
//
// Reuses `Planc.Preprocessor` and `Planc.Lexer` so standard Vala constructs
// pass through cleanly while PlanetOS extensions are lowered:
//   - `foreach ([unowned] T v in arr[start:end]) { ... }` -> zero-copy `for`
//   - `arr[start:end]` -> `_plan_arr_slice (arr, start, end)` (strings keep `s[start:end]`)
//   - `Memory.{set_bytes,copy_bytes,move_bytes,cmp_bytes,c_strlen,c_strcmp,c_strncmp,c_str_to_string}` -> `PlanMem.*`
//   - `Bytes.from_string` -> `PlanBytes.from_string`
//   - `__planc_host_bytes_to_str` -> `_plan_bytes_to_str`
//   - `[AsmBody (...)]` -> stripped when `strip_asm` is enabled

using Planc;

namespace Plan2Vala {

    public class Translator : Object {
        private Token[] toks;
        private int n = 0;
        private bool strip_asm = true;
        private HashTable<string, bool> str_vars;
        private HashTable<string, string> arr_elem_types;
        private int tmp_id = 0;

        public Translator (bool strip_asm = true) {
            this.strip_asm = strip_asm;
            str_vars = new HashTable<string, bool> (str_hash, str_equal);
            arr_elem_types = new HashTable<string, string> (str_hash, str_equal);
        }

        public string translate (string raw_source, GenericArray<string> defines) throws LexError {
            // Note: we pass defines without PLANC unless requested, or let caller control defines.
            string pre = Preprocessor.run (raw_source, defines);
            var lex = new Lexer (pre);
            var list = new GenericArray<Token?> ();
            while (true) {
                var t = lex.next ();
                list.add (t);
                if (t.kind == TokenKind.EOF)
                    break;
            }
            toks = new Token[list.length];
            for (int i = 0; i < list.length; i++)
                toks[i] = (Token) list[i];
            n = toks.length;
            str_vars = new HashTable<string, bool> (str_hash, str_equal);
            arr_elem_types = new HashTable<string, string> (str_hash, str_equal);
            tmp_id = 0;

            var sb = new StrBuilder ("// Generated by plan2vala (Stage 0 Vala).\n");
            emit_range (sb, 0, n - 1);
            return sb.str;
        }

        private string tok_raw (Token t) {
            if (t.kind == TokenKind.STRING)
                return "\"" + escape_str (t.text) + "\"";
            if (t.kind == TokenKind.TEMPLATE_STRING)
                return "@\"" + escape_str (t.text) + "\"";
            return t.text;
        }

        private static string escape_str (string s) {
            var sb = new StrBuilder ();
            for (int i = 0; i < s.length; i++) {
                char c = s[i];
                if (c == '\n') sb.append ("\\n");
                else if (c == '\r') sb.append ("\\r");
                else if (c == '\t') sb.append ("\\t");
                else if (c == '\0') sb.append ("\\0");
                else if (c == '\\') sb.append ("\\\\");
                else if (c == '"') sb.append ("\\\"");
                else sb.append (s.substring (i, 1));
            }
            return sb.str;
        }

        private int find_matching (int open_idx, TokenKind open_k, TokenKind close_k) {
            int depth = 0;
            for (int i = open_idx; i < n; i++) {
                if (toks[i].kind == open_k) depth++;
                else if (toks[i].kind == close_k) {
                    depth--;
                    if (depth == 0) return i;
                }
            }
            return n - 1;
        }

        // Find top-level `:` inside `[ ... ]` (not inside nested `(...)` / `[...]`).
        private int find_slice_colon (int lbrack, int rbrack) {
            int pd = 0;
            int bd = 0;
            for (int i = lbrack + 1; i < rbrack; i++) {
                var k = toks[i].kind;
                if (k == TokenKind.LPAREN) pd++;
                else if (k == TokenKind.RPAREN) pd--;
                else if (k == TokenKind.LBRACKET) bd++;
                else if (k == TokenKind.RBRACKET) bd--;
                else if (k == TokenKind.COLON && pd == 0 && bd == 0)
                    return i;
            }
            return -1;
        }

        private static bool is_mem_helper (string name) {
            return name == "set_bytes" || name == "copy_bytes" || name == "move_bytes"
                || name == "cmp_bytes" || name == "c_strlen" || name == "c_strcmp"
                || name == "c_strncmp" || name == "c_str_to_string";
        }

        private bool is_string_expr (int start, int end) {
            if (start > end) return false;
            if (start == end) {
                if (toks[start].kind == TokenKind.STRING || toks[start].kind == TokenKind.TEMPLATE_STRING)
                    return true;
                if (toks[start].kind == TokenKind.IDENTIFIER)
                    return str_vars.contains (toks[start].text);
            }
            return false;
        }

        private static bool needs_space (Token a, Token b) {
            if (a.kind == TokenKind.DOT || b.kind == TokenKind.DOT) return false;
            if (b.kind == TokenKind.LPAREN && a.kind == TokenKind.IDENTIFIER) return true;
            if (a.kind == TokenKind.LPAREN || b.kind == TokenKind.RPAREN) return false;
            if (a.kind == TokenKind.LBRACKET || b.kind == TokenKind.RBRACKET) return false;
            if (b.kind == TokenKind.LBRACKET || b.kind == TokenKind.COMMA || b.kind == TokenKind.SEMICOLON) return false;
            if (a.kind == TokenKind.PLUSPLUS || a.kind == TokenKind.MINUSMINUS) return false;
            if (b.kind == TokenKind.PLUSPLUS || b.kind == TokenKind.MINUSMINUS) return false;
            if (a.kind == TokenKind.NOT || a.kind == TokenKind.TILDE) return false;
            return true;
        }

        private void emit_range (StrBuilder sb, int from, int to) {
            int i = from;
            while (i < to) {
                var t = toks[i];

                // Track `string x` / `string? x` and `T[] x` declarations.
                if (t.kind == TokenKind.IDENTIFIER && t.text == "string") {
                    int ni = i + 1;
                    if (ni < to && toks[ni].kind == TokenKind.QUESTION) ni++;
                    if (ni < to && toks[ni].kind == TokenKind.IDENTIFIER)
                        str_vars.set (toks[ni].text, true);
                }
                if (t.kind == TokenKind.IDENTIFIER && i + 3 < to
                    && toks[i + 1].kind == TokenKind.LBRACKET && toks[i + 2].kind == TokenKind.RBRACKET) {
                    int ni = i + 3;
                    if (ni < to && toks[ni].kind == TokenKind.QUESTION) ni++;
                    if (ni < to && toks[ni].kind == TokenKind.IDENTIFIER)
                        arr_elem_types.set (toks[ni].text, t.text);
                }

                // Strip `[AsmBody (...)]` and `[Packed]` when requested.
                if (strip_asm && t.kind == TokenKind.LBRACKET && i + 1 < to
                    && toks[i + 1].kind == TokenKind.IDENTIFIER
                    && (toks[i + 1].text == "AsmBody" || toks[i + 1].text == "Packed")) {
                    int rb = find_matching (i, TokenKind.LBRACKET, TokenKind.RBRACKET);
                    i = rb + 1;
                    continue;
                }

                // Rewrite `view<T>` -> `View<T>`.
                if (t.kind == TokenKind.IDENTIFIER && t.text == "view"
                    && i + 1 < to && toks[i + 1].kind == TokenKind.LT) {
                    sb.append ("View");
                    i++;
                    continue;
                }

                // Rewrite `loop (n) { ... }` -> `for (int _p2v_l = 0; _p2v_l < (int)(n); _p2v_l++) { ... }`
                // and `loop { ... }` -> `while (true) { ... }`.
                if (t.kind == TokenKind.IDENTIFIER && t.text == "loop") {
                    if (i + 1 < to && toks[i + 1].kind == TokenKind.LPAREN) {
                        int rp = find_matching (i + 1, TokenKind.LPAREN, TokenKind.RPAREN);
                        int id = tmp_id++;
                        string lv = @"_p2v_l_$id";
                        string nv = @"_p2v_n_$id";
                        sb.append (@"{ int $nv = (int) (");
                        emit_range (sb, i + 2, rp);
                        sb.append (@"); for (int $lv = 0; $lv < $nv; $lv++) ");
                        int body_start = rp + 1;
                        int body_end = body_start;
                        if (body_start < to && toks[body_start].kind == TokenKind.LBRACE) {
                            body_end = find_matching (body_start, TokenKind.LBRACE, TokenKind.RBRACE) + 1;
                        } else {
                            while (body_end < to && toks[body_end].kind != TokenKind.SEMICOLON) body_end++;
                            if (body_end < to) body_end++;
                        }
                        emit_range (sb, body_start, body_end);
                        sb.append (" }\n");
                        i = body_end;
                        continue;
                    }
                    sb.append ("while (true) ");
                    i++;
                    continue;
                }

                // Lower `inverse_foreach ([unowned] [var|Type] x in col) { ... }` -> reverse `for`.
                if (t.kind == TokenKind.IDENTIFIER && t.text == "inverse_foreach"
                    && i + 1 < to && toks[i + 1].kind == TokenKind.LPAREN) {
                    int rp = find_matching (i + 1, TokenKind.LPAREN, TokenKind.RPAREN);
                    int in_idx = -1;
                    for (int k = i + 2; k < rp; k++) {
                        if (toks[k].kind == TokenKind.IDENTIFIER && toks[k].text == "in") {
                            in_idx = k;
                            break;
                        }
                    }
                    if (in_idx > i + 2) {
                        int id = tmp_id++;
                        string arr_v = @"_p2v_rarr_$id";
                        string idx_v = @"_p2v_ri_$id";
                        sb.append ("{\n    var ");
                        sb.append (arr_v);
                        sb.append (" = ");
                        emit_range (sb, in_idx + 1, rp);
                        sb.append (@";\n    for (int $idx_v = $arr_v.length - 1; $idx_v >= 0; $idx_v--) {\n        ");
                        emit_range (sb, i + 2, in_idx);
                        sb.append (@" = $arr_v[$idx_v];\n        ");
                        int body_start = rp + 1;
                        int body_end = body_start;
                        if (body_start < to && toks[body_start].kind == TokenKind.LBRACE) {
                            body_end = find_matching (body_start, TokenKind.LBRACE, TokenKind.RBRACE) + 1;
                        } else {
                            while (body_end < to && toks[body_end].kind != TokenKind.SEMICOLON) body_end++;
                            if (body_end < to) body_end++;
                        }
                        emit_range (sb, body_start, body_end);
                        sb.append ("\n    }\n}\n");
                        i = body_end;
                        continue;
                    }
                }

                // Rewrite `Memory.<helper>` -> `PlanMem.<helper>`.
                if (t.kind == TokenKind.IDENTIFIER && t.text == "Memory"
                    && i + 2 < to && toks[i + 1].kind == TokenKind.DOT
                    && toks[i + 2].kind == TokenKind.IDENTIFIER && is_mem_helper (toks[i + 2].text)) {
                    sb.append ("PlanMem.");
                    sb.append (toks[i + 2].text);
                    i += 3;
                    if (i < to && needs_space (toks[i - 1], toks[i])) sb.append (" ");
                    continue;
                }

                // Rewrite `Bytes.from_string` -> `PlanBytes.from_string`.
                if (t.kind == TokenKind.IDENTIFIER && t.text == "Bytes"
                    && i + 2 < to && toks[i + 1].kind == TokenKind.DOT
                    && toks[i + 2].kind == TokenKind.IDENTIFIER && toks[i + 2].text == "from_string") {
                    sb.append ("PlanBytes.from_string");
                    i += 3;
                    if (i < to && needs_space (toks[i - 1], toks[i])) sb.append (" ");
                    continue;
                }

                // Rewrite `__planc_host_bytes_to_str` -> `_plan_bytes_to_str`.
                if (t.kind == TokenKind.IDENTIFIER && t.text == "__planc_host_bytes_to_str") {
                    sb.append ("_plan_bytes_to_str");
                    i++;
                    if (i < to && needs_space (t, toks[i])) sb.append (" ");
                    continue;
                }

                // Zero-copy lowering for `foreach ([unowned] [var|Type] x in target[start:end]) { ... }`
                if (t.kind == TokenKind.IDENTIFIER && t.text == "foreach"
                    && i + 1 < to && toks[i + 1].kind == TokenKind.LPAREN) {
                    int rp = find_matching (i + 1, TokenKind.LPAREN, TokenKind.RPAREN);
                    int in_idx = -1;
                    for (int k = i + 2; k < rp; k++) {
                        if (toks[k].kind == TokenKind.IDENTIFIER && toks[k].text == "in") {
                            in_idx = k;
                            break;
                        }
                    }
                    if (in_idx > i + 2 && rp - 1 > in_idx && toks[rp - 1].kind == TokenKind.RBRACKET) {
                        // Find matching `[` for `toks[rp - 1]`
                        int lb = -1;
                        int bd = 0;
                        for (int k = rp - 1; k > in_idx; k--) {
                            if (toks[k].kind == TokenKind.RBRACKET) bd++;
                            else if (toks[k].kind == TokenKind.LBRACKET) {
                                bd--;
                                if (bd == 0) { lb = k; break; }
                            }
                        }
                        int col = (lb > in_idx + 1) ? find_slice_colon (lb, rp - 1) : -1;
                        if (col > lb && !is_string_expr (in_idx + 1, lb - 1)) {
                            int id = tmp_id++;
                            string arr_v = @"_p2v_arr_$id";
                            string idx_v = @"_p2v_i_$id";
                            string end_v = @"_p2v_e_$id";
                            sb.append ("{\n    var ");
                            sb.append (arr_v);
                            sb.append (" = ");
                            emit_range (sb, in_idx + 1, lb);
                            sb.append (";\n    int ");
                            sb.append (idx_v);
                            sb.append (" = (int) (");
                            emit_range (sb, lb + 1, col);
                            sb.append (");\n    int ");
                            sb.append (end_v);
                            sb.append (" = (int) (");
                            emit_range (sb, col + 1, rp - 1);
                            sb.append (");\n    for (; ");
                            sb.append (idx_v);
                            sb.append (" < ");
                            sb.append (end_v);
                            sb.append ("; ");
                            sb.append (idx_v);
                            sb.append ("++) {\n        ");
                            emit_range (sb, i + 2, in_idx);
                            sb.append (" = ");
                            sb.append (arr_v);
                            sb.append ("[");
                            sb.append (idx_v);
                            sb.append ("];\n        ");
                            // Emit loop body
                            int body_start = rp + 1;
                            int body_end = body_start;
                            if (body_start < to && toks[body_start].kind == TokenKind.LBRACE) {
                                body_end = find_matching (body_start, TokenKind.LBRACE, TokenKind.RBRACE) + 1;
                            } else {
                                while (body_end < to && toks[body_end].kind != TokenKind.SEMICOLON)
                                    body_end++;
                                if (body_end < to) body_end++;
                            }
                            emit_range (sb, body_start, body_end);
                            sb.append ("\n    }\n}\n");
                            i = body_end;
                            continue;
                        }
                    }
                }

                // Array slice expression: `<ident>[start:end]` (when `<ident>` is not a `string`)
                if (t.kind == TokenKind.IDENTIFIER && i + 1 < to && toks[i + 1].kind == TokenKind.LBRACKET
                    && !str_vars.contains (t.text)) {
                    int rb = find_matching (i + 1, TokenKind.LBRACKET, TokenKind.RBRACKET);
                    int col = find_slice_colon (i + 1, rb);
                    if (col > i + 1) {
                        string? et = arr_elem_types.lookup (t.text);
                        string helper = "_plan_arr_slice";
                        if (et == "int" || et == "uint8" || et == "uint32" || et == "int64" || et == "char" || et == "string")
                            helper = @"_plan_slice_$et";
                        sb.append (helper + " (");
                        sb.append (t.text);
                        sb.append (", ");
                        emit_range (sb, i + 2, col);
                        sb.append (", ");
                        emit_range (sb, col + 1, rb);
                        sb.append (")");
                        i = rb + 1;
                        if (i < to && needs_space (toks[rb], toks[i])) sb.append (" ");
                        continue;
                    }
                }

                sb.append (tok_raw (t));
                if (t.kind == TokenKind.SEMICOLON || t.kind == TokenKind.LBRACE || t.kind == TokenKind.RBRACE)
                    sb.append ("\n");
                else if (i + 1 < to && needs_space (t, toks[i + 1]))
                    sb.append (" ");
                i++;
            }
        }
    }
}
