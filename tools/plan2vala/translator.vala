// plan2vala -- Translates PlanetOS `.plan` / extended Vala code into
// standard Vala compilable by `valac` for Stage 0 host bootstrap.
//
// Reuses `Planc.Preprocessor` and `Planc.Lexer` so standard Vala constructs
// pass through cleanly while PlanetOS extensions are lowered:
//   - `foreach ([unowned] T v in arr[start:end]) { ... }` -> zero-copy `for`
//   - `arr[start:end]` -> `_plan_arr_slice (arr, start, end)` (strings keep `s[start:end]`)
//   - `Memory.{set_bytes,copy_bytes,move_bytes,cmp_bytes,c_strlen,c_strcmp,c_strncmp,c_str_to_string}` -> `PlanMem.*`
//   - `Bytes.from_string` -> `PlanBytes.from_string`
//   - `__planc_host_bytes_to_str` -> `_plan_bytes_to_str`
//   - `[AsmBody (...)]` -> stripped when `strip_asm` is enabled

using Planc;

namespace Plan2Vala {

    public class Translator : Object {
        private Token[] toks;
        private int n = 0;
        private bool strip_asm = true;
        private HashTable<string, bool> str_vars;
        private HashTable<string, string> arr_elem_types;
        private HashTable<string, bool> emitted_tuples;
        private StrBuilder tuple_defs;
        private string cur_tuple_ret = "";
        private int tmp_id = 0;

        public Translator (bool strip_asm = true) {
            this.strip_asm = strip_asm;
            str_vars = new HashTable<string, bool> (str_hash, str_equal);
            arr_elem_types = new HashTable<string, string> (str_hash, str_equal);
        }

        public string translate (string raw_source, GenericArray<string> defines) throws LexError {
            // Note: we pass defines without PLANC unless requested, or let caller control defines.
            string pre = Preprocessor.run (raw_source, defines);
            var lex = new Lexer (pre);
            var list = new GenericArray<Token?> ();
            while (true) {
                var t = lex.next ();
                list.add (t);
                if (t.kind == TokenKind.EOF)
                    break;
            }
            toks = new Token[list.length];
            for (int i = 0; i < list.length; i++)
                toks[i] = (Token) list[i];
            n = toks.length;
            str_vars = new HashTable<string, bool> (str_hash, str_equal);
            arr_elem_types = new HashTable<string, string> (str_hash, str_equal);
            emitted_tuples = new HashTable<string, bool> (str_hash, str_equal);
            tuple_defs = new StrBuilder ();
            cur_tuple_ret = "";
            tmp_id = 0;

            var body_sb = new StrBuilder ();
            var defer_stack = new GenericArray<GenericArray<string>> ();
            var defer_err_stack = new GenericArray<GenericArray<bool>> ();
            var brace_is_init = new GenericArray<bool> ();
            emit_range_ex (body_sb, 0, n - 1, defer_stack, defer_err_stack, brace_is_init);

            var sb = new StrBuilder ("// Generated by plan2vala (Stage 0 Vala).\n");
            if (tuple_defs.str.length > 0) {
                sb.append (tuple_defs.str);
                sb.append ("\n");
            }
            sb.append (body_sb.str);
            return sb.str;
        }

        private void emit_range (StrBuilder sb, int from, int to) {
            var ds = new GenericArray<GenericArray<string>> ();
            var des = new GenericArray<GenericArray<bool>> ();
            var bi = new GenericArray<bool> ();
            emit_range_ex (sb, from, to, ds, des, bi);
        }

        private string tok_raw (Token t) {
            if (t.kind == TokenKind.STRING)
                return "\"" + escape_str (t.text) + "\"";
            if (t.kind == TokenKind.TEMPLATE_STRING)
                return "@\"" + escape_str (t.text) + "\"";
            if (t.kind == TokenKind.INTEGER && t.is_unsigned)
                return t.text + "u";
            return t.text;
        }

        private static string escape_str (string s) {
            var sb = new StrBuilder ();
            for (int i = 0; i < s.length; i++) {
                char c = s[i];
                if (c == '\n') sb.append ("\\n");
                else if (c == '\r') sb.append ("\\r");
                else if (c == '\t') sb.append ("\\t");
                else if (c == '\0') sb.append ("\\0");
                else if (c == '\\') sb.append ("\\\\");
                else if (c == '"') sb.append ("\\\"");
                else sb.append (s.substring (i, 1));
            }
            return sb.str;
        }

        private int find_matching (int open_idx, TokenKind open_k, TokenKind close_k) {
            int depth = 0;
            for (int i = open_idx; i < n; i++) {
                if (toks[i].kind == open_k) depth++;
                else if (toks[i].kind == close_k) {
                    depth--;
                    if (depth == 0) return i;
                }
            }
            return n - 1;
        }

        // Find top-level `:` inside `[ ... ]` (not inside nested `(...)` / `[...]`).
        private int find_slice_colon (int lbrack, int rbrack) {
            int pd = 0;
            int bd = 0;
            for (int i = lbrack + 1; i < rbrack; i++) {
                var k = toks[i].kind;
                if (k == TokenKind.LPAREN) pd++;
                else if (k == TokenKind.RPAREN) pd--;
                else if (k == TokenKind.LBRACKET) bd++;
                else if (k == TokenKind.RBRACKET) bd--;
                else if (k == TokenKind.COLON && pd == 0 && bd == 0)
                    return i;
            }
            return -1;
        }

        private static bool is_mem_helper (string name) {
            return name == "set_bytes" || name == "copy_bytes" || name == "move_bytes"
                || name == "cmp_bytes" || name == "c_strlen" || name == "c_strcmp"
                || name == "c_strncmp" || name == "c_str_to_string";
        }

        private bool is_string_expr (int start, int end) {
            if (start > end) return false;
            if (start == end) {
                if (toks[start].kind == TokenKind.STRING || toks[start].kind == TokenKind.TEMPLATE_STRING)
                    return true;
                if (toks[start].kind == TokenKind.IDENTIFIER)
                    return str_vars.contains (toks[start].text);
            }
            return false;
        }

        private static bool needs_space (Token a, Token b) {
            if (a.kind == TokenKind.DOT || b.kind == TokenKind.DOT) return false;
            if (b.kind == TokenKind.LPAREN && a.kind == TokenKind.IDENTIFIER) return true;
            if (a.kind == TokenKind.LPAREN || b.kind == TokenKind.RPAREN) return false;
            if (a.kind == TokenKind.LBRACKET || b.kind == TokenKind.RBRACKET) return false;
            if (b.kind == TokenKind.LBRACKET || b.kind == TokenKind.COMMA || b.kind == TokenKind.SEMICOLON) return false;
            if (a.kind == TokenKind.PLUSPLUS || a.kind == TokenKind.MINUSMINUS) return false;
            if (b.kind == TokenKind.PLUSPLUS || b.kind == TokenKind.MINUSMINUS) return false;
            if (a.kind == TokenKind.NOT || a.kind == TokenKind.TILDE) return false;
            return true;
        }

        private int find_stmt_end (int start, int to) {
            int pd = 0;
            int bd = 0;
            int brace = 0;
            for (int i = start; i < to; i++) {
                var t = toks[i];
                if (t.kind == TokenKind.LPAREN) pd++;
                else if (t.kind == TokenKind.RPAREN) pd--;
                else if (t.kind == TokenKind.LBRACKET) bd++;
                else if (t.kind == TokenKind.RBRACKET) bd--;
                else if (t.kind == TokenKind.LBRACE) brace++;
                else if (t.kind == TokenKind.RBRACE) {
                    if (brace == 0) return i;
                    brace--;
                    if (brace == 0 && pd == 0 && bd == 0) return i + 1;
                } else if (t.kind == TokenKind.SEMICOLON && pd == 0 && bd == 0 && brace == 0) {
                    return i + 1;
                }
                if (pd == 0 && bd == 0 && brace == 0 && i + 1 < to && toks[i + 1].line > t.line) {
                    if (is_stmt_end_tok (t) && !is_cont_tok (toks[i + 1]))
                        return i + 1;
                }
            }
            return to;
        }

        private static bool is_stmt_end_tok (Token t) {
            if (t.kind == TokenKind.IDENTIFIER || t.kind == TokenKind.INTEGER
                || t.kind == TokenKind.FLOAT || t.kind == TokenKind.STRING
                || t.kind == TokenKind.TEMPLATE_STRING
                || t.kind == TokenKind.RPAREN || t.kind == TokenKind.RBRACKET
                || t.kind == TokenKind.PLUSPLUS || t.kind == TokenKind.MINUSMINUS)
                return true;
            return false;
        }

        private static bool is_cont_tok (Token t) {
            var k = t.kind;
            return k == TokenKind.DOT || k == TokenKind.COMMA || k == TokenKind.SEMICOLON
                || k == TokenKind.RPAREN || k == TokenKind.RBRACKET
                || k == TokenKind.LBRACE || k == TokenKind.COLON || k == TokenKind.QUESTION
                || k == TokenKind.ANDAND || k == TokenKind.OROR || k == TokenKind.EQ
                || k == TokenKind.NE || k == TokenKind.LT || k == TokenKind.GT
                || k == TokenKind.LE || k == TokenKind.GE || k == TokenKind.PLUS
                || k == TokenKind.MINUS || k == TokenKind.STAR || k == TokenKind.SLASH
                || k == TokenKind.PERCENT || k == TokenKind.AMP || k == TokenKind.PIPE
                || k == TokenKind.CARET || k == TokenKind.ASSIGN;
        }

        private string register_tuple_type (int lp, int rp) {
            var ftypes = new GenericArray<string> ();
            var sb_name = new StrBuilder ("_P2VTuple");
            int cur_start = lp + 1;
            int pd = 0;
            int ad = 0;
            for (int k = lp + 1; k <= rp; k++) {
                bool at_end = (k == rp);
                if (!at_end) {
                    if (toks[k].kind == TokenKind.LPAREN) pd++;
                    else if (toks[k].kind == TokenKind.RPAREN) pd--;
                    else if (toks[k].kind == TokenKind.LT) ad++;
                    else if (toks[k].kind == TokenKind.GT) ad--;
                }
                if (at_end || (toks[k].kind == TokenKind.COMMA && pd == 0 && ad == 0)) {
                    var ft_sb = new StrBuilder ();
                    for (int j = cur_start; j < k; j++) {
                        ft_sb.append (tok_raw (toks[j]));
                        if (j + 1 < k && needs_space (toks[j], toks[j + 1])) ft_sb.append (" ");
                    }
                    string fts = ft_sb.str.strip ();
                    ftypes.add (fts);
                    sb_name.append ("__");
                    for (int c = 0; c < fts.length; c++) {
                        char ch = fts[c];
                        if ((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9'))
                            sb_name.append (fts.substring (c, 1));
                        else
                            sb_name.append ("_");
                    }
                    cur_start = k + 1;
                }
            }
            string tname = sb_name.str;
            if (!emitted_tuples.contains (tname)) {
                emitted_tuples.set (tname, true);
                tuple_defs.append (@"public struct $tname {\n");
                for (int fi = 0; fi < ftypes.length; fi++)
                    tuple_defs.append (@"    public $(ftypes[fi]) _$fi;\n");
                tuple_defs.append ("}\n");
            }
            return tname;
        }

        private static void emit_defers (StrBuilder sb, GenericArray<GenericArray<string>> defer_stack,
                                         GenericArray<GenericArray<bool>> defer_err_stack,
                                         int min_depth, bool include_err) {
            for (int d = defer_stack.length - 1; d >= min_depth; d--) {
                var fr = defer_stack[d];
                var efr = defer_err_stack[d];
                for (int j = fr.length - 1; j >= 0; j--) {
                    if (efr[j] && !include_err) continue;
                    sb.append (fr[j]);
                    sb.append ("\n");
                }
            }
        }

        private void emit_range_ex (StrBuilder sb, int from, int to,
                                    GenericArray<GenericArray<string>> defer_stack,
                                    GenericArray<GenericArray<bool>> defer_err_stack,
                                    GenericArray<bool> brace_is_init) {
            int i = from;
            int pd = 0;
            int bd = 0;
            bool in_cond_header = false;
            int cond_pd = 0;
            bool in_param_list = false;
            int param_pd = 0;
            while (i < to) {
                var t = toks[i];

                // Track `{` / `}` for defer frames and initializer braces.
                if (t.kind == TokenKind.LBRACE) {
                    in_cond_header = false;
                    bool is_init = (i > from && (toks[i - 1].kind == TokenKind.ASSIGN
                        || toks[i - 1].kind == TokenKind.RBRACKET
                        || toks[i - 1].kind == TokenKind.COMMA
                        || toks[i - 1].kind == TokenKind.LBRACE));
                    brace_is_init.add (is_init);
                    if (!is_init) {
                        defer_stack.add (new GenericArray<string> ());
                        defer_err_stack.add (new GenericArray<bool> ());
                    }
                    sb.append ("{\n");
                    i++;
                    continue;
                }
                if (t.kind == TokenKind.RBRACE) {
                    bool is_init = false;
                    if (brace_is_init.length > 0) {
                        is_init = brace_is_init[brace_is_init.length - 1];
                        brace_is_init.remove_index (brace_is_init.length - 1);
                    }
                    if (!is_init && defer_stack.length > 0) {
                        emit_defers (sb, defer_stack, defer_err_stack, defer_stack.length - 1, false);
                        defer_stack.remove_index (defer_stack.length - 1);
                        defer_err_stack.remove_index (defer_err_stack.length - 1);
                    }
                    sb.append ("}");
                    if (is_init && i + 1 < to && toks[i + 1].kind == TokenKind.SEMICOLON) {
                        sb.append (";\n");
                        i += 2;
                        continue;
                    }
                    sb.append ("\n");
                    i++;
                    continue;
                }

                bool was_cond_rparen = false;
                // Track `(` / `)` and `[` / `]`.
                if (t.kind == TokenKind.LPAREN) {
                    pd++;
                } else if (t.kind == TokenKind.RPAREN) {
                    pd--;
                    if (in_cond_header && pd < cond_pd) {
                        in_cond_header = false;
                        was_cond_rparen = true;
                    }
                    if (in_param_list && pd < param_pd) in_param_list = false;
                } else if (t.kind == TokenKind.LBRACKET) {
                    bd++;
                } else if (t.kind == TokenKind.RBRACKET) {
                    bd--;
                }

                // Strip `requires (...)` and `ensures (...)` contracts.
                if (t.kind == TokenKind.IDENTIFIER && (t.text == "requires" || t.text == "ensures")
                    && i + 1 < to && toks[i + 1].kind == TokenKind.LPAREN) {
                    int rp = find_matching (i + 1, TokenKind.LPAREN, TokenKind.RPAREN);
                    i = rp + 1;
                    continue;
                }

                // Strip `in` parameter modifier inside function/method parameter lists.
                if (in_param_list && t.kind == TokenKind.IDENTIFIER && t.text == "in"
                    && i > from && (toks[i - 1].kind == TokenKind.LPAREN || toks[i - 1].kind == TokenKind.COMMA)) {
                    i++;
                    continue;
                }

                // Tuple return type `(T0, T1, ...) name[!]` before `(`
                if (t.kind == TokenKind.LPAREN && pd == 1 && bd == 0) {
                    int rp = find_matching (i, TokenKind.LPAREN, TokenKind.RPAREN);
                    int comma_cnt = 0;
                    int tpd = 0;
                    for (int k = i + 1; k < rp; k++) {
                        if (toks[k].kind == TokenKind.LPAREN) tpd++;
                        else if (toks[k].kind == TokenKind.RPAREN) tpd--;
                        else if (toks[k].kind == TokenKind.COMMA && tpd == 0) comma_cnt++;
                    }
                    int after = rp + 1;
                    if (comma_cnt > 0 && after + 1 < to && toks[after].kind == TokenKind.IDENTIFIER
                        && toks[after].text != "requires" && toks[after].text != "ensures") {
                        int after_name = after + 1;
                        if (after_name < to && toks[after_name].kind == TokenKind.NOT) after_name++;
                        if (after_name < to && toks[after_name].kind == TokenKind.LPAREN) {
                            string tname = register_tuple_type (i, rp);
                            cur_tuple_ret = tname;
                            pd--; // balance the LPAREN we already counted
                            sb.append (tname);
                            sb.append (" ");
                            i = rp + 1;
                            continue;
                        }
                    }
                }

                // `var (a, b, ...) = expr` destructuring
                if (t.kind == TokenKind.IDENTIFIER && t.text == "var"
                    && i + 1 < to && toks[i + 1].kind == TokenKind.LPAREN) {
                    int rp = find_matching (i + 1, TokenKind.LPAREN, TokenKind.RPAREN);
                    if (rp + 1 < to && toks[rp + 1].kind == TokenKind.ASSIGN) {
                        int se = find_stmt_end (rp + 2, to);
                        int id = tmp_id++;
                        string tv = @"_p2v_tup_$id";
                        sb.append (@"var $tv = ");
                        emit_range_ex (sb, rp + 2, se, defer_stack, defer_err_stack, brace_is_init);
                        if (se > 0 && toks[se - 1].kind != TokenKind.SEMICOLON) sb.append (";");
                        sb.append ("\n");
                        int vidx = 0;
                        for (int k = i + 2; k < rp; k++) {
                            if (toks[k].kind == TokenKind.IDENTIFIER) {
                                sb.append (@"var $(toks[k].text) = $tv._$vidx;\n");
                                vidx++;
                            }
                        }
                        i = se;
                        continue;
                    }
                }

                // `defer <stmt>` / `errdefer <stmt>`
                if (t.kind == TokenKind.IDENTIFIER && (t.text == "defer" || t.text == "errdefer")) {
                    bool is_err = (t.text == "errdefer");
                    int se = find_stmt_end (i + 1, to);
                    var dsb = new StrBuilder ();
                    emit_range (dsb, i + 1, se);
                    string ds = dsb.str.strip ();
                    if (ds.length > 0 && !ds.has_suffix (";") && !ds.has_suffix ("}"))
                        ds += ";";
                    if (defer_stack.length > 0) {
                        defer_stack[defer_stack.length - 1].add (ds);
                        defer_err_stack[defer_err_stack.length - 1].add (is_err);
                    }
                    i = se;
                    continue;
                }

                // `throws <expr>` -> `{ _p2v_err_code = (int) (<expr>); throw new _P2VLightError.CODE (""); }`
                if (t.kind == TokenKind.IDENTIFIER && t.text == "throws"
                    && i + 1 < to && toks[i + 1].kind != TokenKind.IDENTIFIER) {
                    // Check if it's a statement (inside a block) vs signature `throws Domain`
                    if (defer_stack.length > 0) {
                        int se = find_stmt_end (i + 1, to);
                        sb.append ("{ _p2v_err_code = (int) (");
                        emit_range (sb, i + 1, (se > i + 1 && toks[se - 1].kind == TokenKind.SEMICOLON) ? se - 1 : se);
                        sb.append ("); throw new _P2VLightError.CODE (\"\"); }\n");
                        i = se;
                        continue;
                    }
                }
                if (t.kind == TokenKind.IDENTIFIER && t.text == "throws" && defer_stack.length > 0
                    && i + 1 < to && toks[i + 1].kind == TokenKind.IDENTIFIER) {
                    int se = find_stmt_end (i + 1, to);
                    sb.append ("{ _p2v_err_code = (int) (");
                    emit_range (sb, i + 1, (se > i + 1 && toks[se - 1].kind == TokenKind.SEMICOLON) ? se - 1 : se);
                    sb.append ("); throw new _P2VLightError.CODE (\"\"); }\n");
                    i = se;
                    continue;
                }

                // `catch (int e) { ... }` / `catch { ... }`
                if (t.kind == TokenKind.IDENTIFIER && t.text == "catch") {
                    if (i + 1 < to && toks[i + 1].kind == TokenKind.LBRACE) {
                        sb.append ("catch (_P2VLightError _p2v_ex) ");
                        i++;
                        continue;
                    }
                    if (i + 4 < to && toks[i + 1].kind == TokenKind.LPAREN
                        && toks[i + 2].kind == TokenKind.IDENTIFIER && toks[i + 2].text == "int"
                        && toks[i + 3].kind == TokenKind.IDENTIFIER && toks[i + 4].kind == TokenKind.RPAREN) {
                        string evar = toks[i + 3].text;
                        sb.append (@"catch (_P2VLightError _p2v_ex) { int $evar = _p2v_err_code;\n");
                        if (i + 5 < to && toks[i + 5].kind == TokenKind.LBRACE) {
                            defer_stack.add (new GenericArray<string> ());
                            defer_err_stack.add (new GenericArray<bool> ());
                            i += 6;
                            continue;
                        }
                        i += 5;
                        continue;
                    }
                }

                // `fn! (...)` declaration vs call
                if (t.kind == TokenKind.IDENTIFIER && i + 2 < to
                    && toks[i + 1].kind == TokenKind.NOT && toks[i + 2].kind == TokenKind.LPAREN) {
                    int rp = find_matching (i + 2, TokenKind.LPAREN, TokenKind.RPAREN);
                    bool is_decl = (rp + 1 < to && (toks[rp + 1].kind == TokenKind.LBRACE
                        || (toks[rp + 1].kind == TokenKind.IDENTIFIER
                            && (toks[rp + 1].text == "requires" || toks[rp + 1].text == "ensures"))));
                    sb.append (t.text);
                    sb.append (" (");
                    in_param_list = is_decl;
                    param_pd = pd + 1;
                    pd++;
                    // Emit params up to rp, then if is_decl append `throws _P2VLightError`
                    emit_range_ex (sb, i + 3, rp, defer_stack, defer_err_stack, brace_is_init);
                    in_param_list = false;
                    pd--;
                    sb.append (")");
                    if (is_decl) sb.append (" throws _P2VLightError");
                    else if (pd == 0 && bd == 0 && !in_cond_header
                             && rp + 1 < to && toks[rp + 1].line > toks[rp].line
                             && !is_cont_tok (toks[rp + 1]))
                        sb.append (";\n");
                    sb.append (" ");
                    i = rp + 1;
                    continue;
                }

                // `return ...` with defers or tuple return literal
                if (t.kind == TokenKind.IDENTIFIER && t.text == "return") {
                    int se = find_stmt_end (i + 1, to);
                    int expr_end = (se > i + 1 && toks[se - 1].kind == TokenKind.SEMICOLON) ? se - 1 : se;
                    bool has_def = false;
                    for (int d = 0; d < defer_stack.length; d++) {
                        for (int j = 0; j < defer_stack[d].length; j++) {
                            if (!defer_err_stack[d][j]) { has_def = true; break; }
                        }
                    }
                    bool is_tup_lit = (cur_tuple_ret != "" && i + 1 < expr_end && toks[i + 1].kind == TokenKind.LPAREN);
                    var val_sb = new StrBuilder ();
                    if (is_tup_lit) {
                        int rp = find_matching (i + 1, TokenKind.LPAREN, TokenKind.RPAREN);
                        val_sb.append (@"$cur_tuple_ret () { ");
                        int cur_s = i + 2;
                        int fpd = 0;
                        int fi = 0;
                        for (int k = i + 2; k <= rp; k++) {
                            bool at_end = (k == rp);
                            if (!at_end) {
                                if (toks[k].kind == TokenKind.LPAREN) fpd++;
                                else if (toks[k].kind == TokenKind.RPAREN) fpd--;
                            }
                            if (at_end || (toks[k].kind == TokenKind.COMMA && fpd == 0)) {
                                if (fi > 0) val_sb.append (", ");
                                val_sb.append (@"_$fi = ");
                                emit_range (val_sb, cur_s, k);
                                fi++;
                                cur_s = k + 1;
                            }
                        }
                        val_sb.append (" }");
                    } else if (i + 1 < expr_end) {
                        emit_range (val_sb, i + 1, expr_end);
                    }
                    if (has_def) {
                        if (val_sb.str.length > 0) {
                            int id = tmp_id++;
                            sb.append (@"{ var _p2v_ret_$id = $(val_sb.str);\n");
                            emit_defers (sb, defer_stack, defer_err_stack, 0, false);
                            sb.append (@"return _p2v_ret_$id; }\n");
                        } else {
                            sb.append ("{\n");
                            emit_defers (sb, defer_stack, defer_err_stack, 0, false);
                            sb.append ("return; }\n");
                        }
                    } else {
                        if (val_sb.str.length > 0)
                            sb.append (@"return $(val_sb.str);\n");
                        else
                            sb.append ("return;\n");
                    }
                    i = se;
                    continue;
                }

                // Track control headers (`if`, `while`, `for`, `foreach`, `switch`, `lock`) so we don't insert `;` at EOL.
                if (t.kind == TokenKind.IDENTIFIER
                    && (t.text == "if" || t.text == "while" || t.text == "for"
                        || t.text == "foreach" || t.text == "switch" || t.text == "lock")
                    && i + 1 < to && toks[i + 1].kind == TokenKind.LPAREN) {
                    in_cond_header = true;
                    cond_pd = pd + 1;
                }

                // Detect `in` inside function/method parameter lists (`Type name (`).
                if (t.kind == TokenKind.LPAREN && i > from && toks[i - 1].kind == TokenKind.IDENTIFIER
                    && !in_cond_header && !in_param_list) {
                    in_param_list = true;
                    param_pd = pd;
                }

                // Track `string x` / `string? x` and `T[] x` declarations.
                if (t.kind == TokenKind.IDENTIFIER && t.text == "string") {
                    int ni = i + 1;
                    if (ni < to && toks[ni].kind == TokenKind.QUESTION) ni++;
                    if (ni < to && toks[ni].kind == TokenKind.IDENTIFIER)
                        str_vars.set (toks[ni].text, true);
                }
                if (t.kind == TokenKind.IDENTIFIER && i + 3 < to
                    && toks[i + 1].kind == TokenKind.LBRACKET && toks[i + 2].kind == TokenKind.RBRACKET) {
                    int ni = i + 3;
                    if (ni < to && toks[ni].kind == TokenKind.QUESTION) ni++;
                    if (ni < to && toks[ni].kind == TokenKind.IDENTIFIER)
                        arr_elem_types.set (toks[ni].text, t.text);
                }

                // Strip Plan-only / Stage-0 attributes (`[AsmBody]`, `[Packed]`, `[NoAlloc]`, `[AlwaysInline]`, `[Wrap]`, `[CheckedOverflow]`, `[Arena]`).
                if (t.kind == TokenKind.LBRACKET && i + 1 < to
                    && toks[i + 1].kind == TokenKind.IDENTIFIER
                    && ((strip_asm && (toks[i + 1].text == "AsmBody" || toks[i + 1].text == "Packed"))
                        || toks[i + 1].text == "NoAlloc" || toks[i + 1].text == "AlwaysInline"
                        || toks[i + 1].text == "Wrap" || toks[i + 1].text == "CheckedOverflow"
                        || toks[i + 1].text == "Arena")) {
                    int rb = find_matching (i, TokenKind.LBRACKET, TokenKind.RBRACKET);
                    i = rb + 1;
                    continue;
                }

                // Rewrite `view<T>` -> `View<T>`.
                if (t.kind == TokenKind.IDENTIFIER && t.text == "view"
                    && i + 1 < to && toks[i + 1].kind == TokenKind.LT) {
                    sb.append ("View");
                    i++;
                    continue;
                }

                // Rewrite `loop (n) { ... }` -> `for (int _p2v_l = 0; _p2v_l < (int)(n); _p2v_l++) { ... }`
                // and `loop { ... }` -> `while (true) { ... }`.
                if (t.kind == TokenKind.IDENTIFIER && t.text == "loop") {
                    if (i + 1 < to && toks[i + 1].kind == TokenKind.LPAREN) {
                        int rp = find_matching (i + 1, TokenKind.LPAREN, TokenKind.RPAREN);
                        int id = tmp_id++;
                        string lv = @"_p2v_l_$id";
                        string nv = @"_p2v_n_$id";
                        sb.append (@"{ int $nv = (int) (");
                        emit_range (sb, i + 2, rp);
                        sb.append (@"); for (int $lv = 0; $lv < $nv; $lv++) ");
                        int body_start = rp + 1;
                        int body_end = body_start;
                        if (body_start < to && toks[body_start].kind == TokenKind.LBRACE) {
                            body_end = find_matching (body_start, TokenKind.LBRACE, TokenKind.RBRACE) + 1;
                        } else {
                            while (body_end < to && toks[body_end].kind != TokenKind.SEMICOLON) body_end++;
                            if (body_end < to) body_end++;
                        }
                        emit_range (sb, body_start, body_end);
                        sb.append (" }\n");
                        i = body_end;
                        continue;
                    }
                    sb.append ("while (true) ");
                    i++;
                    continue;
                }

                // Lower `inverse_foreach ([unowned] [var|Type] x in col) { ... }` -> reverse `for`.
                if (t.kind == TokenKind.IDENTIFIER && t.text == "inverse_foreach"
                    && i + 1 < to && toks[i + 1].kind == TokenKind.LPAREN) {
                    int rp = find_matching (i + 1, TokenKind.LPAREN, TokenKind.RPAREN);
                    int in_idx = -1;
                    for (int k = i + 2; k < rp; k++) {
                        if (toks[k].kind == TokenKind.IDENTIFIER && toks[k].text == "in") {
                            in_idx = k;
                            break;
                        }
                    }
                    if (in_idx > i + 2) {
                        int id = tmp_id++;
                        string arr_v = @"_p2v_rarr_$id";
                        string idx_v = @"_p2v_ri_$id";
                        sb.append ("{\n    var ");
                        sb.append (arr_v);
                        sb.append (" = ");
                        emit_range (sb, in_idx + 1, rp);
                        sb.append (@";\n    for (int $idx_v = $arr_v.length - 1; $idx_v >= 0; $idx_v--) {\n        ");
                        emit_range (sb, i + 2, in_idx);
                        sb.append (@" = $arr_v[$idx_v];\n        ");
                        int body_start = rp + 1;
                        int body_end = body_start;
                        if (body_start < to && toks[body_start].kind == TokenKind.LBRACE) {
                            body_end = find_matching (body_start, TokenKind.LBRACE, TokenKind.RBRACE) + 1;
                        } else {
                            while (body_end < to && toks[body_end].kind != TokenKind.SEMICOLON) body_end++;
                            if (body_end < to) body_end++;
                        }
                        emit_range (sb, body_start, body_end);
                        sb.append ("\n    }\n}\n");
                        i = body_end;
                        continue;
                    }
                }

                // Rewrite `Memory.<helper>` -> `PlanMem.<helper>`.
                if (t.kind == TokenKind.IDENTIFIER && t.text == "Memory"
                    && i + 2 < to && toks[i + 1].kind == TokenKind.DOT
                    && toks[i + 2].kind == TokenKind.IDENTIFIER && is_mem_helper (toks[i + 2].text)) {
                    sb.append ("PlanMem.");
                    sb.append (toks[i + 2].text);
                    i += 3;
                    if (i < to && needs_space (toks[i - 1], toks[i])) sb.append (" ");
                    continue;
                }

                // Rewrite `Bytes.from_string` -> `PlanBytes.from_string`.
                if (t.kind == TokenKind.IDENTIFIER && t.text == "Bytes"
                    && i + 2 < to && toks[i + 1].kind == TokenKind.DOT
                    && toks[i + 2].kind == TokenKind.IDENTIFIER && toks[i + 2].text == "from_string") {
                    sb.append ("PlanBytes.from_string");
                    i += 3;
                    if (i < to && needs_space (toks[i - 1], toks[i])) sb.append (" ");
                    continue;
                }

                // Rewrite `__planc_host_bytes_to_str` -> `_plan_bytes_to_str`.
                if (t.kind == TokenKind.IDENTIFIER && t.text == "__planc_host_bytes_to_str") {
                    sb.append ("_plan_bytes_to_str");
                    i++;
                    if (i < to && needs_space (t, toks[i])) sb.append (" ");
                    continue;
                }

                // Zero-copy lowering for `foreach ([unowned] [var|Type] x in target[start:end]) { ... }`
                if (t.kind == TokenKind.IDENTIFIER && t.text == "foreach"
                    && i + 1 < to && toks[i + 1].kind == TokenKind.LPAREN) {
                    int rp = find_matching (i + 1, TokenKind.LPAREN, TokenKind.RPAREN);
                    int in_idx = -1;
                    for (int k = i + 2; k < rp; k++) {
                        if (toks[k].kind == TokenKind.IDENTIFIER && toks[k].text == "in") {
                            in_idx = k;
                            break;
                        }
                    }
                    if (in_idx > i + 2 && rp - 1 > in_idx && toks[rp - 1].kind == TokenKind.RBRACKET) {
                        // Find matching `[` for `toks[rp - 1]`
                        int lb = -1;
                        int fbd = 0;
                        for (int k = rp - 1; k > in_idx; k--) {
                            if (toks[k].kind == TokenKind.RBRACKET) fbd++;
                            else if (toks[k].kind == TokenKind.LBRACKET) {
                                fbd--;
                                if (fbd == 0) { lb = k; break; }
                            }
                        }
                        int col = (lb > in_idx + 1) ? find_slice_colon (lb, rp - 1) : -1;
                        if (col > lb && !is_string_expr (in_idx + 1, lb - 1)) {
                            int id = tmp_id++;
                            string arr_v = @"_p2v_arr_$id";
                            string idx_v = @"_p2v_i_$id";
                            string end_v = @"_p2v_e_$id";
                            sb.append ("{\n    var ");
                            sb.append (arr_v);
                            sb.append (" = ");
                            emit_range (sb, in_idx + 1, lb);
                            sb.append (";\n    int ");
                            sb.append (idx_v);
                            sb.append (" = (int) (");
                            emit_range (sb, lb + 1, col);
                            sb.append (");\n    int ");
                            sb.append (end_v);
                            sb.append (" = (int) (");
                            emit_range (sb, col + 1, rp - 1);
                            sb.append (");\n    for (; ");
                            sb.append (idx_v);
                            sb.append (" < ");
                            sb.append (end_v);
                            sb.append ("; ");
                            sb.append (idx_v);
                            sb.append ("++) {\n        ");
                            emit_range (sb, i + 2, in_idx);
                            sb.append (" = ");
                            sb.append (arr_v);
                            sb.append ("[");
                            sb.append (idx_v);
                            sb.append ("];\n        ");
                            // Emit loop body
                            int body_start = rp + 1;
                            int body_end = body_start;
                            if (body_start < to && toks[body_start].kind == TokenKind.LBRACE) {
                                body_end = find_matching (body_start, TokenKind.LBRACE, TokenKind.RBRACE) + 1;
                            } else {
                                while (body_end < to && toks[body_end].kind != TokenKind.SEMICOLON)
                                    body_end++;
                                if (body_end < to) body_end++;
                            }
                            emit_range (sb, body_start, body_end);
                            sb.append ("\n    }\n}\n");
                            i = body_end;
                            continue;
                        }
                    }
                }

                // Array slice expression: `<ident>[start:end]` (when `<ident>` is not a `string`)
                if (t.kind == TokenKind.IDENTIFIER && i + 1 < to && toks[i + 1].kind == TokenKind.LBRACKET
                    && !str_vars.contains (t.text)) {
                    int rb = find_matching (i + 1, TokenKind.LBRACKET, TokenKind.RBRACKET);
                    int col = find_slice_colon (i + 1, rb);
                    if (col > i + 1) {
                        string? et = arr_elem_types.lookup (t.text);
                        string helper = "_plan_arr_slice";
                        if (et == "int" || et == "uint8" || et == "uint32" || et == "int64" || et == "char" || et == "string")
                            helper = @"_plan_slice_$et";
                        sb.append (helper + " (");
                        sb.append (t.text);
                        sb.append (", ");
                        emit_range (sb, i + 2, col);
                        sb.append (", ");
                        emit_range (sb, col + 1, rb);
                        sb.append (")");
                        i = rb + 1;
                        if (i < to && needs_space (toks[rb], toks[i])) sb.append (" ");
                        continue;
                    }
                }

                sb.append (tok_raw (t));
                if (t.kind == TokenKind.SEMICOLON) {
                    sb.append ("\n");
                } else if (pd == 0 && bd == 0 && !in_cond_header && !was_cond_rparen
                           && i + 1 < to && toks[i + 1].line > t.line
                           && is_stmt_end_tok (t) && !is_cont_tok (toks[i + 1])
                           && !(brace_is_init.length > 0 && brace_is_init[brace_is_init.length - 1]
                                && toks[i + 1].kind == TokenKind.RBRACE)
                           && !(toks[i + 1].kind == TokenKind.IDENTIFIER
                                && (toks[i + 1].text == "requires" || toks[i + 1].text == "ensures"
                                    || toks[i + 1].text == "throws"))) {
                    sb.append (";\n");
                } else if (i + 1 < to && needs_space (t, toks[i + 1])) {
                    sb.append (" ");
                }
                i++;
            }
        }
    }
}
