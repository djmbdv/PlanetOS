    azHelp = new string[183];
    azHelp[0] = ".auth ON|OFF             Show authorizer callbacks";
    azHelp[1] = ".backup ?DB? FILE        Backup DB (default \"main\") to FILE";
    azHelp[2] = "   Options:";
    azHelp[3] = "       --append            Use the appendvfs";
    azHelp[4] = "       --async             Write to FILE without journal and fsync()";
    azHelp[5] = ".bail on|off             Stop after hitting an error.  Default OFF";
    azHelp[6] = ".cd DIRECTORY            Change the working directory to DIRECTORY";
    azHelp[7] = ".changes on|off          Show number of rows changed by SQL";
    azHelp[8] = ".check GLOB              Fail if output since .testcase does not match";
    azHelp[9] = ".clone NEWDB             Clone data into NEWDB from the existing database";
    azHelp[10] = ".connection [close] [#]  Open or close an auxiliary database connection";
    azHelp[11] = ".crlf ?on|off?           Whether or not to use \\r\\n line endings";
    azHelp[12] = ".databases               List names and files of attached databases";
    azHelp[13] = ".dbconfig ?op? ?val?     List or change sqlite3_db_config() options";
    azHelp[14] = ".dump ?OBJECTS?          Render database content as SQL";
    azHelp[15] = "   Options:";
    azHelp[16] = "     --data-only            Output only INSERT statements";
    azHelp[17] = "     --newlines             Allow unescaped newline characters in output";
    azHelp[18] = "     --nosys                Omit system tables (ex: \"sqlite_stat1\")";
    azHelp[19] = "     --preserve-rowids      Include ROWID values in the output";
    azHelp[20] = "   OBJECTS is a LIKE pattern for tables, indexes, triggers or views to dump";
    azHelp[21] = "   Additional LIKE patterns can be given in subsequent arguments";
    azHelp[22] = ".echo on|off             Turn command echo on or off";
    azHelp[23] = ".eqp on|off|full|...     Enable or disable automatic EXPLAIN QUERY PLAN";
    azHelp[24] = "   Other Modes:";
    azHelp[25] = "      trigger               Like \"full\" but also show trigger bytecode";
    azHelp[26] = ".excel                   Display the output of next command in spreadsheet";
    azHelp[27] = "   --bom                   Put a UTF8 byte-order mark on intermediate file";
    azHelp[28] = ".exit ?CODE?             Exit this program with return-code CODE";
    azHelp[29] = ".expert                  EXPERIMENTAL. Suggest indexes for queries";
    azHelp[30] = ".explain ?on|off|auto?   Change the EXPLAIN formatting mode.  Default: auto";
    azHelp[31] = ".filectrl CMD ...        Run various sqlite3_file_control() operations";
    azHelp[32] = "   --schema SCHEMA         Use SCHEMA instead of \"main\"";
    azHelp[33] = "   --help                  Show CMD details";
    azHelp[34] = ".fullschema ?--indent?   Show schema and the content of sqlite_stat tables";
    azHelp[35] = ".headers on|off          Turn display of headers on or off";
    azHelp[36] = ".help ?-all? ?PATTERN?   Show help text for PATTERN";
    azHelp[37] = ".import FILE TABLE       Import data from FILE into TABLE";
    azHelp[38] = "   Options:";
    azHelp[39] = "     --ascii               Use \\037 and \\036 as column and row separators";
    azHelp[40] = "     --csv                 Use , and \\n as column and row separators";
    azHelp[41] = "     --skip N              Skip the first N rows of input";
    azHelp[42] = "     --schema S            Target table to be S.TABLE";
    azHelp[43] = "     -v                    \"Verbose\" - increase auxiliary output";
    azHelp[44] = "   Notes:";
    azHelp[45] = "     *  If TABLE does not exist, it is created.  The first row of input";
    azHelp[46] = "        determines the column names.";
    azHelp[47] = "     *  If neither --csv or --ascii are used, the input mode is derived";
    azHelp[48] = "        from the \".mode\" output mode";
    azHelp[49] = "     *  If FILE begins with \"|\" then it is a command that generates the";
    azHelp[50] = "        input text.";
    azHelp[51] = ",imposter INDEX TABLE    Create imposter table TABLE on index INDEX";
    azHelp[52] = ".indexes ?TABLE?         Show names of indexes";
    azHelp[53] = "                           If TABLE is specified, only show indexes for";
    azHelp[54] = "                           tables matching TABLE using the LIKE operator.";
    azHelp[55] = ".intck ?STEPS_PER_UNLOCK?  Run an incremental integrity check on the db";
    azHelp[56] = ".limit ?LIMIT? ?VAL?     Display or change the value of an SQLITE_LIMIT";
    azHelp[57] = ".lint OPTIONS            Report potential schema issues.";
    azHelp[58] = "     Options:";
    azHelp[59] = "        fkey-indexes     Find missing foreign key indexes";
    azHelp[60] = ".load FILE ?ENTRY?       Load an extension library";
    azHelp[61] = ".log FILE|on|off         Turn logging on or off.  FILE can be stderr/stdout";
    azHelp[62] = ".mode MODE ?OPTIONS?     Set output mode";
    azHelp[63] = "   MODE is one of:";
    azHelp[64] = "     ascii       Columns/rows delimited by 0x1F and 0x1E";
    azHelp[65] = "     box         Tables using unicode box-drawing characters";
    azHelp[66] = "     csv         Comma-separated values";
    azHelp[67] = "     column      Output in columns.  (See .width)";
    azHelp[68] = "     html        HTML <table> code";
    azHelp[69] = "     insert      SQL insert statements for TABLE";
    azHelp[70] = "     json        Results in a JSON array";
    azHelp[71] = "     line        One value per line";
    azHelp[72] = "     list        Values delimited by \"|\"";
    azHelp[73] = "     markdown    Markdown table format";
    azHelp[74] = "     qbox        Shorthand for \"box --wrap 60 --quote\"";
    azHelp[75] = "     quote       Escape answers as for SQL";
    azHelp[76] = "     table       ASCII-art table";
    azHelp[77] = "     tabs        Tab-separated values";
    azHelp[78] = "     tcl         TCL list elements";
    azHelp[79] = "   OPTIONS: (for columnar modes or insert mode):";
    azHelp[80] = "     --wrap N       Wrap output lines to no longer than N characters";
    azHelp[81] = "     --wordwrap B   Wrap or not at word boundaries per B (on/off)";
    azHelp[82] = "     --ww           Shorthand for \"--wordwrap 1\"";
    azHelp[83] = "     --quote        Quote output text as SQL literals";
    azHelp[84] = "     --noquote      Do not quote output text";
    azHelp[85] = "     TABLE          The name of SQL table used for \"insert\" mode";
    azHelp[86] = ".nonce STRING            Suspend safe mode for one command if nonce matches";
    azHelp[87] = ".nullvalue STRING        Use STRING in place of NULL values";
    azHelp[88] = ".once ?OPTIONS? ?FILE?   Output for the next SQL command only to FILE";
    azHelp[89] = "     If FILE begins with '|' then open as a pipe";
    azHelp[90] = "       --bom    Put a UTF8 byte-order mark at the beginning";
    azHelp[91] = "       -e       Send output to the system text editor";
    azHelp[92] = "       --plain  Use text/plain output instead of HTML for -w option";
    azHelp[93] = "       -w       Send output as HTML to a web browser (same as \".www\")";
    azHelp[94] = "       -x       Send output as CSV to a spreadsheet (same as \".excel\")";
    azHelp[95] = ".open ?OPTIONS? ?FILE?   Close existing database and reopen FILE";
    azHelp[96] = "     Options:";
    azHelp[97] = "        --append        Use appendvfs to append database to the end of FILE";
    azHelp[98] = "        --deserialize   Load into memory using sqlite3_deserialize()";
    azHelp[99] = "        --hexdb         Load the output of \"dbtotxt\" as an in-memory db";
    azHelp[100] = "        --maxsize N     Maximum size for --hexdb or --deserialized database";
    azHelp[101] = "        --new           Initialize FILE to an empty database";
    azHelp[102] = "        --nofollow      Do not follow symbolic links";
    azHelp[103] = "        --readonly      Open FILE readonly";
    azHelp[104] = "        --zip           FILE is a ZIP archive";
    azHelp[105] = ".output ?FILE?           Send output to FILE or stdout if FILE is omitted";
    azHelp[106] = "   If FILE begins with '|' then open it as a pipe.";
    azHelp[107] = "   Options:";
    azHelp[108] = "     --bom                 Prefix output with a UTF8 byte-order mark";
    azHelp[109] = "     -e                    Send output to the system text editor";
    azHelp[110] = "     --plain               Use text/plain for -w option";
    azHelp[111] = "     -w                    Send output to a web browser";
    azHelp[112] = "     -x                    Send output as CSV to a spreadsheet";
    azHelp[113] = ".parameter CMD ...       Manage SQL parameter bindings";
    azHelp[114] = "   clear                   Erase all bindings";
    azHelp[115] = "   init                    Initialize the TEMP table that holds bindings";
    azHelp[116] = "   list                    List the current parameter bindings";
    azHelp[117] = "   set PARAMETER VALUE     Given SQL parameter PARAMETER a value of VALUE";
    azHelp[118] = "                           PARAMETER should start with one of: $ : @ ?";
    azHelp[119] = "   unset PARAMETER         Remove PARAMETER from the binding table";
    azHelp[120] = ".print STRING...         Print literal STRING";
    azHelp[121] = ".progress N              Invoke progress handler after every N opcodes";
    azHelp[122] = "   --limit N                 Interrupt after N progress callbacks";
    azHelp[123] = "   --once                    Do no more than one progress interrupt";
    azHelp[124] = "   --quiet|-q                No output except at interrupts";
    azHelp[125] = "   --reset                   Reset the count for each input and interrupt";
    azHelp[126] = ".prompt MAIN CONTINUE    Replace the standard prompts";
    azHelp[127] = ".quit                    Stop interpreting input stream, exit if primary.";
    azHelp[128] = ".read FILE               Read input from FILE or command output";
    azHelp[129] = "    If FILE begins with \"|\", it is a command that generates the input.";
    azHelp[130] = ".restore ?DB? FILE       Restore content of DB (default \"main\") from FILE";
    azHelp[131] = ".save ?OPTIONS? FILE     Write database to FILE (an alias for .backup ...)";
    azHelp[132] = ".scanstats on|off|est    Turn sqlite3_stmt_scanstatus() metrics on or off";
    azHelp[133] = ".schema ?PATTERN?        Show the CREATE statements matching PATTERN";
    azHelp[134] = "   Options:";
    azHelp[135] = "      --indent             Try to pretty-print the schema";
    azHelp[136] = "      --nosys              Omit objects whose names start with \"sqlite_\"";
    azHelp[137] = ",selftest ?OPTIONS?      Run tests defined in the SELFTEST table";
    azHelp[138] = "    Options:";
    azHelp[139] = "       --init               Create a new SELFTEST table";
    azHelp[140] = "       -v                   Verbose output";
    azHelp[141] = ".separator COL ?ROW?     Change the column and row separators";
    azHelp[142] = ".sha3sum ...             Compute a SHA3 hash of database content";
    azHelp[143] = "    Options:";
    azHelp[144] = "      --schema              Also hash the sqlite_schema table";
    azHelp[145] = "      --sha3-224            Use the sha3-224 algorithm";
    azHelp[146] = "      --sha3-256            Use the sha3-256 algorithm (default)";
    azHelp[147] = "      --sha3-384            Use the sha3-384 algorithm";
    azHelp[148] = "      --sha3-512            Use the sha3-512 algorithm";
    azHelp[149] = "    Any other argument is a LIKE pattern for tables to hash";
    azHelp[150] = ".shell CMD ARGS...       Run CMD ARGS... in a system shell";
    azHelp[151] = ".show                    Show the current values for various settings";
    azHelp[152] = ".stats ?ARG?             Show stats or turn stats on or off";
    azHelp[153] = "   off                      Turn off automatic stat display";
    azHelp[154] = "   on                       Turn on automatic stat display";
    azHelp[155] = "   stmt                     Show statement stats";
    azHelp[156] = "   vmstep                   Show the virtual machine step count only";
    azHelp[157] = ".system CMD ARGS...      Run CMD ARGS... in a system shell";
    azHelp[158] = ".tables ?TABLE?          List names of tables matching LIKE pattern TABLE";
    azHelp[159] = ",testcase NAME           Begin redirecting output to 'testcase-out.txt'";
    azHelp[160] = ",testctrl CMD ...        Run various sqlite3_test_control() operations";
    azHelp[161] = "                           Run \".testctrl\" with no arguments for details";
    azHelp[162] = ".timeout MS              Try opening locked tables for MS milliseconds";
    azHelp[163] = ".timer on|off            Turn SQL timer on or off";
    azHelp[164] = ".trace ?OPTIONS?         Output each SQL statement as it is run";
    azHelp[165] = "    FILE                    Send output to FILE";
    azHelp[166] = "    stdout                  Send output to stdout";
    azHelp[167] = "    stderr                  Send output to stderr";
    azHelp[168] = "    off                     Disable tracing";
