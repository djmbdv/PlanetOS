// c2vala-ptrs: zSql_buf[IDX|ARITH|NULL]=>uint8[](ro) db_obj[NULL]=>T? zCode_buf[IDX|WR]=>uint8[] zMsg_obj[PLAIN]=>T?
string shell_error_context (uint8[] zSql, sqlite3? db) {
    int _off_zSql = 0;
    int iOffset = 0;
    size_t len = 0;
    uint8[] zCode = new uint8[0];
    string zMsg = "";
    int i = 0;
    if ((((db == null) || (zSql == null)) || (c_assign_i (sqlite3_error_offset (db), ref iOffset) < 0)) || (iOffset >= c_strlen ((string) zSql))) 
    {
        return sqlite3_mprintf (("").data);
    }
    while (iOffset > 50) 
    {
        iOffset--;
        _off_zSql++;
        while ((((int) zSql[_off_zSql + (int) (0)]) & 0xc0) == 0x80) 
        {
            _off_zSql++;
            iOffset--;
        }
    }
    len = (size_t) (c_strlen ((string) zSql));
    if (len > ((size_t) 78)) 
    {
        len = (size_t) 78;
        while ((len > ((size_t) 0)) && ((((int) zSql[_off_zSql + (int) (len)]) & 0xc0) == 0x80)) {
            len--;
        }
    }
    zCode = (sqlite3_mprintf (("%.*s").data, len, zSql)).data;
    shell_check_oom (zCode);
    for (i = 0; zCode[(int) (i)] != 0; i++) 
    {
        if (c_isspace ((int) (((uchar) (zSql[_off_zSql + (int) (i)])))) != 0) {
            zCode[(int) (i)] = (uint8) (' ');
        }
    }
    if (iOffset < 25) 
    {
        zMsg = sqlite3_mprintf (("\n  %z\n  %*s^--- error here").data, zCode, iOffset, "");
    }
    else 
    {
        zMsg = sqlite3_mprintf (("\n  %z\n  %*serror here ---^").data, zCode, (iOffset - 14), "");
    }
    return zMsg;
}

// c2vala-ptrs: p_obj[DEREF|ARROW]=>T? zSelect_obj[PLAIN]=>T? pSelect_obj[ADDR|NULL]=>T? z_buf[IDX|ARITH|NULL]=>uint8[](ro) zContext_obj[PLAIN]=>T?
int run_table_dump_query (ShellState[] p, uint8[] zSelect) {
    sqlite3_stmt?[] pSelect = new sqlite3_stmt?[1];
    int rc = 0;
    int nResult = 0;
    int i = 0;
    uint8[] z = new uint8[0];
    int _off_z = 0;
    rc = sqlite3_prepare_v2 (p[0].db, zSelect, -1, pSelect, new uint8[0]);
    if ((rc != 0) || (!(pSelect[0] != null))) 
    {
        uint8[] zContext = (shell_error_context (zSelect, p[0].db)).data;
        p[0].@out.puts (@"/**** ERROR: ($(rc)) $(sqlite3_errmsg (p[0].db)) *****/\n$((string) zContext)");
        sqlite3_free (zContext);
        if ((rc & 0xff) != 11) {
            p[0].nErr++;
        }
        return rc;
    }
    rc = sqlite3_step (pSelect[0]);
    nResult = sqlite3_column_count (pSelect[0]);
    while (rc == 100) 
    {
        z = (sqlite3_column_text (pSelect[0], 0)).data;
        _off_z = 0;
        p[0].@out.puts (@"$((string) z)");
        for (i = 1; i < nResult; i++) 
        {
            p[0].@out.puts (@",$(sqlite3_column_text (pSelect[0], i))");
        }
        if (z == null) {
            z = ("").data;
            _off_z = 0;
        }
        while ((z[_off_z + (int) (0)] != 0) && ((z[_off_z + (int) (0)] != '-') || (z[_off_z + (int) (1)] != '-'))) {
            _off_z++;
        }
        if (z[_off_z + (int) (0)] != 0) 
        {
            p[0].@out.puts ("\n;\n");
        }
        else 
        {
            p[0].@out.puts (";\n");
        }
        rc = sqlite3_step (pSelect[0]);
    }
    rc = sqlite3_finalize (pSelect[0]);
    if (rc != 0) 
    {
        p[0].@out.puts (@"/**** ERROR: ($(rc)) $(sqlite3_errmsg (p[0].db)) *****/\n");
        if ((rc & 0xff) != 11) {
            p[0].nErr++;
        }
    }
    return rc;
}

// c2vala-ptrs: db_obj[PLAIN]=>T? zPhase_obj[PLAIN]=>T? zSql_obj[PLAIN]=>T? zErr_obj[PLAIN]=>T? zContext_obj[PLAIN]=>T? pStr_obj[PLAIN]=>T?
uint8[] save_err_msg (sqlite3? db, uint8[] zPhase, int rc, uint8[] zSql) {
    uint8[] zErr = new uint8[0];
    uint8[] zContext = new uint8[0];
    sqlite3_str? pStr = sqlite3_str_new (null);
