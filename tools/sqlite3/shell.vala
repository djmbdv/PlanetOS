    azHelp[99] = "        --hexdb         Load the output of \"dbtotxt\" as an in-memory db";
    azHelp[100] = "        --maxsize N     Maximum size for --hexdb or --deserialized database";
    azHelp[101] = "        --new           Initialize FILE to an empty database";
    azHelp[102] = "        --nofollow      Do not follow symbolic links";
    azHelp[103] = "        --readonly      Open FILE readonly";
    azHelp[104] = "        --zip           FILE is a ZIP archive";
    azHelp[105] = ".output ?FILE?           Send output to FILE or stdout if FILE is omitted";
    azHelp[106] = "   If FILE begins with '|' then open it as a pipe.";
    azHelp[107] = "   Options:";
    azHelp[108] = "     --bom                 Prefix output with a UTF8 byte-order mark";
    azHelp[109] = "     -e                    Send output to the system text editor";
    azHelp[110] = "     --plain               Use text/plain for -w option";
    azHelp[111] = "     -w                    Send output to a web browser";
    azHelp[112] = "     -x                    Send output as CSV to a spreadsheet";
    azHelp[113] = ".parameter CMD ...       Manage SQL parameter bindings";
