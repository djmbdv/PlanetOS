// c2vala-ptrs: out_obj[PLAIN]=>T? zLabel_obj[PLAIN]=>T? zFormat_buf[IDX|NULL]=>uint8[](ro) zLine_buf[PLAIN]=>uint8[](ro)
void displayStatLine (FileStream? @out, uint8[] zLabel, uint8[] zFormat, int iStatusCtrl, int bReset) {
    int64[] iCur = new int64[1];
    iCur[0] = (int64) (-1);
    int64[] iHiwtr = new int64[1];
    iHiwtr[0] = (int64) (-1);
    int i = 0;
    int nPercent = 0;
    char[] zLine = new char[200];
    sqlite3_status64 (iStatusCtrl, iCur, iHiwtr, bReset);
    {
        i = 0;
        nPercent = 0;
        for (; zFormat[(int) (i)] != 0; i++) 
        {
            if (zFormat[(int) (i)] == '%') {
                nPercent++;
            }
        }
    }
    if (nPercent > 1) 
    {
        sqlite3_snprintf ((int) (((int) (200) * 1)), zLine, zFormat, iCur[0], iHiwtr[0]);
    }
    else 
    {
        sqlite3_snprintf ((int) (((int) (200) * 1)), zLine, zFormat, iHiwtr[0]);
    }
    @out.puts (@"$((string) zLabel) $((string) zLine)\n");
}

// c2vala-ptrs: db_obj[PLAIN]=>T? pArg_obj[DEREF|NULL|ARROW]=>T? out_obj[PLAIN]=>T? pStmt_obj[PLAIN]=>T? z_buf[ARITH]=>uint8[](ro)
int display_stats (sqlite3? db, ShellState[] pArg, int bReset) {
    int[] iCur = new int[1];
    int[] iHiwtr = new int[1];
    FileStream? @out = null;
    if ((pArg == null) || (pArg[0].@out == null)) {
        return 0;
    }
    @out = pArg[0].@out;
    if ((pArg[0].pStmt != null) && (pArg[0].statsOn == ((uint32) 2))) 
    {
        int nCol = 0;
        int i = 0;
        int[] x = new int[1];
        sqlite3_stmt? pStmt = pArg[0].pStmt;
        char[] z = new char[100];
        nCol = sqlite3_column_count (pStmt);
        @out.puts (@"$("Number of output columns:") $(nCol)\n");
        for (i = 0; i < nCol; i++) 
        {
            sqlite3_snprintf ((int) (((int) (100) * 1)), z, ("Column %d %nname:").data, i, x);
            @out.puts (@"$((string) z) $(sqlite3_column_name (pStmt, i))\n");
            sqlite3_snprintf (30, _c2v_slice_char (z, (int) (x[0])), ("declared type:").data);
            @out.puts (@"$((string) z) $(sqlite3_column_decltype (pStmt, i))\n");
        }
    }
    if (pArg[0].statsOn == ((uint32) 3)) 
    {
        if (pArg[0].pStmt != null) 
        {
            iCur[0] = sqlite3_stmt_status (pArg[0].pStmt, 4, bReset);
            @out.puts (@"VM-steps: $(iCur[0])\n");
        }
        return 0;
    }
    displayStatLine (@out, ("Memory Used:").data, ("%lld (max %lld) bytes").data, 0, bReset);
    displayStatLine (@out, ("Number of Outstanding Allocations:").data, ("%lld (max %lld)").data, 9, bReset);
    if ((pArg[0].shellFlgs & ((uint32) 0x00000001)) != 0) 
    {
        displayStatLine (@out, ("Number of Pcache Pages Used:").data, ("%lld (max %lld) pages").data, 1, bReset);
    }
    displayStatLine (@out, ("Number of Pcache Overflow Bytes:").data, ("%lld (max %lld) bytes").data, 2, bReset);
    displayStatLine (@out, ("Largest Allocation:").data, ("%lld bytes").data, 5, bReset);
    displayStatLine (@out, ("Largest Pcache Allocation:").data, ("%lld bytes").data, 7, bReset);
    if (db != null) 
    {
        if ((pArg[0].shellFlgs & ((uint32) 0x00000002)) != 0) 
        {
            iCur[0] = -1;
            iHiwtr[0] = iCur[0];
            sqlite3_db_status (db, 0, iCur, iHiwtr, bReset);
            @out.puts (@"Lookaside Slots Used:                $(iCur[0]) (max $(iHiwtr[0]))\n");
            sqlite3_db_status (db, 4, iCur, iHiwtr, bReset);
            @out.puts (@"Successful lookaside attempts:       $(iHiwtr[0])\n");
            sqlite3_db_status (db, 5, iCur, iHiwtr, bReset);
            @out.puts (@"Lookaside failures due to size:      $(iHiwtr[0])\n");
            sqlite3_db_status (db, 6, iCur, iHiwtr, bReset);
            @out.puts (@"Lookaside failures due to OOM:       $(iHiwtr[0])\n");
        }
        iCur[0] = -1;
        iHiwtr[0] = iCur[0];
        sqlite3_db_status (db, 1, iCur, iHiwtr, bReset);
        @out.puts (@"Pager Heap Usage:                    $(iCur[0]) bytes\n");
        iCur[0] = -1;
        iHiwtr[0] = iCur[0];
        sqlite3_db_status (db, 7, iCur, iHiwtr, 1);
        @out.puts (@"Page cache hits:                     $(iCur[0])\n");
        iCur[0] = -1;
        iHiwtr[0] = iCur[0];
        sqlite3_db_status (db, 8, iCur, iHiwtr, 1);
        @out.puts (@"Page cache misses:                   $(iCur[0])\n");
        iCur[0] = -1;
        iHiwtr[0] = iCur[0];
        sqlite3_db_status (db, 9, iCur, iHiwtr, 1);
        @out.puts (@"Page cache writes:                   $(iCur[0])\n");
        iCur[0] = -1;
        iHiwtr[0] = iCur[0];
        sqlite3_db_status (db, 12, iCur, iHiwtr, 1);
        @out.puts (@"Page cache spills:                   $(iCur[0])\n");
        iCur[0] = -1;
        iHiwtr[0] = iCur[0];
        sqlite3_db_status (db, 2, iCur, iHiwtr, bReset);
        @out.puts (@"Schema Heap Usage:                   $(iCur[0]) bytes\n");
        iCur[0] = -1;
        iHiwtr[0] = iCur[0];
        sqlite3_db_status (db, 3, iCur, iHiwtr, bReset);
        @out.puts (@"Statement Heap/Lookaside Usage:      $(iCur[0]) bytes\n");
    }
    if (pArg[0].pStmt != null) 
    {
        int iHit = 0;
        int iMiss = 0;
        iCur[0] = sqlite3_stmt_status (pArg[0].pStmt, 1, bReset);
        @out.puts (@"Fullscan Steps:                      $(iCur[0])\n");
        iCur[0] = sqlite3_stmt_status (pArg[0].pStmt, 2, bReset);
        @out.puts (@"Sort Operations:                     $(iCur[0])\n");
        iCur[0] = sqlite3_stmt_status (pArg[0].pStmt, 3, bReset);
        @out.puts (@"Autoindex Inserts:                   $(iCur[0])\n");
        iHit = sqlite3_stmt_status (pArg[0].pStmt, 8, bReset);
        iMiss = sqlite3_stmt_status (pArg[0].pStmt, 7, bReset);
        if ((iHit != 0) || (iMiss != 0)) 
        {
            @out.puts (@"Bloom filter bypass taken:           $(iHit)/$((iHit + iMiss))\n");
        }
        iCur[0] = sqlite3_stmt_status (pArg[0].pStmt, 4, bReset);
        @out.puts (@"Virtual Machine Steps:               $(iCur[0])\n");
        iCur[0] = sqlite3_stmt_status (pArg[0].pStmt, 5, bReset);
        @out.puts (@"Reprepare operations:                $(iCur[0])\n");
        iCur[0] = sqlite3_stmt_status (pArg[0].pStmt, 6, bReset);
        @out.puts (@"Number of times run:                 $(iCur[0])\n");
        iCur[0] = sqlite3_stmt_status (pArg[0].pStmt, 99, bReset);
        @out.puts (@"Memory used by prepared stmt:        $(iCur[0])\n");
    }
    return 0;
}

