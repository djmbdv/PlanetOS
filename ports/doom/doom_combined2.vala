        {
            print (@"Supported game versions:\n");
            for (i = 0; gameversions[(int) (i)].description != null; ++i) 
            {
                print (@"\t$(gameversions[(int) (i)].cmdline) ($(gameversions[(int) (i)].description))\n");
            }
            I_Error (c_str_to_bytes ("Unknown game version '%s'"), myargv[(int) ((p + 1))]);
        }
    }
    else 
    {
        if (gamemission == GameMission_t.pack_chex) 
        {
            gameversion = GameVersion_t.exe_chex;
        }
        else 
        if (gamemission == GameMission_t.pack_hacx) 
        {
            gameversion = GameVersion_t.exe_hacx;
        }
        else 
        if ((gamemode == GameMode_t.shareware) || (gamemode == GameMode_t.registered)) 
        {
            gameversion = GameVersion_t.exe_doom_1_9;
        }
        else 
        if (gamemode == GameMode_t.retail) 
        {
            gameversion = GameVersion_t.exe_ultimate;
        }
        else 
        if (gamemode == GameMode_t.commercial) 
        {
            if (gamemission == GameMission_t.doom2) 
            {
                gameversion = GameVersion_t.exe_doom_1_9;
            }
            else 
            {
                gameversion = GameVersion_t.exe_final;
            }
        }
    }
    if ((gameversion < GameVersion_t.exe_ultimate) && (gamemode == GameMode_t.retail)) 
    {
        gamemode = GameMode_t.registered;
    }
    if (((gameversion < GameVersion_t.exe_final) && (gamemode == GameMode_t.commercial)) && ((gamemission == GameMission_t.pack_tnt) || (gamemission == GameMission_t.pack_plut))) 
    {
        gamemission = GameMission_t.doom2;
    }
}

void PrintGameVersion () {
    int i = 0;
    for (i = 0; gameversions[(int) (i)].description != null; ++i) 
    {
        if (gameversions[(int) (i)].version == gameversion) 
        {
            print (@"Emulating the behavior of the '$(gameversions[(int) (i)].description)' executable.\n");
            break;
        }
    }
}

