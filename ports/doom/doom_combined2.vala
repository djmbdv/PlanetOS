public int16[] clipbot;

public int16[] cliptop;

// c2vala-ptrs: spr_obj[DEREF|ARROW]=>T? ds_arr[ARITH|DEREF|ARROW]=>T[]
void R_DrawSprite (vissprite_s? spr) {
    drawseg_s[] ds = new drawseg_s[0];
    int _off_ds = 0;
    int x = 0;
    int r1 = 0;
    int r2 = 0;
    int scale = 0;
    int lowscale = 0;
    int silhouette = 0;
    for (x = spr.x1; x <= spr.x2; x++) {
        cliptop[(int) (x)] = -2;
        clipbot[(int) (x)] = cliptop[(int) (x)];
    }
    {
        ds = ds_p;
        _off_ds = 0 - (int) (1);
        for (; (ds.length > 0 && drawsegs.length > 0 && ds[0] == drawsegs[0]) ? (_off_ds >= 0) : (uintptr.from_pointer ((void*) (ds)) >= uintptr.from_pointer ((void*) (drawsegs))); _off_ds--) 
        {
            if (((ds[_off_ds].x1 > spr.x2) || (ds[_off_ds].x2 < spr.x1)) || ((!(ds[_off_ds].silhouette != 0)) && (!(ds[_off_ds].maskedtexturecol != null)))) 
            {
                continue;
            }
            r1 = ((ds[_off_ds].x1 < spr.x1) ? spr.x1 : ds[_off_ds].x1);
            r2 = ((ds[_off_ds].x2 > spr.x2) ? spr.x2 : ds[_off_ds].x2);
            if (ds[_off_ds].scale1 > ds[_off_ds].scale2) 
            {
                lowscale = ds[_off_ds].scale2;
                scale = ds[_off_ds].scale1;
            }
            else 
            {
                lowscale = ds[_off_ds].scale1;
                scale = ds[_off_ds].scale2;
            }
            if ((scale < spr.scale) || ((lowscale < spr.scale) && (!(R_PointOnSegSide (spr.gx, spr.gy, ds[_off_ds].curline) != 0)))) 
            {
                if (ds[_off_ds].maskedtexturecol != null) {
                    R_RenderMaskedSegRange (_c2v_slice_drawseg_s (ds, _off_ds), r1, r2);
                }
                continue;
            }
            silhouette = ds[_off_ds].silhouette;
            if (spr.gz >= ds[_off_ds].bsilheight) {
                silhouette &= ~1;
            }
            if (spr.gzt <= ds[_off_ds].tsilheight) {
                silhouette &= ~2;
            }
            if (silhouette == 1) 
            {
                for (x = r1; x <= r2; x++) {
                    if (((int) clipbot[(int) (x)]) == -2) {
                        clipbot[(int) (x)] = ds[_off_ds].sprbottomclip[(int) (x)];
                    }
                }
            }
            else 
            if (silhouette == 2) 
            {
                for (x = r1; x <= r2; x++) {
                    if (((int) cliptop[(int) (x)]) == -2) {
                        cliptop[(int) (x)] = ds[_off_ds].sprtopclip[(int) (x)];
                    }
                }
            }
            else 
            if (silhouette == 3) 
            {
                for (x = r1; x <= r2; x++) 
                {
                    if (((int) clipbot[(int) (x)]) == -2) {
                        clipbot[(int) (x)] = ds[_off_ds].sprbottomclip[(int) (x)];
                    }
                    if (((int) cliptop[(int) (x)]) == -2) {
                        cliptop[(int) (x)] = ds[_off_ds].sprtopclip[(int) (x)];
                    }
                }
            }
        }
    }
    for (x = spr.x1; x <= spr.x2; x++) 
    {
        if (((int) clipbot[(int) (x)]) == -2) {
            clipbot[(int) (x)] = (int16) viewheight;
        }
        if (((int) cliptop[(int) (x)]) == -2) {
            cliptop[(int) (x)] = (int16) (-1);
        }
    }
    mfloorclip = clipbot;
    mceilingclip = cliptop;
    R_DrawVisSprite (spr, spr.x1, spr.x2);
}

// c2vala-ptrs: spr_obj[DEREF|NULL|ARROW]=>T? ds_arr[ARITH|DEREF|ARROW]=>T[]
void R_DrawMasked () {
    vissprite_s? spr = null;
    drawseg_s[] ds = new drawseg_s[0];
    int _off_ds = 0;
    R_SortVisSprites ();
