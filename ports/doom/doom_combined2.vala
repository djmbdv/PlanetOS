void A_WeaponReady (player_s? player, pspdef_t? psp) {
    statenum_t newstate = (statenum_t) 0;
    int angle = 0;
    if ((player.mo.state == states[(int) (statenum_t.S_PLAY_ATK1)]) || (player.mo.state == states[(int) (statenum_t.S_PLAY_ATK2)])) 
    {
        P_SetMobjState (_c2v_box_mobj_s_arr (player.mo), statenum_t.S_PLAY);
    }
    if ((player.readyweapon == weapontype_t.wp_chainsaw) && (psp.state == states[(int) (statenum_t.S_SAW)])) 
    {
        0;
    }
    if ((player.pendingweapon != weapontype_t.wp_nochange) || (!(player.health != 0))) 
    {
        newstate = (statenum_t) (weaponinfo[(int) (player.readyweapon)].downstate);
        P_SetPsprite (player, (int) psprnum_t.ps_weapon, newstate);
        return;
    }
    if ((player.cmd.buttons & ((int) buttoncode_t.BT_ATTACK)) != 0) 
    {
        if ((!(player.attackdown != 0)) || ((player.readyweapon != weapontype_t.wp_missile) && (player.readyweapon != weapontype_t.wp_bfg))) 
        {
            player.attackdown = 1;
            P_FireWeapon (player);
            return;
        }
    }
    else {
        player.attackdown = 0;
    }
    angle = ((128 * leveltime) & (8192 - 1));
    psp.sx = ((1 << 16) + FixedMul (player.bob, finecosine[(int) (angle)]));
    angle &= ((8192 / 2) - 1);
    psp.sy = ((32 * (1 << 16)) + FixedMul (player.bob, finesine[(int) (angle)]));
}

// c2vala-ptrs: player_obj[DEREF|WR|ARROW]=>T? psp_obj[PLAIN]=>T?
void A_ReFire (player_s? player, pspdef_t? psp) {
    if ((((player.cmd.buttons & ((int) buttoncode_t.BT_ATTACK)) != 0) && (player.pendingweapon == weapontype_t.wp_nochange)) && (player.health != 0)) 
    {
        player.refire++;
        P_FireWeapon (player);
    }
    else 
    {
        player.refire = 0;
        P_CheckAmmo (player);
    }
}

