    }
    if (((gameaction == gameaction_t.ga_nothing) && (!(singledemo != 0))) && ((demoplayback != 0) || (gamestate == gamestate_t.GS_DEMOSCREEN))) 
    {
        if (((ev.type == evtype_t.ev_keydown) || ((ev.type == evtype_t.ev_mouse) && (ev.data1 != 0))) || ((ev.type == evtype_t.ev_joystick) && (ev.data1 != 0))) 
        {
            M_StartControlPanel ();
