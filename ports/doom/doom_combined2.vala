// c2vala-ptrs: source_obj[DEREF|ARROW]=>T? dest_obj[DEREF|ARROW]=>T? th_obj[DEREF|WR|ARROW]=>T?
mobj_s[] P_SpawnMissile (mobj_s[] source, mobj_s[] dest, mobjtype_t type) {
    mobj_s[] th = new mobj_s[0];
    uint32 an = 0;
    int dist = 0;
    th = P_SpawnMobj (source[0].x, source[0].y, (source[0].z + ((4 * 8) * (1 << 16))), type);
    if (th[0].info.seesound != 0) {
        0;
    }
    th[0].target = _c2v_box_mobj_s_obj (source);
    an = R_PointToAngle2 (source[0].x, source[0].y, dest[0].x, dest[0].y);
    if ((dest[0].flags & ((int) mobjflag_t.MF_SHADOW)) != 0) {
        an += (uint32) (((P_Random () - P_Random ()) << 20));
    }
    th[0].angle = an;
    an >>= (uint32) 19;
    th[0].momx = FixedMul (th[0].info.speed, finecosine[(int) (an)]);
    th[0].momy = FixedMul (th[0].info.speed, finesine[(int) (an)]);
    dist = P_AproxDistance ((dest[0].x - source[0].x), (dest[0].y - source[0].y));
    dist = (dist / th[0].info.speed);
    if (dist < 1) {
        dist = 1;
    }
    th[0].momz = ((dest[0].z - source[0].z) / dist);
    P_CheckMissileSpawn (th);
    return th;
}

// c2vala-ptrs: source_obj[DEREF|ARROW]=>T? th_obj[DEREF|WR|ARROW]=>T?
void P_SpawnPlayerMissile (mobj_s[] source, mobjtype_t type) {
