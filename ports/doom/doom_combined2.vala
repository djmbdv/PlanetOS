void G_DoLoadGame () {
    int savedleveltime = 0;
    gameaction = gameaction_t.ga_nothing;
    save_stream = FileStream.open ((string) savename, "rb");
    if (save_stream == null) 
    {
        return;
    }
    savegame_error = (uint32) 0;
    if (!(P_ReadSaveGameHeader () != 0)) 
    {
        save_stream = null;
        return;
    }
    savedleveltime = leveltime;
    G_InitNew (gameskill, gameepisode, gamemap);
    leveltime = savedleveltime;
    P_UnArchivePlayers ();
    P_UnArchiveWorld ();
    P_UnArchiveThinkers ();
    P_UnArchiveSpecials ();
    if (!(P_ReadSaveGameEOF () != 0)) {
        I_Error (c_str_to_bytes ("Bad savegame"));
    }
    save_stream = null;
    if (setsizeneeded != 0) {
        R_ExecuteSetViewSize ();
    }
    R_FillBackScreen ();
}

