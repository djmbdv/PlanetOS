    {
        if ((player.powers[(int) (powertype_t.pw_infrared)] > (4 * 32)) || ((player.powers[(int) (powertype_t.pw_infrared)] & 8) != 0)) 
        {
            player.fixedcolormap = 1;
        }
        else {
            player.fixedcolormap = 0;
        }
    }
    else {
        player.fixedcolormap = 0;
    }
}

