// c2vala-ptrs: settings_obj[DEREF|ARROW]=>T?
void LoadGameSettings (net_gamesettings_t? settings) {
    uint32 i = 0;
    deathmatch = settings.deathmatch;
    startepisode = settings.episode;
    startmap = settings.map;
    startskill = (skill_t) settings.skill;
    startloadgame = settings.loadgame;
    lowres_turn = (uint32) settings.lowres_turn;
    nomonsters = (uint32) settings.nomonsters;
    fastparm = (uint32) settings.fast_monsters;
    respawnparm = (uint32) settings.respawn_monsters;
    timelimit = settings.timelimit;
    consoleplayer = settings.consoleplayer;
    if (lowres_turn != 0) 
    {
        print (@"NOTE: Turning resolution is reduced; this is probably because there is a client recording a Vanilla demo.\n");
    }
    for (i = (uint32) 0; i < ((uint32) 4); ++i) 
    {
        playeringame[(int) (i)] = (uint32) (((i < ((uint32) settings.num_players))) ? 1 : 0);
    }
