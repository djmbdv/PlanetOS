    int i = 0;
    st_armson = (uint32) ((((st_statusbaron != 0) && (!(deathmatch != 0)))) ? 1 : 0);
    st_fragson = (uint32) ((((deathmatch != 0) && (st_statusbaron != 0))) ? 1 : 0);
