// c2vala-ptrs: name_obj[PLAIN]=>T? variable_pp[DEREF|WR]=>C2VBox<T[]>
void WI_loadCallback (uint8[] name, patch_t?[] variable) {
    variable[0] = new patch_t.at (W_CacheLumpName (name, (int) __anon_enum_1.PU_STATIC), 0);
}

void WI_loadData () {
    if (gamemode == GameMode_t.commercial) 
    {
        NUMCMAPS = 32;
        lnames = new patch_t?[NUMCMAPS];
    }
    else 
    {
        lnames = new patch_t?[9];
    }
    WI_loadUnloadData (WI_loadCallback);
    star = new patch_t.at (W_CacheLumpName (c_str_to_bytes ("STFST01"), (int) __anon_enum_1.PU_STATIC), 0);
    bstar = new patch_t.at (W_CacheLumpName (c_str_to_bytes ("STFDEAD0"), (int) __anon_enum_1.PU_STATIC), 0);
}

// c2vala-ptrs: name_obj[PLAIN]=>T? variable_pp[DEREF|WR]=>C2VBox<T[]>
void WI_unloadCallback (uint8[] name, patch_t?[] variable) {
    W_ReleaseLumpName (name);
    variable[0] = null;
}

void WI_unloadData () {
    WI_loadUnloadData (WI_unloadCallback);
}

void WI_Drawer () {
    switch (state) {
        case stateenum_t.StatCount:
            if (deathmatch != 0) {
                WI_drawDeathmatchStats ();
            }
            else 
            if (netgame != 0) {
                WI_drawNetgameStats ();
            }
            else {
                WI_drawStats ();
            }
            break;
        case stateenum_t.ShowNextLoc:
            WI_drawShowNextLoc ();
            break;
        case stateenum_t.NoState:
            WI_drawNoState ();
            break;
    }
}

// c2vala-ptrs: wbstartstruct_obj[PLAIN]=>T?
void WI_initVariables (wbstartstruct_t? wbstartstruct) {
    wbs = wbstartstruct;
    acceleratestage = 0;
    bcnt = 0;
    cnt = bcnt;
    firstrefresh = 1;
    me = wbs.pnum;
    plrs = _c2v_box_wbplayerstruct_t_obj (wbs.plyr);
    if (!(wbs.maxkills != 0)) {
        wbs.maxkills = 1;
    }
    if (!(wbs.maxitems != 0)) {
        wbs.maxitems = 1;
    }
    if (!(wbs.maxsecret != 0)) {
        wbs.maxsecret = 1;
    }
    if (gamemode != GameMode_t.retail) {
        if (wbs.epsd > 2) {
            wbs.epsd -= 3;
        }
    }
}

// c2vala-ptrs: wbstartstruct_obj[PLAIN]=>T?
void WI_Start (wbstartstruct_t? wbstartstruct) {
    WI_initVariables (wbstartstruct);
    WI_loadData ();
    if (deathmatch != 0) {
        WI_initDeathmatchStats ();
    }
    else 
    if (netgame != 0) {
        WI_initNetgameStats ();
    }
    else {
        WI_initStats ();
    }
}

