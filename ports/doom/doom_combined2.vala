void M_DoSave (int slot) {
    G_SaveGame (slot, savegamestrings[(int) (slot)]);
    M_ClearMenus ();
    if (quickSaveSlot == -2) {
        quickSaveSlot = slot;
    }
}

void M_SaveSelect (int choice) {
    saveStringEnter = 1;
    saveSlot = choice;
    M_StringCopy (saveOldString, savegamestrings[(int) (choice)], (size_t) 24);
    if (!(c_strcmp ((string) savegamestrings[(int) (choice)], "empty slot") != 0)) {
        savegamestrings[(int) (choice)][(int) (0)] = (uint8) 0;
    }
    saveCharIndex = c_strlen ((string) savegamestrings[(int) (choice)]);
}

void M_SaveGame (int choice) {
    if (!(usergame != 0)) 
    {
        M_StartMessage (c_str_to_bytes ("you can't save if you aren't playing!\n\npress a key."), new uint8[0], (uint32) 0);
        return;
    }
    if (gamestate != gamestate_t.GS_LEVEL) {
        return;
    }
    M_SetupNextMenu (SaveDef);
    M_ReadSaveStrings ();
}

public uint8[] tempstring;

void M_QuickSaveResponse (int key) {
    if (key == key_menu_confirm) 
    {
        M_DoSave (quickSaveSlot);
        0;
    }
}

void M_QuickSave () {
    if (!(usergame != 0)) 
    {
        0;
        return;
    }
    if (gamestate != gamestate_t.GS_LEVEL) {
        return;
    }
    if (quickSaveSlot < 0) 
    {
        M_StartControlPanel ();
        M_ReadSaveStrings ();
        M_SetupNextMenu (SaveDef);
        quickSaveSlot = -2;
        return;
    }
    c_snprintf_buf (tempstring, (size_t) (80), ("quicksave over your game named\n\n'%s'?\n\npress y or n.").printf ((string) savegamestrings[(int) (quickSaveSlot)]));
    messageTag = 2;
    M_StartMessage (tempstring, new uint8[0], (uint32) 1);
}

void M_QuickLoadResponse (int key) {
    if (key == key_menu_confirm) 
    {
        M_LoadSelect (quickSaveSlot);
        0;
    }
}

void M_QuickLoad () {
    if (netgame != 0) 
    {
        M_StartMessage (c_str_to_bytes ("you can't quickload during a netgame!\n\npress a key."), new uint8[0], (uint32) 0);
        return;
    }
    if (quickSaveSlot < 0) 
    {
        M_StartMessage (c_str_to_bytes ("you haven't picked a quicksave slot yet!\n\npress a key."), new uint8[0], (uint32) 0);
        return;
    }
    c_snprintf_buf (tempstring, (size_t) (80), ("do you want to quickload the game named\n\n'%s'?\n\npress y or n.").printf ((string) savegamestrings[(int) (quickSaveSlot)]));
    messageTag = 3;
    M_StartMessage (tempstring, new uint8[0], (uint32) 1);
}

