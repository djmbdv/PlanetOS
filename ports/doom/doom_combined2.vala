void SHA1_Update (sha1_context_s? hd, uint8[] inbuf, size_t inlen) {
    int _off_inbuf = 0;
    if (hd.count == 64) 
    {
        Transform (hd, hd.buf);
        hd.count = 0;
        hd.nblocks++;
    }
    if (!(inbuf != null)) {
        return;
    }
    if (hd.count != 0) 
    {
        for (; (inlen != 0) && (hd.count < 64); inlen--) {
            hd.buf[(int) (hd.count++)] = inbuf[_off_inbuf++];
        }
        SHA1_Update (hd, new uint8[0], (size_t) 0);
        if (!(inlen != 0)) {
            return;
        }
    }
    while (inlen >= ((size_t) 64)) 
    {
        Transform (hd, _c2v_slice_uint8 (inbuf, _off_inbuf));
        hd.count = 0;
        hd.nblocks++;
        inlen -= (size_t) 64;
        _off_inbuf += (int) (64);
    }
    for (; (inlen != 0) && (hd.count < 64); inlen--) {
        hd.buf[(int) (hd.count++)] = inbuf[_off_inbuf++];
