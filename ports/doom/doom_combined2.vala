// c2vala-ptrs: savegame_file_obj[PLAIN]=>T? temp_savegame_file_obj[PLAIN]=>T? recovery_savegame_file_obj[NULL]=>T?
void G_DoSaveGame () {
    uint8[] savegame_file = new uint8[0];
    uint8[] temp_savegame_file = new uint8[0];
    uint8[] recovery_savegame_file = new uint8[0];
    recovery_savegame_file = new uint8[0];
    temp_savegame_file = P_TempSaveGameFile ();
    savegame_file = P_SaveGameFile (savegameslot);
    save_stream = FileStream.open ((string) temp_savegame_file, "wb");
    if (save_stream == null) 
    {
        recovery_savegame_file = c_str_to_bytes (M_TempFile (c_str_to_bytes ("recovery.dsg")));
        save_stream = FileStream.open ((string) recovery_savegame_file, "wb");
        if (save_stream == null) 
        {
            I_Error (c_str_to_bytes ("Failed to open either '%s' or '%s' to write savegame."), temp_savegame_file, recovery_savegame_file);
        }
    }
    savegame_error = (uint32) 0;
    P_WriteSaveGameHeader (savedescription);
    P_ArchivePlayers ();
    P_ArchiveWorld ();
    P_ArchiveThinkers ();
    P_ArchiveSpecials ();
    P_WriteSaveGameEOF ();
    if ((vanilla_savegame_limit != 0) && (save_stream.tell () > ((int64) 0x2c000))) 
    {
        I_Error (c_str_to_bytes ("Savegame buffer overrun"));
    }
    save_stream = null;
    if (recovery_savegame_file != null) 
    {
        I_Error (c_str_to_bytes ("Failed to open savegame file '%s' for writing.\nBut your game has been saved to '%s' for recovery."), temp_savegame_file, recovery_savegame_file);
    }
    c_remove ((string) savegame_file);
    c_rename ((string) temp_savegame_file, (string) savegame_file);
    gameaction = gameaction_t.ga_nothing;
    M_StringCopy (savedescription, c_str_to_bytes (""), ((int) (32) * (int) (1)));
    players[(int) (consoleplayer)].message = "game saved.";
    R_FillBackScreen ();
}

