            {
                plyr.armorpoints = 200;
                plyr.armortype = 2;
                for (i = 0; i < ((int) weapontype_t.NUMWEAPONS); i++) {
                    plyr.weaponowned[(int) (i)] = (uint32) 1;
                }
                for (i = 0; i < ((int) ammotype_t.NUMAMMO); i++) {
                    plyr.ammo[(int) (i)] = plyr.maxammo[(int) (i)];
                }
                plyr.message = "Ammo (no keys) Added";
            }
            else 
            if (cht_CheckCheat (cheat_ammo, (char) ev.data2) != 0) 
            {
                plyr.armorpoints = 200;
                plyr.armortype = 2;
                for (i = 0; i < ((int) weapontype_t.NUMWEAPONS); i++) {
                    plyr.weaponowned[(int) (i)] = (uint32) 1;
                }
                for (i = 0; i < ((int) ammotype_t.NUMAMMO); i++) {
                    plyr.ammo[(int) (i)] = plyr.maxammo[(int) (i)];
                }
                for (i = 0; i < ((int) card_t.NUMCARDS); i++) {
                    plyr.cards[(int) (i)] = (uint32) 1;
                }
                plyr.message = "Very Happy Ammo Added";
            }
            else 
            if (cht_CheckCheat (cheat_mus, (char) ev.data2) != 0) 
            {
                uint8[] buf = new uint8[3];
                int musnum = 0;
                plyr.message = "Music Change";
                cht_GetParam (cheat_mus, buf);
                if ((gamemode == GameMode_t.commercial) || (gameversion < GameVersion_t.exe_ultimate)) 
                {
                    musnum = (int) ((((int) (((int) (((int) (((int) musicenum_t.mus_runnin) + ((buf[(int) (0)] - '0') * 10))) + buf[(int) (1)])) - '0')) - 1));
                    if (((((buf[(int) (0)] - '0') * 10) + ((int) buf[(int) (1)])) - ((int) '0')) > 35) {
                        plyr.message = "IMPOSSIBLE SELECTION";
                    }
                    else {
                        0;
                    }
                }
                else 
                {
                    musnum = (int) ((((int) (((int) musicenum_t.mus_e1m1) + ((buf[(int) (0)] - '1') * 9))) + (buf[(int) (1)] - '1')));
                    if (((((buf[(int) (0)] - '1') * 9) + ((int) buf[(int) (1)])) - ((int) '1')) > 31) {
                        plyr.message = "IMPOSSIBLE SELECTION";
                    }
                    else {
                        0;
                    }
                }
            }
            else 
            if (((((gamemission == GameMission_t.pack_chex) ? GameMission_t.doom : ((gamemission == GameMission_t.pack_hacx) ? GameMission_t.doom2 : gamemission)) == ((int) GameMission_t.doom)) && (cht_CheckCheat (cheat_noclip, (char) ev.data2) != 0)) || ((((gamemission == GameMission_t.pack_chex) ? GameMission_t.doom : ((gamemission == GameMission_t.pack_hacx) ? GameMission_t.doom2 : gamemission)) != ((int) GameMission_t.doom)) && (cht_CheckCheat (cheat_commercial_noclip, (char) ev.data2) != 0))) 
            {
                plyr.cheats ^= (int) cheat_t.CF_NOCLIP;
                if ((plyr.cheats & ((int) cheat_t.CF_NOCLIP)) != 0) {
                    plyr.message = "No Clipping Mode ON";
                }
                else {
                    plyr.message = "No Clipping Mode OFF";
                }
            }
            for (i = 0; i < 6; i++) 
            {
                if (cht_CheckCheat (_c2v_box_cheatseq_t_obj (_c2v_slice_cheatseq_t (cheat_powerup, (int) (i))), (char) ev.data2) != 0) 
                {
                    if (!(plyr.powers[(int) (i)] != 0)) {
                        P_GivePower (plyr, i);
                    }
                    else 
                    if (i != ((int) powertype_t.pw_strength)) {
                        plyr.powers[(int) (i)] = 1;
                    }
                    else {
                        plyr.powers[(int) (i)] = 0;
                    }
                    plyr.message = "Power-up Toggled";
                }
            }
            if (cht_CheckCheat (_c2v_box_cheatseq_t_obj (_c2v_slice_cheatseq_t (cheat_powerup, (int) (6))), (char) ev.data2) != 0) 
            {
                plyr.message = "inVuln, Str, Inviso, Rad, Allmap, or Lite-amp";
            }
            else 
            if (cht_CheckCheat (cheat_choppers, (char) ev.data2) != 0) 
            {
                plyr.weaponowned[(int) (weapontype_t.wp_chainsaw)] = (uint32) 1;
                plyr.powers[(int) (powertype_t.pw_invulnerability)] = 1;
                plyr.message = "... doesn't suck - GM";
            }
            else 
            if (cht_CheckCheat (cheat_mypos, (char) ev.data2) != 0) 
            {
                uint8[] buf = new uint8[52];
                M_snprintf (buf, ((int) (52) * (int) (1)), c_str_to_bytes ("ang=0x%x;x,y=(0x%x,0x%x)"), players[(int) (consoleplayer)].mo.angle, players[(int) (consoleplayer)].mo.x, players[(int) (consoleplayer)].mo.y);
                plyr.message = (string) buf;
            }
        }
        if ((!(netgame != 0)) && (cht_CheckCheat (cheat_clev, (char) ev.data2) != 0)) 
        {
            uint8[] buf = new uint8[3];
            int epsd = 0;
            int map = 0;
            cht_GetParam (cheat_clev, buf);
            if (gamemode == GameMode_t.commercial) 
            {
                epsd = 1;
                map = ((((buf[(int) (0)] - '0') * 10) + ((int) buf[(int) (1)])) - ((int) '0'));
            }
            else 
            {
                epsd = (buf[(int) (0)] - '0');
                map = (buf[(int) (1)] - '0');
            }
            if (gameversion == GameVersion_t.exe_chex) 
            {
                epsd = 1;
            }
            if (epsd < 1) {
                return (uint32) 0;
            }
            if (map < 1) {
                return (uint32) 0;
            }
            if ((gamemode == GameMode_t.retail) && ((epsd > 4) || (map > 9))) {
                return (uint32) 0;
            }
            if ((gamemode == GameMode_t.registered) && ((epsd > 3) || (map > 9))) {
                return (uint32) 0;
            }
            if ((gamemode == GameMode_t.shareware) && ((epsd > 1) || (map > 9))) {
                return (uint32) 0;
            }
            if ((gamemode == GameMode_t.commercial) && ((epsd > 1) || (map > 40))) {
                return (uint32) 0;
            }
            plyr.message = "Changing Level...";
            G_DeferedInitNew (gameskill, epsd, map);
        }
    }
    return (uint32) 0;
}

int ST_calcPainOffset () {
    int health = 0;
    int lastcalc = 0;
    int oldhealth = -1;
    health = ((plyr.health > 100) ? 100 : plyr.health);
    if (health != oldhealth) 
    {
        lastcalc = (((3 + 2) + 3) * (((100 - health) * 5) / 101));
        oldhealth = health;
    }
    return lastcalc;
}

void ST_updateFaceWidget () {
    int i = 0;
    uint32 badguyangle = 0;
    uint32 diffang = 0;
    int lastattackdown = -1;
    int priority = 0;
    uint32 doevilgrin = 0;
    if (priority < 10) 
    {
        if (!(plyr.health != 0)) 
        {
            priority = 9;
            st_faceindex = ((5 * ((3 + 2) + 3)) + 1);
            st_facecount = 1;
        }
    }
    if (priority < 9) 
    {
        if (plyr.bonuscount != 0) 
        {
            doevilgrin = (uint32) 0;
            for (i = 0; i < ((int) weapontype_t.NUMWEAPONS); i++) 
            {
                if (oldweaponsowned[(int) (i)] != plyr.weaponowned[(int) (i)]) 
                {
                    doevilgrin = (uint32) 1;
                    oldweaponsowned[(int) (i)] = plyr.weaponowned[(int) (i)];
                }
            }
            if (doevilgrin != 0) 
            {
                priority = 8;
                st_facecount = (2 * 35);
                st_faceindex = (ST_calcPainOffset () + ((3 + 2) + 1));
            }
        }
    }
    if (priority < 8) 
    {
        if (((plyr.damagecount != 0) && (plyr.attacker != null)) && (plyr.attacker != plyr.mo)) 
        {
            priority = 7;
            if ((plyr.health - st_oldhealth) > 20) 
            {
                st_facecount = (1 * 35);
                st_faceindex = (ST_calcPainOffset () + (3 + 2));
            }
            else 
            {
                badguyangle = R_PointToAngle2 (plyr.mo.x, plyr.mo.y, plyr.attacker.x, plyr.attacker.y);
                if (badguyangle > plyr.mo.angle) 
                {
                    diffang = (badguyangle - plyr.mo.angle);
                    i = (int) (((diffang > ((uint32) 0x80000000))) ? 1 : 0);
                }
                else 
                {
                    diffang = (plyr.mo.angle - badguyangle);
                    i = (int) (((diffang <= ((uint32) 0x80000000))) ? 1 : 0);
                }
                st_facecount = (1 * 35);
                st_faceindex = ST_calcPainOffset ();
                if (diffang < ((uint32) 0x20000000)) 
                {
                    st_faceindex += (((3 + 2) + 1) + 1);
                }
                else 
                if (i != 0) 
                {
                    st_faceindex += 3;
                }
                else 
                {
                    st_faceindex += (3 + 1);
                }
            }
        }
    }
    if (priority < 7) 
    {
        if (plyr.damagecount != 0) 
        {
            if ((plyr.health - st_oldhealth) > 20) 
            {
                priority = 7;
                st_facecount = (1 * 35);
                st_faceindex = (ST_calcPainOffset () + (3 + 2));
            }
            else 
            {
                priority = 6;
                st_facecount = (1 * 35);
                st_faceindex = (ST_calcPainOffset () + (((3 + 2) + 1) + 1));
            }
        }
    }
    if (priority < 6) 
    {
        if (plyr.attackdown != 0) 
        {
            if (lastattackdown == -1) {
                lastattackdown = (2 * 35);
            }
            else 
            if (!(--lastattackdown != 0)) 
            {
                priority = 5;
                st_faceindex = (ST_calcPainOffset () + (((3 + 2) + 1) + 1));
                st_facecount = 1;
                lastattackdown = 1;
            }
        }
        else {
            lastattackdown = -1;
        }
    }
    if (priority < 5) 
    {
        if (((plyr.cheats & ((int) cheat_t.CF_GODMODE)) != 0) || (plyr.powers[(int) (powertype_t.pw_invulnerability)] != 0)) 
        {
            priority = 4;
            st_faceindex = (5 * ((3 + 2) + 3));
            st_facecount = 1;
        }
    }
    if (!(st_facecount != 0)) 
    {
        st_faceindex = (ST_calcPainOffset () + (st_randomnumber % 3));
        st_facecount = (35 / 2);
        priority = 0;
    }
    st_facecount--;
}

void ST_updateWidgets () {
    int[] largeammo = new int[1];
    largeammo[0] = 1994;
    int i = 0;
    if (weaponinfo[(int) (plyr.readyweapon)].ammo == ammotype_t.am_noammo) {
        w_ready.num = largeammo;
    }
    else {
        w_ready.num = _c2v_slice_int (plyr.ammo, (int) (weaponinfo[(int) (plyr.readyweapon)].ammo));
    }
    w_ready.data = (int) plyr.readyweapon;
    for (i = 0; i < 3; i++) 
    {
        keyboxes[(int) (i)] = ((plyr.cards[(int) (i)] != 0) ? i : -1);
        if (plyr.cards[(int) ((i + 3))] != 0) {
            keyboxes[(int) (i)] = (i + 3);
        }
    }
    ST_updateFaceWidget ();
    st_notdeathmatch = (uint32) (((!(deathmatch != 0))) ? 1 : 0);
    st_armson = (uint32) ((((st_statusbaron != 0) && (!(deathmatch != 0)))) ? 1 : 0);
    st_fragson = (uint32) ((((deathmatch != 0) && (st_statusbaron != 0))) ? 1 : 0);
    st_fragscount = 0;
    for (i = 0; i < 4; i++) 
    {
        if (i != consoleplayer) {
            st_fragscount += plyr.frags[(int) (i)];
        }
        else {
            st_fragscount -= plyr.frags[(int) (i)];
        }
    }
    if (!(--st_msgcounter != 0)) {
        st_chat = st_oldchat;
    }
}

void ST_Ticker () {
    st_clock++;
    st_randomnumber = M_Random ();
    ST_updateWidgets ();
    st_oldhealth = plyr.health;
}

