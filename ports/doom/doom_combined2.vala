// c2vala-ptrs: dir_obj[PLAIN]=>T?
void AddIWADDir (uint8[] dir) {
    if (num_iwad_dirs < 128) 
    {
        iwad_dirs[(int) (num_iwad_dirs)] = (string) dir;
        ++num_iwad_dirs;
    }
}

// c2vala-ptrs: path_buf[IDX|NULL]=>uint8[](ro) filename_obj[PLAIN]=>T?
uint32 DirIsFile (uint8[] path, uint8[] filename) {
    size_t path_len = 0;
    size_t filename_len = 0;
    path_len = (size_t) (c_strlen ((string) path));
    filename_len = (size_t) (c_strlen ((string) filename));
    return (uint32) (((((path_len >= (filename_len + ((size_t) 1))) && (path[(int) (((path_len - filename_len) - ((uint64) 1)))] == '/')) && (!(GLib.ascii_strcasecmp ((string) c_bytes_add (path, (int) ((path_len - filename_len))), (string) filename) != 0)))) ? 1 : 0);
}

// c2vala-ptrs: dir_obj[PLAIN]=>T? iwadname_obj[PLAIN]=>T? filename_obj[PLAIN]=>T?
uint8[] CheckDirectoryHasIWAD (uint8[] dir, uint8[] iwadname) {
    uint8[] filename = new uint8[0];
    if ((DirIsFile (dir, iwadname) != 0) && (M_FileExists (dir) != 0)) 
    {
        return dir;
    }
    if (!(c_strcmp ((string) dir, ".") != 0)) 
    {
        filename = iwadname;
    }
    else 
    {
        filename = M_StringJoin (dir, "/", iwadname, 0);
    }
    print (@"Trying IWAD file:$((string) filename)\n");
    if (M_FileExists (filename) != 0) 
    {
        return filename;
    }
    // free (filename): the GC owns the array
    return new uint8[0];
}

// c2vala-ptrs: dir_obj[PLAIN]=>T? mission_obj[DEREF|WR]=>T? filename_obj[NULL]=>T?
uint8[] SearchDirectoryForIWAD (uint8[] dir, int mask, GameMission_t[] mission) {
    uint8[] filename = new uint8[0];
    size_t i = 0;
    for (i = (size_t) 0; ((uint64) i) < ((iwads.length * (int) (24)) / 24); ++i) 
    {
        if (((1 << ((int) iwads[(int) (i)].mission)) & mask) == 0) 
        {
            continue;
        }
        filename = CheckDirectoryHasIWAD (dir, c_str_to_bytes (iwads[(int) (i)].name));
        if (filename != null) 
        {
            mission[0] = iwads[(int) (i)].mission;
            return filename;
        }
    }
    return new uint8[0];
}

// c2vala-ptrs: name_obj[PLAIN]=>T? p_buf[ARITH|NULL]=>uint8[](ro)
GameMission_t IdentifyIWADByName (uint8[] name, int mask) {
    int _off_name = 0;
    size_t i = 0;
    GameMission_t mission = (GameMission_t) 0;
    uint8[] p = new uint8[0];
    int _off_p = 0;
    p = c_str_to_bytes (c_strrchr ((string) name, (int) ('/')));
    _off_p = 0;
    if (p != null) 
    {
        name = p;
        _off_name = _off_p + (int) (1);
    }
    mission = GameMission_t.none;
    for (i = (size_t) 0; ((uint64) i) < ((iwads.length * (int) (24)) / 24); ++i) 
    {
        if (((1 << ((int) iwads[(int) (i)].mission)) & mask) == 0) {
            continue;
        }
        if (!(GLib.ascii_strcasecmp ((string) name, iwads[(int) (i)].name) != 0)) 
        {
            mission = iwads[(int) (i)].mission;
            break;
        }
    }
    return mission;
}

void BuildIWADDirList () {
    AddIWADDir (c_str_to_bytes ("."));
    iwad_dirs_built = (uint32) 1;
}

// c2vala-ptrs: name_obj[PLAIN]=>T? path_obj[PLAIN]=>T?
uint8[] D_FindWADByName (uint8[] name) {
    uint8[] path = new uint8[0];
    int i = 0;
    if (M_FileExists (name) != 0) 
    {
        return name;
    }
    BuildIWADDirList ();
    for (i = 0; i < num_iwad_dirs; ++i) 
    {
        if ((DirIsFile (c_str_to_bytes (iwad_dirs[(int) (i)]), name) != 0) && (M_FileExists (c_str_to_bytes (iwad_dirs[(int) (i)])) != 0)) 
        {
            return c_str_to_bytes ((iwad_dirs[(int) (i)]));
        }
        path = M_StringJoin (c_str_to_bytes (iwad_dirs[(int) (i)]), "/", name, 0);
        if (M_FileExists (path) != 0) 
        {
            return path;
        }
        // free (path): the GC owns the array
    }
    return new uint8[0];
}

// c2vala-ptrs: filename_obj[PLAIN]=>T? result_obj[NULL]=>T?
uint8[] D_TryFindWADByName (uint8[] filename) {
    uint8[] result = new uint8[0];
    result = D_FindWADByName (filename);
    if (result != null) 
    {
        return result;
    }
    else 
    {
        return filename;
    }
}

// c2vala-ptrs: mission_obj[DEREF|WR]=>T? result_obj[NULL]=>T? iwadfile_obj[PLAIN]=>T?
uint8[] D_FindIWAD (int mask, GameMission_t[] mission) {
    uint8[] result = new uint8[0];
    uint8[] iwadfile = new uint8[0];
    int iwadparm = 0;
    int i = 0;
    iwadparm = M_CheckParmWithArgs (c_str_to_bytes ("-iwad"), 1);
    if (iwadparm != 0) 
    {
        iwadfile = c_str_to_bytes (myargv[(int) ((iwadparm + 1))]);
        result = D_FindWADByName (iwadfile);
        if (result == null) 
        {
            I_Error (c_str_to_bytes ("IWAD file '%s' not found!"), iwadfile);
        }
        mission[0] = IdentifyIWADByName (result, mask);
    }
    else 
    {
        print (@"-iwad not specified, trying a few iwad names\n");
        result = new uint8[0];
        BuildIWADDirList ();
        for (i = 0; (result == null) && (i < num_iwad_dirs); ++i) 
        {
            result = SearchDirectoryForIWAD (c_str_to_bytes (iwad_dirs[(int) (i)]), mask, mission);
        }
    }
    return result;
}

// c2vala-ptrs: result_pp[IDX|WR]=>C2VBox<T[]> filename_obj[NULL]=>T?
iwad_t?[] D_FindAllIWADs (int mask) {
    iwad_t?[] result = new iwad_t?[0];
    int result_len = 0;
    uint8[] filename = new uint8[0];
    int i = 0;
    result = new iwad_t?[(((iwads.length * (int) (24)) / 24) + ((uint64) 1))];
    result_len = 0;
    for (i = 0; ((uint64) i) < ((iwads.length * (int) (24)) / 24); ++i) 
    {
        if (((1 << ((int) iwads[(int) (i)].mission)) & mask) == 0) 
        {
            continue;
        }
        filename = D_FindWADByName (c_str_to_bytes (iwads[(int) (i)].name));
        if (filename != null) 
        {
            result[(int) (result_len)] = _c2v_box_iwad_t_obj (_c2v_slice_iwad_t (iwads, (int) (i)));
            ++result_len;
        }
    }
    result[(int) (result_len)] = null;
    return result;
}

string D_SaveGameIWADName (GameMission_t gamemission) {
    size_t i = 0;
    for (i = (size_t) 0; ((uint64) i) < ((iwads.length * (int) (24)) / 24); ++i) 
    {
        if (gamemission == iwads[(int) (i)].mission) 
        {
            return iwads[(int) (i)].name;
        }
    }
    return "unknown.wad";
}

string D_SuggestIWADName (GameMission_t mission, GameMode_t mode) {
    int i = 0;
    for (i = 0; ((uint64) i) < ((iwads.length * (int) (24)) / 24); ++i) 
    {
        if ((iwads[(int) (i)].mission == mission) && (iwads[(int) (i)].mode == mode)) 
        {
