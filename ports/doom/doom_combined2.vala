public int sightzstart;

public divline_t strace;

public int t2x;

public int t2y;

public int[] sightcounts;

// c2vala-ptrs: node_obj[DEREF|ARROW]=>T?
int P_DivlineSide (int x, int y, divline_t? node) {
    int dx = 0;
    int dy = 0;
    int left = 0;
    int right = 0;
    if (!(node.dx != 0)) 
    {
        if (x == node.x) {
            return 2;
        }
        if (x <= node.x) {
            return (int) (((node.dy > 0)) ? 1 : 0);
        }
        return (int) (((node.dy < 0)) ? 1 : 0);
    }
    if (!(node.dy != 0)) 
    {
        if (x == node.y) {
            return 2;
        }
        if (y <= node.y) {
            return (int) (((node.dx < 0)) ? 1 : 0);
        }
        return (int) (((node.dx > 0)) ? 1 : 0);
    }
    dx = (x - node.x);
    dy = (y - node.y);
    left = ((node.dy >> 16) * (dx >> 16));
    right = ((dy >> 16) * (node.dx >> 16));
    if (right < left) {
        return 0;
    }
    if (left == right) {
        return 2;
    }
    return 1;
}

// c2vala-ptrs: v2_obj[DEREF|ARROW]=>T? v1_obj[DEREF|ARROW]=>T?
int P_InterceptVector2 (divline_t? v2, divline_t? v1) {
    int frac = 0;
    int num = 0;
    int den = 0;
    den = (FixedMul ((v1.dy >> 8), v2.dx) - FixedMul ((v1.dx >> 8), v2.dy));
    if (den == 0) {
        return 0;
    }
    num = (FixedMul (((v1.x - v2.x) >> 8), v1.dy) + FixedMul (((v2.y - v1.y) >> 8), v1.dx));
    frac = FixedDiv (num, den);
    return frac;
}

// c2vala-ptrs: seg_arr[ARITH|DEREF|ARROW]=>T[] line_obj[DEREF|WR|ARROW]=>T? sub_obj[DEREF|ARROW]=>T? front_obj[DEREF|ARROW]=>T? back_obj[DEREF|ARROW]=>T? v1_obj[DEREF|ARROW]=>T? v2_obj[DEREF|ARROW]=>T?
uint32 P_CrossSubsector (int num) {
    seg_t[] seg = new seg_t[0];
    int _off_seg = 0;
    line_s? line = null;
    int s1 = 0;
    int s2 = 0;
    int count = 0;
    subsector_s? sub = null;
    sector_t? front = null;
    sector_t? back = null;
    int opentop = 0;
    int openbottom = 0;
    divline_t divl = new divline_t ();
    vertex_t? v1 = null;
    vertex_t? v2 = null;
    int frac = 0;
    int slope = 0;
    if (num >= numsubsectors) {
        I_Error (c_str_to_bytes ("P_CrossSubsector: ss %i with numss = %i"), num, numsubsectors);
    }
    sub = _c2v_box_subsector_s_obj (_c2v_slice_subsector_s (subsectors, (int) (num)));
    count = (int) sub.numlines;
    seg = _c2v_slice_seg_t (segs, (int) (sub.firstline));
    _off_seg = 0;
    for (; count != 0; ) {
        {
            line = seg[_off_seg].linedef;
            if (line.validcount == validcount) {
                {
                    _off_seg++;
                    count--;
                    continue;
                }
            }
            line.validcount = validcount;
            v1 = line.v1;
            v2 = line.v2;
            s1 = P_DivlineSide (v1.x, v1.y, strace);
            s2 = P_DivlineSide (v2.x, v2.y, strace);
            if (s1 == s2) {
                {
                    _off_seg++;
                    count--;
                    continue;
                }
            }
            divl.x = v1.x;
            divl.y = v1.y;
            divl.dx = (v2.x - v1.x);
            divl.dy = (v2.y - v1.y);
            s1 = P_DivlineSide (strace.x, strace.y, divl);
            s2 = P_DivlineSide (t2x, t2y, divl);
            if (s1 == s2) {
                {
                    _off_seg++;
                    count--;
                    continue;
                }
            }
            if (line.backsector == null) 
            {
                return (uint32) 0;
            }
            if (!((((int) line.flags) & 4) != 0)) {
                return (uint32) 0;
            }
            front = seg[_off_seg].frontsector;
            back = seg[_off_seg].backsector;
            if ((front.floorheight == back.floorheight) && (front.ceilingheight == back.ceilingheight)) {
                {
                    _off_seg++;
                    count--;
                    continue;
                }
            }
            if (front.ceilingheight < back.ceilingheight) {
                opentop = front.ceilingheight;
            }
            else {
                opentop = back.ceilingheight;
            }
            if (front.floorheight > back.floorheight) {
                openbottom = front.floorheight;
            }
            else {
                openbottom = back.floorheight;
            }
            if (openbottom >= opentop) {
                return (uint32) 0;
            }
            frac = P_InterceptVector2 (strace, divl);
            if (front.floorheight != back.floorheight) 
            {
                slope = FixedDiv ((openbottom - sightzstart), frac);
                if (slope > bottomslope) {
                    bottomslope = slope;
                }
            }
            if (front.ceilingheight != back.ceilingheight) 
            {
                slope = FixedDiv ((opentop - sightzstart), frac);
                if (slope < topslope) {
                    topslope = slope;
                }
            }
            if (topslope <= bottomslope) {
                return (uint32) 0;
            }
        }
        _off_seg++;
        count--;
    }
    return (uint32) 1;
}

// c2vala-ptrs: bsp_ptr[DEREF|CAST|ARROW->divline_t]=>divline_t.at
uint32 P_CrossBSPNode (int bspnum) {
    node_t? bsp = null;
    int side = 0;
    if ((bspnum & 0x8000) != 0) 
    {
        if (bspnum == -1) {
            return P_CrossSubsector (0);
        }
        else {
            return P_CrossSubsector ((bspnum & ~0x8000));
        }
    }
    bsp = _c2v_box_node_t_obj (_c2v_slice_node_t (nodes, (int) (bspnum)));
    side = P_DivlineSide (strace.x, strace.y, ((divline_t?) bsp));
    if (side == 2) {
        side = 0;
    }
    if (!(P_CrossBSPNode ((int) (bsp.children[(int) (side)])) != 0)) {
        return (uint32) 0;
    }
    if (side == P_DivlineSide (t2x, t2y, ((divline_t?) bsp))) 
    {
        return (uint32) 1;
    }
    return P_CrossBSPNode ((int) (bsp.children[(int) ((side ^ 1))]));
}

// c2vala-ptrs: t1_obj[DEREF|ARROW]=>T? t2_obj[DEREF|ARROW]=>T?
uint32 P_CheckSight (mobj_s[] t1, mobj_s? t2) {
    int s1 = 0;
    int s2 = 0;
    int pnum = 0;
    int bytenum = 0;
    int bitnum = 0;
    for (s1 = 0; s1 < numsectors; s1++) {
        if (sectors[(int) (s1)] == t1[0].subsector.sector) {
            break;
        }
    }
    for (s2 = 0; s2 < numsectors; s2++) {
        if (sectors[(int) (s2)] == t2.subsector.sector) {
            break;
        }
    }
    pnum = ((s1 * numsectors) + s2);
    bytenum = (pnum >> 3);
    bitnum = (1 << (pnum & 7));
    if ((((int) rejectmatrix[(int) (bytenum)]) & bitnum) != 0) 
    {
        sightcounts[(int) (0)]++;
        return (uint32) 0;
    }
    sightcounts[(int) (1)]++;
    validcount++;
    sightzstart = ((t1[0].z + t1[0].height) - (t1[0].height >> 2));
    topslope = ((t2.z + t2.height) - sightzstart);
    bottomslope = (t2.z - sightzstart);
    strace.x = t1[0].x;
    strace.y = t1[0].y;
    t2x = t2.x;
    t2y = t2.y;
    strace.dx = (t2.x - t1[0].x);
    strace.dy = (t2.y - t1[0].y);
    return P_CrossBSPNode ((numnodes - 1));
}

