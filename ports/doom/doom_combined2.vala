// c2vala-ptrs: thing_obj[DEREF|ARROW]=>T? line_obj[DEREF|WR|ARROW]=>T?
void P_CrossSpecialLine (int linenum, int side, mobj_s[] thing) {
    line_s[] line = new line_s[0];
    int ok = 0;
    line = _c2v_slice_line_s (lines, (int) (linenum));
    if (!(thing[0].player != null)) 
    {
        switch (thing[0].type) {
            case mobjtype_t.MT_ROCKET:
            case mobjtype_t.MT_PLASMA:
            case mobjtype_t.MT_BFG:
            case mobjtype_t.MT_TROOPSHOT:
            case mobjtype_t.MT_HEADSHOT:
            case mobjtype_t.MT_BRUISERSHOT:
                return;
                break;
            default:
                break;
        }
        ok = 0;
        switch (line[0].special) {
            case 39:
            case 97:
            case 125:
            case 126:
            case 4:
            case 10:
            case 88:
                ok = 1;
                break;
        }
        if (!(ok != 0)) {
            return;
        }
    }
    switch (line[0].special) {
        case 2:
            EV_DoDoor (line, vldoor_e.vld_open);
            line[0].special = (int16) 0;
            break;
        case 3:
            EV_DoDoor (line, vldoor_e.vld_close);
            line[0].special = (int16) 0;
            break;
        case 4:
            EV_DoDoor (line, vldoor_e.vld_normal);
            line[0].special = (int16) 0;
            break;
        case 5:
