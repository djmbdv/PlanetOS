// c2vala-ptrs: settings_obj[DEREF|WR|ARROW]=>T?
void SaveGameSettings (net_gamesettings_t? settings) {
    settings.deathmatch = deathmatch;
    settings.episode = startepisode;
    settings.map = startmap;
    settings.skill = (int) startskill;
    settings.loadgame = startloadgame;
    settings.gameversion = (int) gameversion;
    settings.nomonsters = (int) nomonsters;
    settings.fast_monsters = (int) fastparm;
    settings.respawn_monsters = (int) respawnparm;
    settings.timelimit = timelimit;
    settings.lowres_turn = (int) ((((M_CheckParm (c_str_to_bytes ("-record")) > 0) && (M_CheckParm (c_str_to_bytes ("-longtics")) == 0))) ? 1 : 0);
}

// c2vala-ptrs: connect_data_obj[DEREF|WR|ARROW]=>T?
void InitConnectData (net_connect_data_t? connect_data) {
    connect_data.max_players = 4;
    connect_data.drone = 0;
    if (M_CheckParm (c_str_to_bytes ("-left")) > 0) 
    {
        viewangleoffset = 0x40000000;
        connect_data.drone = 1;
    }
    if (M_CheckParm (c_str_to_bytes ("-right")) > 0) 
    {
        viewangleoffset = 0xc0000000;
        connect_data.drone = 1;
    }
    connect_data.gamemode = (int) gamemode;
    connect_data.gamemission = (int) gamemission;
    connect_data.lowres_turn = (int) ((((M_CheckParm (c_str_to_bytes ("-record")) > 0) && (M_CheckParm (c_str_to_bytes ("-longtics")) == 0))) ? 1 : 0);
    W_Checksum (connect_data.wad_sha1sum);
    connect_data.is_freedoom = (int) (((W_CheckNumForName (c_str_to_bytes ("FREEDOOM")) >= 0)) ? 1 : 0);
}

void D_ConnectNetGame () {
    net_connect_data_t connect_data = new net_connect_data_t ();
    InitConnectData (connect_data);
    netgame = D_InitNetGame (connect_data);
    if (M_CheckParm (c_str_to_bytes ("-solo-net")) > 0) 
    {
        netgame = (uint32) 1;
    }
}

void D_CheckNetGame () {
    net_gamesettings_t settings = new net_gamesettings_t ();
    if (netgame != 0) 
    {
