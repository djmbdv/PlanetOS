void G_DoCompleted () {
    int i = 0;
    gameaction = gameaction_t.ga_nothing;
    for (i = 0; i < 4; i++) {
        if (playeringame[(int) (i)] != 0) {
            G_PlayerFinishLevel (i);
        }
    }
    if (automapactive != 0) {
        AM_Stop ();
    }
    if (gamemode != GameMode_t.commercial) 
    {
        if (gameversion == GameVersion_t.exe_chex) 
        {
            if (gamemap == 5) 
            {
                gameaction = gameaction_t.ga_victory;
                return;
            }
        }
        else 
        {
            switch (gamemap) {
                case 8:
                    gameaction = gameaction_t.ga_victory;
                    return;
                case 9:
                    for (i = 0; i < 4; i++) {
                        players[(int) (i)].didsecret = (uint32) 1;
                    }
                    break;
            }
        }
    }
    if ((gamemap == 8) && (gamemode != GameMode_t.commercial)) 
    {
        gameaction = gameaction_t.ga_victory;
        return;
    }
    if ((gamemap == 9) && (gamemode != GameMode_t.commercial)) 
    {
        for (i = 0; i < 4; i++) {
            players[(int) (i)].didsecret = (uint32) 1;
        }
    }
    wminfo.didsecret = players[(int) (consoleplayer)].didsecret;
    wminfo.epsd = (gameepisode - 1);
    wminfo.last = (gamemap - 1);
    if (gamemode == GameMode_t.commercial) 
    {
        if (secretexit != 0) {
            switch (gamemap) {
                case 15:
                    wminfo.next = 30;
                    break;
                case 31:
                    wminfo.next = 31;
                    break;
            }
        }
        else {
            switch (gamemap) {
                case 31:
                case 32:
                    wminfo.next = 15;
                    break;
                default:
                    wminfo.next = gamemap;
                    break;
            }
        }
    }
    else 
    {
        if (secretexit != 0) {
            wminfo.next = 8;
        }
        else 
        if (gamemap == 9) 
        {
            switch (gameepisode) {
                case 1:
                    wminfo.next = 3;
                    break;
                case 2:
                    wminfo.next = 5;
                    break;
                case 3:
                    wminfo.next = 6;
                    break;
                case 4:
                    wminfo.next = 2;
                    break;
            }
        }
        else {
            wminfo.next = gamemap;
        }
    }
    wminfo.maxkills = totalkills;
    wminfo.maxitems = totalitems;
    wminfo.maxsecret = totalsecret;
    wminfo.maxfrags = 0;
    if (gamemode == GameMode_t.commercial) {
        wminfo.partime = (35 * cpars[(int) ((gamemap - 1))]);
    }
    else 
    if (gameepisode < 4) {
        wminfo.partime = (35 * pars[(int) (gameepisode)][(int) (gamemap)]);
    }
    else {
        wminfo.partime = (35 * cpars[(int) (gamemap)]);
    }
    wminfo.pnum = consoleplayer;
    for (i = 0; i < 4; i++) 
    {
        wminfo.plyr[(int) (i)].@in = playeringame[(int) (i)];
        wminfo.plyr[(int) (i)].skills = players[(int) (i)].killcount;
        wminfo.plyr[(int) (i)].sitems = players[(int) (i)].itemcount;
        wminfo.plyr[(int) (i)].ssecret = players[(int) (i)].secretcount;
        wminfo.plyr[(int) (i)].stime = leveltime;
        c_memcpy_i32 (wminfo.plyr[(int) (i)].frags, players[(int) (i)].frags, ((int) (4) * (int) (4)));
    }
    gamestate = gamestate_t.GS_INTERMISSION;
    viewactive = (uint32) 0;
    automapactive = (uint32) 0;
    StatCopy (_c2v_box_wbstartstruct_t_arr (wminfo));
    WI_Start (wminfo);
}

