void OldNetSync () {
    uint32 i = 0;
    int keyplayer = -1;
    frameon++;
    for (i = (uint32) 0; i < ((uint32) 8); i++) 
    {
        if (local_playeringame[(int) (i)] != 0) 
        {
            keyplayer = (int) i;
            break;
