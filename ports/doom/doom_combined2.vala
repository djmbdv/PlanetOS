    {
        a = _wi_get_anim ((int) wbs.epsd, (int) i);
        a.ctr = -1;
        if (a.type == animenum_t.ANIM_ALWAYS) {
            a.nexttic = ((bcnt + 1) + (M_Random () % a.period));
        }
        else 
        if (a.type == animenum_t.ANIM_RANDOM) {
            a.nexttic = (((bcnt + 1) + a.data2) + (M_Random () % a.data1));
        }
        else 
        if (a.type == animenum_t.ANIM_LEVEL) {
            a.nexttic = (bcnt + 1);
        }
    }
}

