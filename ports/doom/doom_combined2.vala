// c2vala-ptrs: context_obj[PLAIN]=>T? buf_buf[IDX|WR]=>uint8[]
void SHA1_UpdateInt32 (sha1_context_s? context, uint32 val) {
    uint8[] buf = new uint8[4];
    buf[(int) (0)] = (uint8) (((val >> ((uint32) 24)) & ((uint32) 0xff)));
    buf[(int) (1)] = (uint8) (((val >> ((uint32) 16)) & ((uint32) 0xff)));
    buf[(int) (2)] = (uint8) (((val >> ((uint32) 8)) & ((uint32) 0xff)));
    buf[(int) (3)] = (uint8) ((val & ((uint32) 0xff)));
    SHA1_Update (context, buf, (size_t) 4);
}

// c2vala-ptrs: context_obj[PLAIN]=>T? str_obj[PLAIN]=>T?
void SHA1_UpdateString (sha1_context_s? context, uint8[] str) {
    SHA1_Update (context, str, (size_t) ((c_strlen ((string) str) + 1)));
}

public patch_t? sttminus;

void STlib_init () {
    sttminus = new patch_t.at (W_CacheLumpName (c_str_to_bytes ("STTMINUS"), (int) __anon_enum_1.PU_STATIC), 0);
}

// c2vala-ptrs: n_obj[DEREF|WR|ARROW]=>T? pl_pp[PLAIN]=>C2VBox<T[]> num_obj[PLAIN]=>T? on_obj[PLAIN]=>T?
void STlib_initNum (st_number_t? n, int x, int y, patch_t?[] pl, int[] num, uint32[] on, int width) {
    n.x = x;
    n.y = y;
    n.oldnum = 0;
    n.width = width;
    n.num = num;
    n.on = on;
    n.p = pl;
}

// c2vala-ptrs: n_obj[DEREF|WR|ARROW]=>T?
void STlib_drawNum (st_number_t? n, uint32 refresh) {
    int numdigits = n.width;
    int num = n.num[0];
    int w = (int) (n.p[(int) (0)].width);
    int h = (int) (n.p[(int) (0)].height);
    int x = n.x;
    int neg = 0;
    n.oldnum = n.num[0];
    neg = (int) (((num < 0)) ? 1 : 0);
    if (neg != 0) 
    {
        if ((numdigits == 2) && (num < -9)) {
            num = -9;
        }
        else 
        if ((numdigits == 3) && (num < -99)) {
            num = -99;
        }
        num = -num;
    }
    x = (n.x - (numdigits * w));
    if ((n.y - (200 - 32)) < 0) {
        I_Error (c_str_to_bytes ("drawNum: n->y - ST_Y < 0"));
    }
    V_CopyRect (x, (n.y - (200 - 32)), st_backing_screen, (w * numdigits), h, x, n.y);
    if (num == 1994) {
        return;
    }
    x = n.x;
    if (!(num != 0)) {
        V_DrawPatch ((x - w), n.y, n.p[(int) (0)]);
    }
    while ((num != 0) && (numdigits-- != 0)) 
    {
        x -= w;
        V_DrawPatch (x, n.y, n.p[(int) ((num % 10))]);
        num /= 10;
    }
    if (neg != 0) {
        V_DrawPatch ((x - 8), n.y, sttminus);
    }
}

// c2vala-ptrs: n_obj[DEREF|ARROW]=>T?
void STlib_updateNum (st_number_t? n, uint32 refresh) {
    if (n.on[0] != 0) {
        STlib_drawNum (n, refresh);
    }
}

// c2vala-ptrs: p_obj[DEREF|WR|ARROW]=>T? pl_pp[PLAIN]=>C2VBox<T[]> num_obj[PLAIN]=>T? on_obj[PLAIN]=>T? percent_obj[PLAIN]=>T?
void STlib_initPercent (st_percent_t? p, int x, int y, patch_t?[] pl, int[] num, uint32[] on, patch_t? percent) {
    STlib_initNum (p.n, x, y, pl, num, on, 3);
    p.p = percent;
}

// c2vala-ptrs: per_obj[DEREF|ARROW]=>T?
void STlib_updatePercent (st_percent_t? per, int refresh) {
    if ((refresh != 0) && (per.n.on[0] != 0)) {
        V_DrawPatch (per.n.x, per.n.y, per.p);
    }
    STlib_updateNum (per.n, (uint32) refresh);
}

// c2vala-ptrs: i_obj[DEREF|WR|ARROW]=>T? il_pp[PLAIN]=>C2VBox<T[]> inum_obj[PLAIN]=>T? on_obj[PLAIN]=>T?
void STlib_initMultIcon (st_multicon_t? i, int x, int y, patch_t?[] il, int[] inum, uint32[] on) {
    i.x = x;
    i.y = y;
    i.oldinum = -1;
    i.inum = inum;
    i.on = on;
    i.p = il;
}

// c2vala-ptrs: mi_obj[DEREF|WR|ARROW]=>T?
void STlib_updateMultIcon (st_multicon_t? mi, uint32 refresh) {
    int w = 0;
    int h = 0;
    int x = 0;
    int y = 0;
    if (((mi.on[0] != 0) && ((mi.oldinum != mi.inum[0]) || (refresh != 0))) && (mi.inum[0] != -1)) 
    {
        if (mi.oldinum != -1) 
        {
            x = (mi.x - ((int) mi.p[(int) (mi.oldinum)].leftoffset));
            y = (mi.y - ((int) mi.p[(int) (mi.oldinum)].topoffset));
            w = (int) (mi.p[(int) (mi.oldinum)].width);
            h = (int) (mi.p[(int) (mi.oldinum)].height);
            if ((y - (200 - 32)) < 0) {
                I_Error (c_str_to_bytes ("updateMultIcon: y - ST_Y < 0"));
            }
            V_CopyRect (x, (y - (200 - 32)), st_backing_screen, w, h, x, y);
        }
        V_DrawPatch (mi.x, mi.y, mi.p[(int) (mi.inum[0])]);
        mi.oldinum = mi.inum[0];
    }
}

