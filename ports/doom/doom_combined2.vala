// c2vala-ptrs: startname_obj[PLAIN]=>T? endname_obj[PLAIN]=>T?
void P_InitPicAnims () {
    int i = 0;
    lastanim = anims;
    for (i = 0; animdefs[(int) (i)].istexture != -1; i++) 
    {
        uint8[] startname = new uint8[0];
        uint8[] endname = new uint8[0];
        startname = animdefs[(int) (i)].startname;
        endname = animdefs[(int) (i)].endname;
        if (animdefs[(int) (i)].istexture != 0) 
        {
            if (R_CheckTextureNumForName (startname) == -1) {
                continue;
            }
            lastanim[0].picnum = R_TextureNumForName (endname);
            lastanim[0].basepic = R_TextureNumForName (startname);
        }
        else 
        {
            if (W_CheckNumForName (startname) == -1) {
                continue;
            }
            lastanim[0].picnum = R_FlatNumForName (endname);
            lastanim[0].basepic = R_FlatNumForName (startname);
        }
        lastanim[0].istexture = (uint32) (animdefs[(int) (i)].istexture);
        lastanim[0].numpics = ((lastanim[0].picnum - lastanim[0].basepic) + 1);
        if (lastanim[0].numpics < 2) {
            I_Error (c_str_to_bytes ("P_InitPicAnims: bad cycle from %s to %s"), startname, endname);
        }
        lastanim[0].speed = animdefs[(int) (i)].speed;
        lastanim = _c2v_slice_anim_t (lastanim, 1);
    }
}

