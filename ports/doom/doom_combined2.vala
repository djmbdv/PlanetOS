// c2vala-ptrs: line_obj[DEREF|ARROW]=>T? sec_obj[PLAIN]=>T?
sector_t? getNextSector (line_s? line, sector_t[] sec) {
    if (!((((int) line.flags) & 4) != 0)) {
        return null;
    }
    if (line.frontsector == sec[0]) {
        return line.backsector;
    }
    return line.frontsector;
}

// c2vala-ptrs: sec_obj[DEREF|ARROW]=>T? check_obj[PLAIN]=>T? other_obj[DEREF|NULL|ARROW]=>T?
int P_FindLowestFloorSurrounding (sector_t[] sec) {
    int i = 0;
    line_s? check = null;
    sector_t? other = null;
    int floor = sec[0].floorheight;
    for (i = 0; i < sec[0].linecount; i++) 
    {
        check = sec[0].lines[(int) (i)];
        other = getNextSector (check, sec);
        if (!(other != null)) {
            continue;
        }
        if (other.floorheight < floor) {
            floor = other.floorheight;
        }
    }
    return floor;
}

