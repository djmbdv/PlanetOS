// c2vala-ptrs: sec_obj[DEREF|ARROW]=>T? check_obj[PLAIN]=>T? other_obj[DEREF|NULL|ARROW]=>T? heightlist_arr[IDX|WR]=>T[]
int P_FindNextHighestFloor (sector_t[] sec, int currentheight) {
    int i = 0;
    int h = 0;
    int min = 0;
    line_s? check = null;
    sector_t? other = null;
    int height = currentheight;
    int[] heightlist = new int[(20 + 2)];
    {
        i = 0;
        h = 0;
        for (; i < sec[0].linecount; i++) 
        {
            check = sec[0].lines[(int) (i)];
            other = getNextSector (check, sec);
            if (!(other != null)) {
                continue;
            }
            if (other.floorheight > height) 
            {
                if (h == (20 + 1)) 
                {
                    height = other.floorheight;
                }
                else 
                if (h == (20 + 2)) 
                {
                    I_Error (c_str_to_bytes ("Sector with more than 22 adjoining sectors. Vanilla will crash here"));
                }
                heightlist[(int) (h++)] = other.floorheight;
            }
        }
    }
    if (!(h != 0)) 
    {
        return currentheight;
    }
    min = heightlist[(int) (0)];
    for (i = 1; i < h; i++) 
    {
        if (heightlist[(int) (i)] < min) 
        {
            min = heightlist[(int) (i)];
        }
    }
    return min;
}

