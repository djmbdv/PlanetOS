int GetAdjustedTime () {
    int time_ms = 0;
    time_ms = I_GetTimeMS ();
    if (new_sync != 0) 
    {
        time_ms += (offsetms / (1 << 16));
    }
    return ((time_ms * 35) / 1000);
}

uint32 BuildNewTic () {
    int gameticdiv = 0;
    ticcmd_t cmd = new ticcmd_t ();
    gameticdiv = (gametic / ticdup);
    I_StartTic ();
    ((!) loop_interface.ProcessEvents) ();
    ((!) loop_interface.RunMenu) ();
    if (drone != 0) 
    {
        return (uint32) 0;
    }
    if (new_sync != 0) 
    {
        if ((!(net_client_connected != 0)) && ((maketic - gameticdiv) > 2)) {
            return (uint32) 0;
        }
        if ((maketic - gameticdiv) > 8) {
            return (uint32) 0;
        }
    }
    else 
    {
        if ((maketic - gameticdiv) >= 5) {
            return (uint32) 0;
        }
    }
    cmd.forwardmove = 0;
    cmd.sidemove = 0;
    cmd.angleturn = 0;
    cmd.chatchar = 0;
    cmd.buttons = 0;
    cmd.consistancy = 0;
    cmd.buttons2 = 0;
    cmd.inventory = 0;
    cmd.lookfly = 0;
    cmd.arti = 0;
    ((!) loop_interface.BuildTiccmd) (_c2v_box_ticcmd_t_arr (cmd), maketic);
    ticdata[(int) ((maketic % 128))].cmds[(int) (localplayer)] = cmd;
    ticdata[(int) ((maketic % 128))].ingame[(int) (localplayer)] = (uint32) 1;
    ++maketic;
    return (uint32) 1;
}

public int lasttime;

void NetUpdate () {
    int nowtime = 0;
    int newtics = 0;
    int i = 0;
    if (singletics != 0) {
        return;
    }
    nowtime = (GetAdjustedTime () / ticdup);
    newtics = (nowtime - lasttime);
    lasttime = nowtime;
    if (skiptics <= newtics) 
    {
        newtics -= skiptics;
        skiptics = 0;
    }
    else 
    {
        skiptics -= newtics;
        newtics = 0;
    }
    for (i = 0; i < newtics; i++) 
    {
        if (!(BuildNewTic () != 0)) 
        {
            break;
        }
    }
}

void D_Disconnected () {
    if (drone != 0) 
    {
        I_Error (c_str_to_bytes ("Disconnected from server in drone mode."));
    }
    print (@"Disconnected from server.\n");
}

// c2vala-ptrs: ticcmds_arr[IDX|NULL]=>T[] players_mask_arr[IDX|NULL]=>T[]
void D_ReceiveTic (ticcmd_t[] ticcmds, uint32[] players_mask) {
    int i = 0;
    if ((ticcmds == null) && (players_mask == null)) 
    {
        D_Disconnected ();
        return;
    }
    for (i = 0; i < 8; ++i) 
    {
        if ((!(drone != 0)) && (i == localplayer)) 
        {
        }
        else 
        {
            ticdata[(int) ((recvtic % 128))].cmds[(int) (i)] = ticcmds[(int) (i)];
            ticdata[(int) ((recvtic % 128))].ingame[(int) (i)] = players_mask[(int) (i)];
        }
    }
    ++recvtic;
}

void D_StartGameLoop () {
    lasttime = (GetAdjustedTime () / ticdup);
}

// c2vala-ptrs: settings_obj[DEREF|WR|ARROW]=>T?
void D_StartNetGame (net_gamesettings_t? settings, _c2v_del_netgame_startup_callback_t_dcb2f807? callback) {
    settings.consoleplayer = 0;
    settings.num_players = 1;
    settings.player_classes[(int) (0)] = player_class;
    settings.new_sync = 0;
    settings.extratics = 1;
    settings.ticdup = 1;
    ticdup = settings.ticdup;
    new_sync = (uint32) settings.new_sync;
}

// c2vala-ptrs: connect_data_obj[DEREF|ARROW]=>T?
uint32 D_InitNetGame (net_connect_data_t? connect_data) {
    uint32 result = (uint32) 0;
    I_AtExit (D_QuitNetGame, (uint32) 1);
    player_class = connect_data.player_class;
    return result;
}

