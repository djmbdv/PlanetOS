            player.mo.angle += (uint32) ((0x40000000 / 18));
        }
        else {
            player.mo.angle -= (uint32) ((0x40000000 / 18));
        }
    }
    else 
    if (player.damagecount != 0) {
        player.damagecount--;
    }
