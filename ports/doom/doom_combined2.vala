        i = 0;
        player = players;
        _off_player = 0;
        for (; i < 4; ) {
            {
                if (playeringame[(int) (i)] != 0) 
                {
                    if ((player[_off_player].cmd.buttons & ((int) buttoncode_t.BT_ATTACK)) != 0) 
                    {
                        if (!(player[_off_player].attackdown != 0)) {
                            acceleratestage = 1;
                        }
                        player[_off_player].attackdown = 1;
                    }
                    else {
                        player[_off_player].attackdown = 0;
                    }
                    if ((player[_off_player].cmd.buttons & ((int) buttoncode_t.BT_USE)) != 0) 
                    {
                        if (!(player[_off_player].usedown != 0)) {
                            acceleratestage = 1;
                        }
                        player[_off_player].usedown = 1;
                    }
                    else {
                        player[_off_player].usedown = 0;
                    }
                }
            }
            i++;
            _off_player++;
        }
    }
}

void WI_Ticker () {
    bcnt++;
    if (bcnt == 1) 
    {
        if (gamemode == GameMode_t.commercial) {
            0;
        }
        else {
            0;
        }
    }
    WI_checkForAccelerate ();
    switch (state) {
        case stateenum_t.StatCount:
            if (deathmatch != 0) {
                WI_updateDeathmatchStats ();
            }
            else 
            if (netgame != 0) {
                WI_updateNetgameStats ();
            }
            else {
                WI_updateStats ();
            }
            break;
        case stateenum_t.ShowNextLoc:
            WI_updateShowNextLoc ();
            break;
        case stateenum_t.NoState:
            WI_updateNoState ();
            break;
    }
}

