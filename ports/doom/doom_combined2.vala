void D_IdentifyVersion () {
    if (gamemission == GameMission_t.none) 
    {
        uint32 i = 0;
        for (i = (uint32) 0; i < numlumps; ++i) 
        {
            if (!(GLib.ascii_strncasecmp ((string) lumpinfo[(int) (i)].name, "MAP01", 8) != 0)) 
            {
                gamemission = GameMission_t.doom2;
                break;
            }
            else 
            if (!(GLib.ascii_strncasecmp ((string) lumpinfo[(int) (i)].name, "E1M1", 8) != 0)) 
            {
                gamemission = GameMission_t.doom;
                break;
            }
        }
        if (gamemission == GameMission_t.none) 
        {
            I_Error (c_str_to_bytes ("Unknown or invalid IWAD file."));
        }
    }
    if (((gamemission == GameMission_t.pack_chex) ? GameMission_t.doom : ((gamemission == GameMission_t.pack_hacx) ? GameMission_t.doom2 : gamemission)) == ((int) GameMission_t.doom)) 
    {
        if (W_CheckNumForName (c_str_to_bytes ("E4M1")) > 0) 
        {
            gamemode = GameMode_t.retail;
        }
        else 
        if (W_CheckNumForName (c_str_to_bytes ("E3M1")) > 0) 
        {
            gamemode = GameMode_t.registered;
        }
        else 
        {
            gamemode = GameMode_t.shareware;
        }
    }
    else 
    {
        int p = 0;
        gamemode = GameMode_t.commercial;
        p = M_CheckParmWithArgs (c_str_to_bytes ("-pack"), 1);
        if (p > 0) 
        {
            SetMissionForPackName (c_str_to_bytes (myargv[(int) ((p + 1))]));
        }
    }
}

void D_SetGameDescription () {
    uint32 is_freedoom = (uint32) (((W_CheckNumForName (c_str_to_bytes ("FREEDOOM")) >= 0)) ? 1 : 0);
    uint32 is_freedm = (uint32) (((W_CheckNumForName (c_str_to_bytes ("FREEDM")) >= 0)) ? 1 : 0);
    gamedescription = "Unknown";
    if (((gamemission == GameMission_t.pack_chex) ? GameMission_t.doom : ((gamemission == GameMission_t.pack_hacx) ? GameMission_t.doom2 : gamemission)) == ((int) GameMission_t.doom)) 
    {
        if (is_freedoom != 0) 
        {
            gamedescription = (string) GetGameName (c_str_to_bytes ("Freedoom: Phase 1"));
        }
        else 
        if (gamemode == GameMode_t.retail) 
        {
            gamedescription = (string) GetGameName (c_str_to_bytes ("The Ultimate DOOM"));
        }
        else 
        if (gamemode == GameMode_t.registered) 
        {
            gamedescription = (string) GetGameName (c_str_to_bytes ("DOOM Registered"));
        }
        else 
        if (gamemode == GameMode_t.shareware) 
        {
            gamedescription = (string) GetGameName (c_str_to_bytes ("DOOM Shareware"));
        }
    }
    else 
    {
        if (is_freedoom != 0) 
        {
            if (is_freedm != 0) 
            {
                gamedescription = (string) GetGameName (c_str_to_bytes ("FreeDM"));
            }
            else 
            {
                gamedescription = (string) GetGameName (c_str_to_bytes ("Freedoom: Phase 2"));
            }
        }
        else 
        if (((gamemission == GameMission_t.pack_chex) ? GameMission_t.doom : ((gamemission == GameMission_t.pack_hacx) ? GameMission_t.doom2 : gamemission)) == ((int) GameMission_t.doom2)) 
        {
            gamedescription = (string) GetGameName (c_str_to_bytes ("DOOM 2: Hell on Earth"));
        }
        else 
        if (((gamemission == GameMission_t.pack_chex) ? GameMission_t.doom : ((gamemission == GameMission_t.pack_hacx) ? GameMission_t.doom2 : gamemission)) == ((int) GameMission_t.pack_plut)) 
        {
            gamedescription = (string) GetGameName (c_str_to_bytes ("DOOM 2: Plutonia Experiment"));
        }
        else 
        if (((gamemission == GameMission_t.pack_chex) ? GameMission_t.doom : ((gamemission == GameMission_t.pack_hacx) ? GameMission_t.doom2 : gamemission)) == ((int) GameMission_t.pack_tnt)) 
        {
            gamedescription = (string) GetGameName (c_str_to_bytes ("DOOM 2: TNT - Evilution"));
        }
    }
}

