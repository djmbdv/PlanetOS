    ml.b.y = (m_y + m_h);
    for (x = start; x < end; x += (128 << 16)) 
    {
        ml.a.x = x;
        ml.b.x = x;
        AM_drawMline (ml, color);
    }
    start = m_y;
    if (((start - bmaporgy) % (128 << 16)) != 0) {
        start += ((128 << 16) - ((start - bmaporgy) % (128 << 16)));
    }
    end = (m_y + m_h);
    ml.a.x = m_x;
    ml.b.x = (m_x + m_w);
    for (y = start; y < end; y += (128 << 16)) 
    {
        ml.a.y = y;
        ml.b.y = y;
        AM_drawMline (ml, color);
    }
}

void AM_drawWalls () {
    int i = 0;
    mline_t l = new mline_t ();
    for (i = 0; i < numlines; i++) 
    {
        l.a.x = lines[(int) (i)].v1.x;
        l.a.y = lines[(int) (i)].v1.y;
        l.b.x = lines[(int) (i)].v2.x;
        l.b.y = lines[(int) (i)].v2.y;
        if ((cheating != 0) || ((((int) lines[(int) (i)].flags) & 256) != 0)) 
        {
            if (((((int) lines[(int) (i)].flags) & 128) != 0) && (!(cheating != 0))) {
                continue;
            }
            if (!(lines[(int) (i)].backsector != null)) 
            {
                AM_drawMline (l, ((256 - (5 * 16)) + lightlev));
            }
            else 
            {
                if (((int) lines[(int) (i)].special) == 39) 
                {
                    AM_drawMline (l, ((256 - (5 * 16)) + (16 / 2)));
                }
                else 
                if ((((int) lines[(int) (i)].flags) & 32) != 0) 
                {
                    if (cheating != 0) {
                        AM_drawMline (l, ((256 - (5 * 16)) + lightlev));
                    }
                    else {
                        AM_drawMline (l, ((256 - (5 * 16)) + lightlev));
                    }
                }
                else 
                if (lines[(int) (i)].backsector.floorheight != lines[(int) (i)].frontsector.floorheight) 
                {
                    AM_drawMline (l, ((4 * 16) + lightlev));
                }
                else 
                if (lines[(int) (i)].backsector.ceilingheight != lines[(int) (i)].frontsector.ceilingheight) 
                {
                    AM_drawMline (l, (((256 - 32) + 7) + lightlev));
                }
                else 
                if (cheating != 0) 
                {
                    AM_drawMline (l, ((6 * 16) + lightlev));
                }
            }
        }
        else 
        if (plr.powers[(int) (powertype_t.pw_allmap)] != 0) 
        {
            if (!((((int) lines[(int) (i)].flags) & 128) != 0)) {
                AM_drawMline (l, ((6 * 16) + 3));
            }
        }
    }
}

// c2vala-ptrs: x_obj[DEREF|WR]=>T? y_obj[DEREF|WR]=>T?
void AM_rotate (int[] x, int[] y, uint32 a) {
    int tmpx = 0;
    tmpx = (FixedMul (x[0], finecosine[(int) ((a >> ((uint32) 19)))]) - FixedMul (y[0], finesine[(int) ((a >> ((uint32) 19)))]));
    y[0] = (FixedMul (x[0], finesine[(int) ((a >> ((uint32) 19)))]) + FixedMul (y[0], finecosine[(int) ((a >> ((uint32) 19)))]));
    x[0] = tmpx;
}

// c2vala-ptrs: lineguy_arr[IDX]=>T[]
void AM_drawLineCharacter (mline_t[] lineguy, int lineguylines, int scale, uint32 angle, int color, int x, int y) {
    int i = 0;
    mline_t l = new mline_t ();
    for (i = 0; i < lineguylines; i++) 
    {
        l.a.x = lineguy[(int) (i)].a.x;
        l.a.y = lineguy[(int) (i)].a.y;
        if (scale != 0) 
        {
            l.a.x = FixedMul (scale, l.a.x);
            l.a.y = FixedMul (scale, l.a.y);
        }
        if (angle != 0) {
            int[] _c2v_ref_0 = { l.a.x };
            int[] _c2v_ref_1 = { l.a.y };
            AM_rotate (_c2v_ref_0, _c2v_ref_1, angle);
            l.a.x = _c2v_ref_0[0];
            l.a.y = _c2v_ref_1[0];
        }
        l.a.x += x;
        l.a.y += y;
        l.b.x = lineguy[(int) (i)].b.x;
        l.b.y = lineguy[(int) (i)].b.y;
        if (scale != 0) 
        {
            l.b.x = FixedMul (scale, l.b.x);
            l.b.y = FixedMul (scale, l.b.y);
        }
        if (angle != 0) {
            int[] _c2v_ref_2 = { l.b.x };
            int[] _c2v_ref_3 = { l.b.y };
            AM_rotate (_c2v_ref_2, _c2v_ref_3, angle);
            l.b.x = _c2v_ref_2[0];
            l.b.y = _c2v_ref_3[0];
        }
        l.b.x += x;
        l.b.y += y;
        AM_drawMline (l, color);
    }
}

// c2vala-ptrs: p_obj[DEREF|NULL|ARROW]=>T? their_colors_arr[IDX]=>T[]
void AM_drawPlayers () {
    int i = 0;
    player_s? p = null;
