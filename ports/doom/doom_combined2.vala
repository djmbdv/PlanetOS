// c2vala-ptrs: thing_obj[DEREF|ARROW]=>T? line_obj[DEREF|ARROW]=>T?
void P_ShootSpecialLine (mobj_s? thing, line_s[] line) {
    int ok = 0;
    if (!(thing.player != null)) 
    {
        ok = 0;
        switch (line[0].special) {
            case 46:
                ok = 1;
                break;
        }
        if (!(ok != 0)) {
            return;
        }
    }
    switch (line[0].special) {
        case 24:
            EV_DoFloor (line, floor_e.raiseFloor);
            P_ChangeSwitchTexture (line, 0);
            break;
        case 46:
            EV_DoDoor (line, vldoor_e.vld_open);
            P_ChangeSwitchTexture (line, 1);
            break;
        case 47:
            EV_DoPlat (line, plattype_e.raiseToNearestAndChange, 0);
            P_ChangeSwitchTexture (line, 0);
            break;
    }
}

// c2vala-ptrs: player_obj[DEREF|WR|ARROW]=>T? sector_obj[DEREF|WR|ARROW]=>T?
void P_PlayerInSpecialSector (player_s? player) {
    sector_t? sector = null;
    sector = player.mo.subsector.sector;
    if (player.mo.z != sector.floorheight) {
        return;
    }
    switch (sector.special) {
        case 5:
            if (!(player.powers[(int) (powertype_t.pw_ironfeet)] != 0)) {
                if (!((leveltime & 0x1f) != 0)) {
                    P_DamageMobj (_c2v_box_mobj_s_arr (player.mo), null, null, 10);
                }
            }
            break;
        case 7:
            if (!(player.powers[(int) (powertype_t.pw_ironfeet)] != 0)) {
                if (!((leveltime & 0x1f) != 0)) {
                    P_DamageMobj (_c2v_box_mobj_s_arr (player.mo), null, null, 5);
                }
            }
            break;
        case 16:
        case 4:
            if ((!(player.powers[(int) (powertype_t.pw_ironfeet)] != 0)) || (P_Random () < 5)) 
            {
                if (!((leveltime & 0x1f) != 0)) {
                    P_DamageMobj (_c2v_box_mobj_s_arr (player.mo), null, null, 20);
                }
            }
            break;
        case 9:
            player.secretcount++;
            sector.special = (int16) 0;
            break;
        case 11:
            player.cheats &= (int) ((~(int) (cheat_t.CF_GODMODE)));
            if (!((leveltime & 0x1f) != 0)) {
                P_DamageMobj (_c2v_box_mobj_s_arr (player.mo), null, null, 20);
            }
            if (player.health <= 10) {
                G_ExitLevel ();
            }
            break;
        default:
            I_Error (c_str_to_bytes ("P_PlayerInSpecialSector: unknown special %i"), sector.special);
            break;
    }
}

// c2vala-ptrs: anim_arr[ARITH|DEREF|ARROW]=>T[] line_obj[DEREF|ARROW]=>T?
void P_UpdateSpecials () {
    anim_t[] anim = new anim_t[0];
    int _off_anim = 0;
    int pic = 0;
    int i = 0;
    line_s? line = null;
    if (levelTimer == ((uint32) 1)) 
    {
        levelTimeCount--;
        if (!(levelTimeCount != 0)) {
            G_ExitLevel ();
        }
    }
    {
        anim = anims;
        _off_anim = 0;
        for (; (anim[0] == lastanim[0]) ? (_off_anim < 0) : (uintptr.from_pointer ((void*) (anim)) < uintptr.from_pointer ((void*) (lastanim))); _off_anim++) 
        {
            for (i = anim[_off_anim].basepic; i < (anim[_off_anim].basepic + anim[_off_anim].numpics); i++) 
            {
                pic = (anim[_off_anim].basepic + (((leveltime / anim[_off_anim].speed) + i) % anim[_off_anim].numpics));
                if (anim[_off_anim].istexture != 0) {
                    texturetranslation[(int) (i)] = pic;
                }
                else {
                    flattranslation[(int) (i)] = pic;
                }
            }
        }
    }
    for (i = 0; i < ((int) numlinespecials); i++) 
    {
        line = linespeciallist[(int) (i)];
        switch (line.special) {
            case 48:
                sides[(int) (line.sidenum[(int) (0)])].textureoffset += (1 << 16);
                break;
        }
    }
    for (i = 0; i < 16; i++) {
        if (buttonlist[(int) (i)].btimer != 0) 
        {
            buttonlist[(int) (i)].btimer--;
            if (!(buttonlist[(int) (i)].btimer != 0)) 
            {
                switch (buttonlist[(int) (i)].where) {
                    case bwhere_e.top:
                        sides[(int) (buttonlist[(int) (i)].line.sidenum[(int) (0)])].toptexture = (int16) (buttonlist[(int) (i)].btexture);
                        break;
                    case bwhere_e.middle:
                        sides[(int) (buttonlist[(int) (i)].line.sidenum[(int) (0)])].midtexture = (int16) (buttonlist[(int) (i)].btexture);
                        break;
                    case bwhere_e.bottom:
                        sides[(int) (buttonlist[(int) (i)].line.sidenum[(int) (0)])].bottomtexture = (int16) (buttonlist[(int) (i)].btexture);
                        break;
                }
                0;
                _c2v_slice_button_t (buttonlist, (int) (i))[0].line = null;
                _c2v_slice_button_t (buttonlist, (int) (i))[0].where = (bwhere_e) 0;
                _c2v_slice_button_t (buttonlist, (int) (i))[0].btexture = 0;
                _c2v_slice_button_t (buttonlist, (int) (i))[0].btimer = 0;
                _c2v_slice_button_t (buttonlist, (int) (i))[0].soundorg = null;
            }
        }
    }
}

// c2vala-ptrs: s3_floorheight_obj[DEREF|WR]=>T? s3_floorpic_obj[DEREF|WR]=>T? line_obj[PLAIN]=>T? pillar_sector_obj[PLAIN]=>T?
void DonutOverrun (int[] s3_floorheight, int16[] s3_floorpic, line_s[] line, sector_t[] pillar_sector) {
    int first = 1;
    int[] tmp_s3_floorheight = new int[1];
    int[] tmp_s3_floorpic = new int[1];
    if (first != 0) 
    {
        int p = 0;
        first = 0;
        tmp_s3_floorheight[0] = 0x00000000;
        tmp_s3_floorpic[0] = 0x16;
        p = M_CheckParmWithArgs (c_str_to_bytes ("-donut"), 2);
        if (p > 0) 
        {
            M_StrToInt (c_str_to_bytes (myargv[(int) ((p + 1))]), tmp_s3_floorheight);
            M_StrToInt (c_str_to_bytes (myargv[(int) ((p + 2))]), tmp_s3_floorpic);
            if (tmp_s3_floorpic[0] >= numflats) 
            {
                stderr.puts (@"DonutOverrun: The second parameter for \"-donut\" switch should be greater than 0 and less than number of flats ($(numflats)). Using default value ($(0x16)) instead. \n");
                tmp_s3_floorpic[0] = 0x16;
            }
        }
    }
    s3_floorheight[0] = tmp_s3_floorheight[0];
    s3_floorpic[0] = ((int16) (tmp_s3_floorpic[0]));
}

// c2vala-ptrs: line_obj[PLAIN]=>T? s1_obj[DEREF|WR|ARROW]=>T? s2_obj[DEREF|WR|NULL|ARROW]=>T? s3_obj[DEREF|NULL|ARROW]=>T? floor_obj[DEREF|WR|ARROW]=>T?
int EV_DoDonut (line_s[] line) {
    sector_t[] s1 = new sector_t[0];
    sector_t? s2 = null;
    sector_t? s3 = null;
    int secnum = 0;
    int rtn = 0;
    int i = 0;
    floormove_t? floor = null;
    int[] s3_floorheight = new int[1];
    int16[] s3_floorpic = new int16[1];
    secnum = -1;
    rtn = 0;
    while (c_assign_i (P_FindSectorFromLineTag (line, secnum), ref secnum) >= 0) 
    {
        s1 = _c2v_slice_sector_t (sectors, (int) (secnum));
        if (s1[0].specialdata != null) {
            continue;
        }
        rtn = 1;
        s2 = getNextSector (s1[0].lines[(int) (0)], s1);
        if (s2 == null) 
        {
            stderr.puts (@"EV_DoDonut: linedef had no second sidedef! Unexpected behavior may occur in Vanilla Doom. \n");
            break;
        }
        for (i = 0; i < s2.linecount; i++) 
        {
            s3 = s2.lines[(int) (i)].backsector;
            if (s3 == s1[0]) {
                continue;
            }
            if (s3 == null) 
            {
                stderr.puts (@"EV_DoDonut: WARNING: emulating buffer overrun due to NULL back sector. Unexpected behavior may occur in Vanilla Doom.\n");
                DonutOverrun (s3_floorheight, s3_floorpic, line, s1);
            }
            else 
            {
                s3_floorheight[0] = s3.floorheight;
                s3_floorpic[0] = s3.floorpic;
            }
            floor = new floormove_t.at (Z_Malloc ((int) 80, (int) __anon_enum_1.PU_LEVSPEC, new uint8[0]), 0);
            P_AddThinker (floor.thinker);
            s2.specialdata = floor;
            floor.thinker.tag = 4;
            floor.thinker.owner = floor;
            floor.type = floor_e.donutRaise;
            floor.crush = (uint32) 0;
            floor.direction = 1;
            floor.sector = s2;
            floor.speed = ((1 << 16) / 2);
            floor.texture = s3_floorpic[0];
            floor.newspecial = 0;
            floor.floordestheight = s3_floorheight[0];
            floor = new floormove_t.at (Z_Malloc ((int) 80, (int) __anon_enum_1.PU_LEVSPEC, new uint8[0]), 0);
            P_AddThinker (floor.thinker);
            s1[0].specialdata = floor;
            floor.thinker.tag = 4;
            floor.thinker.owner = floor;
            floor.type = floor_e.lowerFloor;
            floor.crush = (uint32) 0;
            floor.direction = -1;
            floor.sector = _c2v_box_sector_t_obj (s1);
            floor.speed = ((1 << 16) / 2);
            floor.floordestheight = s3_floorheight[0];
            break;
        }
    }
    return rtn;
}

// c2vala-ptrs: sector_arr[ARITH|DEREF|WR|ARROW]=>T[]
void P_SpawnSpecials () {
    sector_t[] sector = new sector_t[0];
    int _off_sector = 0;
    int i = 0;
    if ((timelimit > 0) && (deathmatch != 0)) 
    {
        levelTimer = (uint32) 1;
        levelTimeCount = ((timelimit * 60) * 35);
    }
    else 
    {
        levelTimer = (uint32) 0;
    }
    sector = sectors;
    _off_sector = 0;
    for (i = 0; i < numsectors; ) {
        {
            if (!(sector[_off_sector].special != 0)) {
                {
                    i++;
                    _off_sector++;
                    continue;
                }
            }
            switch (sector[_off_sector].special) {
                case 1:
                    P_SpawnLightFlash (_c2v_slice_sector_t (sector, _off_sector));
                    break;
                case 2:
                    P_SpawnStrobeFlash (_c2v_slice_sector_t (sector, _off_sector), 15, 0);
                    break;
                case 3:
                    P_SpawnStrobeFlash (_c2v_slice_sector_t (sector, _off_sector), 35, 0);
                    break;
                case 4:
                    P_SpawnStrobeFlash (_c2v_slice_sector_t (sector, _off_sector), 15, 0);
                    sector[_off_sector].special = (int16) 4;
                    break;
                case 8:
                    P_SpawnGlowingLight (_c2v_slice_sector_t (sector, _off_sector));
                    break;
                case 9:
                    totalsecret++;
                    break;
                case 10:
                    P_SpawnDoorCloseIn30 (_c2v_slice_sector_t (sector, _off_sector));
                    break;
                case 12:
                    P_SpawnStrobeFlash (_c2v_slice_sector_t (sector, _off_sector), 35, 1);
                    break;
                case 13:
                    P_SpawnStrobeFlash (_c2v_slice_sector_t (sector, _off_sector), 15, 1);
                    break;
                case 14:
                    P_SpawnDoorRaiseIn5Mins (_c2v_slice_sector_t (sector, _off_sector), i);
                    break;
                case 17:
                    P_SpawnFireFlicker (_c2v_slice_sector_t (sector, _off_sector));
                    break;
            }
        }
        i++;
        _off_sector++;
    }
    numlinespecials = (int16) 0;
    for (i = 0; i < numlines; i++) 
    {
        switch (lines[(int) (i)].special) {
            case 48:
                if (((int) numlinespecials) >= 64) 
                {
                    I_Error (c_str_to_bytes ("Too many scrolling wall linedefs! (Vanilla limit is 64)"));
                }
                linespeciallist[(int) (numlinespecials)] = _c2v_box_line_s_obj (_c2v_slice_line_s (lines, (int) (i)));
                numlinespecials++;
                break;
        }
    }
    for (i = 0; i < 30; i++) {
        activeceilings[(int) (i)] = null;
    }
    for (i = 0; i < 30; i++) {
        activeplats[(int) (i)] = null;
    }
    for (i = 0; i < 16; i++) {
        _c2v_slice_button_t (buttonlist, (int) (i))[0].line = null;
        _c2v_slice_button_t (buttonlist, (int) (i))[0].where = (bwhere_e) 0;
        _c2v_slice_button_t (buttonlist, (int) (i))[0].btexture = 0;
        _c2v_slice_button_t (buttonlist, (int) (i))[0].btimer = 0;
        _c2v_slice_button_t (buttonlist, (int) (i))[0].soundorg = null;
    }
}

public switchlist_t[] alphSwitchList;

public int[] switchlist;

public int numswitches;

void P_InitSwitchList () {
    int i = 0;
    int index = 0;
    int episode = 0;
    episode = 1;
    if ((gamemode == GameMode_t.registered) || (gamemode == GameMode_t.retail)) {
        episode = 2;
    }
    else 
    if (gamemode == GameMode_t.commercial) {
        episode = 3;
    }
    {
        index = 0;
        i = 0;
        for (; i < 50; i++) 
        {
            if (!(alphSwitchList[(int) (i)].episode != 0)) 
            {
                numswitches = (index / 2);
                switchlist[(int) (index)] = -1;
                break;
            }
            if (((int) alphSwitchList[(int) (i)].episode) <= episode) 
            {
                switchlist[(int) (index++)] = R_TextureNumForName (alphSwitchList[(int) (i)].name1);
                switchlist[(int) (index++)] = R_TextureNumForName (alphSwitchList[(int) (i)].name2);
            }
        }
    }
}

// c2vala-ptrs: line_obj[DEREF|ARROW]=>T?
void P_StartButton (line_s[] line, bwhere_e w, int texture, int time) {
    int i = 0;
    for (i = 0; i < 16; i++) 
    {
        if ((buttonlist[(int) (i)].btimer != 0) && (buttonlist[(int) (i)].line == line[0])) 
        {
            return;
        }
    }
    for (i = 0; i < 16; i++) 
    {
        if (!(buttonlist[(int) (i)].btimer != 0)) 
        {
            buttonlist[(int) (i)].line = _c2v_box_line_s_obj (line);
            buttonlist[(int) (i)].where = w;
            buttonlist[(int) (i)].btexture = texture;
            buttonlist[(int) (i)].btimer = time;
            buttonlist[(int) (i)].soundorg = line[0].frontsector.soundorg;
            return;
        }
    }
    I_Error (c_str_to_bytes ("P_StartButton: no button slots left!"));
}

// c2vala-ptrs: line_obj[DEREF|WR|ARROW]=>T?
void P_ChangeSwitchTexture (line_s[] line, int useAgain) {
    int texTop = 0;
    int texMid = 0;
    int texBot = 0;
    int i = 0;
    int sound = 0;
    if (!(useAgain != 0)) {
        line[0].special = (int16) 0;
    }
    texTop = (int) (sides[(int) (line[0].sidenum[(int) (0)])].toptexture);
    texMid = (int) (sides[(int) (line[0].sidenum[(int) (0)])].midtexture);
