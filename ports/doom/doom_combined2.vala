public __anon_struct_106[] valid_modes;

uint32 D_ValidGameMode (GameMission_t mission, GameMode_t mode) {
    int i = 0;
    for (i = 0; ((uint64) i) < ((valid_modes.length * (int) (16)) / 16); ++i) 
    {
        if ((valid_modes[(int) (i)].mode == mode) && (valid_modes[(int) (i)].mission == mission)) 
        {
            return (uint32) 1;
        }
    }
    return (uint32) 0;
}

uint32 D_ValidEpisodeMap (GameMission_t mission, GameMode_t mode, int episode, int map) {
    int i = 0;
    if (mission == GameMission_t.heretic) 
    {
        if ((mode == GameMode_t.retail) && (episode == 6)) 
        {
            return (uint32) ((((map >= 1) && (map <= 3))) ? 1 : 0);
        }
        else 
        if ((mode == GameMode_t.registered) && (episode == 4)) 
        {
            return (uint32) (((map == 1)) ? 1 : 0);
        }
    }
    for (i = 0; ((uint64) i) < ((valid_modes.length * (int) (16)) / 16); ++i) 
    {
        if ((mission == valid_modes[(int) (i)].mission) && (mode == valid_modes[(int) (i)].mode)) 
        {
            return (uint32) ((((((episode >= 1) && (episode <= valid_modes[(int) (i)].episode)) && (map >= 1)) && (map <= valid_modes[(int) (i)].map))) ? 1 : 0);
        }
    }
    return (uint32) 0;
}

int D_GetNumEpisodes (GameMission_t mission, GameMode_t mode) {
    int episode = 0;
    episode = 1;
    while (D_ValidEpisodeMap (mission, mode, episode, 1) != 0) 
    {
        ++episode;
    }
    return (episode - 1);
}

public __anon_struct_107[] valid_versions;

uint32 D_ValidGameVersion (GameMission_t mission, GameVersion_t version) {
    int i = 0;
    if (((((mission == GameMission_t.doom2) || (mission == GameMission_t.pack_plut)) || (mission == GameMission_t.pack_tnt)) || (mission == GameMission_t.pack_hacx)) || (mission == GameMission_t.pack_chex)) 
    {
        mission = GameMission_t.doom;
    }
    for (i = 0; ((uint64) i) < ((valid_versions.length * (int) (8)) / 8); ++i) 
    {
        if ((valid_versions[(int) (i)].mission == mission) && (valid_versions[(int) (i)].version == version)) 
        {
            return (uint32) 1;
        }
    }
    return (uint32) 0;
}

uint32 D_IsEpisodeMap (GameMission_t mission) {
    switch (mission) {
        case GameMission_t.doom:
        case GameMission_t.heretic:
        case GameMission_t.pack_chex:
            return (uint32) 1;
        case GameMission_t.none:
        case GameMission_t.hexen:
        case GameMission_t.doom2:
        case GameMission_t.pack_hacx:
        case GameMission_t.pack_tnt:
        case GameMission_t.pack_plut:
        case GameMission_t.strife:
        default:
            return (uint32) 0;
    }
}

string D_GameMissionString (GameMission_t mission) {
    switch (mission) {
        case GameMission_t.none:
        default:
            return "none";
        case GameMission_t.doom:
            return "doom";
        case GameMission_t.doom2:
            return "doom2";
        case GameMission_t.pack_tnt:
            return "tnt";
        case GameMission_t.pack_plut:
            return "plutonia";
        case GameMission_t.pack_hacx:
            return "hacx";
        case GameMission_t.pack_chex:
            return "chex";
        case GameMission_t.heretic:
            return "heretic";
        case GameMission_t.hexen:
            return "hexen";
        case GameMission_t.strife:
            return "strife";
    }
}

