// c2vala-ptrs: player_obj[DEREF|WR|ARROW]=>T?
uint32 P_CheckAmmo (player_s? player) {
    ammotype_t ammo = (ammotype_t) 0;
    int count = 0;
    ammo = weaponinfo[(int) (player.readyweapon)].ammo;
    if (player.readyweapon == weapontype_t.wp_bfg) {
        count = 40;
    }
    else 
    if (player.readyweapon == weapontype_t.wp_supershotgun) {
        count = 2;
    }
    else {
        count = 1;
    }
    if ((ammo == ammotype_t.am_noammo) || (player.ammo[(int) (ammo)] >= count)) {
        return (uint32) 1;
    }
    do {
        if (((player.weaponowned[(int) (weapontype_t.wp_plasma)] != 0) && (player.ammo[(int) (ammotype_t.am_cell)] != 0)) && (gamemode != GameMode_t.shareware)) 
        {
            player.pendingweapon = weapontype_t.wp_plasma;
        }
        else 
        if (((player.weaponowned[(int) (weapontype_t.wp_supershotgun)] != 0) && (player.ammo[(int) (ammotype_t.am_shell)] > 2)) && (gamemode == GameMode_t.commercial)) 
        {
            player.pendingweapon = weapontype_t.wp_supershotgun;
        }
        else 
        if ((player.weaponowned[(int) (weapontype_t.wp_chaingun)] != 0) && (player.ammo[(int) (ammotype_t.am_clip)] != 0)) 
        {
            player.pendingweapon = weapontype_t.wp_chaingun;
        }
        else 
        if ((player.weaponowned[(int) (weapontype_t.wp_shotgun)] != 0) && (player.ammo[(int) (ammotype_t.am_shell)] != 0)) 
        {
            player.pendingweapon = weapontype_t.wp_shotgun;
        }
        else 
        if (player.ammo[(int) (ammotype_t.am_clip)] != 0) 
        {
            player.pendingweapon = weapontype_t.wp_pistol;
        }
        else 
        if (player.weaponowned[(int) (weapontype_t.wp_chainsaw)] != 0) 
        {
            player.pendingweapon = weapontype_t.wp_chainsaw;
        }
        else 
        if ((player.weaponowned[(int) (weapontype_t.wp_missile)] != 0) && (player.ammo[(int) (ammotype_t.am_misl)] != 0)) 
        {
            player.pendingweapon = weapontype_t.wp_missile;
        }
        else 
        if (((player.weaponowned[(int) (weapontype_t.wp_bfg)] != 0) && (player.ammo[(int) (ammotype_t.am_cell)] > 40)) && (gamemode != GameMode_t.shareware)) 
        {
            player.pendingweapon = weapontype_t.wp_bfg;
        }
        else 
        {
            player.pendingweapon = weapontype_t.wp_fist;
        }
    } while (player.pendingweapon == weapontype_t.wp_nochange);
    P_SetPsprite (player, (int) psprnum_t.ps_weapon, (statenum_t) (weaponinfo[(int) (player.readyweapon)].downstate));
    return (uint32) 0;
}

// c2vala-ptrs: player_obj[DEREF|ARROW]=>T?
void P_FireWeapon (player_s? player) {
    statenum_t newstate = (statenum_t) 0;
    if (!(P_CheckAmmo (player) != 0)) {
        return;
    }
    P_SetMobjState (_c2v_box_mobj_s_arr (player.mo), statenum_t.S_PLAY_ATK1);
    newstate = (statenum_t) (weaponinfo[(int) (player.readyweapon)].atkstate);
