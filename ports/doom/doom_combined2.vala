void D_DoomLoop () {
    if ((bfgedition != 0) && (((demorecording != 0) || (gameaction == gameaction_t.ga_playdemo)) || (netgame != 0))) 
    {
        print (@" WARNING: You are playing using one of the Doom Classic\n IWAD files shipped with the Doom 3: BFG Edition. These are\n known to be incompatible with the regular IWAD files and\n may cause demos and network games to get out of sync.\n");
    }
    if (demorecording != 0) {
        G_BeginRecording ();
    }
    main_loop_started = (uint32) 1;
    TryRunTics ();
    I_SetWindowTitle (c_str_to_bytes (gamedescription));
    I_GraphicsCheckCommandLine ();
    I_SetGrabMouseCallback (D_GrabMouseCallback);
    I_InitGraphics ();
    I_EnableLoadingDisk ();
    V_RestoreBuffer ();
    R_ExecuteSetViewSize ();
    D_StartGameLoop ();
    if (testcontrols != 0) 
    {
        wipegamestate = gamestate;
    }
    doomgeneric_Tick ();
}

