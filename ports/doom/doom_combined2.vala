// c2vala-ptrs: player_obj[DEREF|WR|ARROW]=>T? cmd_obj[DEREF|WR|ARROW]=>T?
void P_PlayerThink (player_s? player) {
    ticcmd_t? cmd = null;
    weapontype_t newweapon = (weapontype_t) 0;
    if ((player.cheats & ((int) cheat_t.CF_NOCLIP)) != 0) {
        player.mo.flags |= (int) mobjflag_t.MF_NOCLIP;
    }
    else {
        player.mo.flags &= (int) ((~(int) (mobjflag_t.MF_NOCLIP)));
    }
    cmd = player.cmd;
    if ((player.mo.flags & ((int) mobjflag_t.MF_JUSTATTACKED)) != 0) 
    {
        cmd.angleturn = (int16) 0;
        cmd.forwardmove = (int8) ((0xc800 / 512));
        cmd.sidemove = (int8) 0;
        player.mo.flags &= (int) ((~(int) (mobjflag_t.MF_JUSTATTACKED)));
    }
    if (player.playerstate == playerstate_t.PST_DEAD) 
    {
