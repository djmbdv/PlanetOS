private static void _c2v_copy_arr_ticcmd_t (ticcmd_t[] dst, int doff, ticcmd_t[] src, int soff, int n) {
    for (int i = 0; i < n; i++) {
        if (doff + i < dst.length && soff + i < src.length)
            dst[doff + i] = src[soff + i];
    }
}

private static void _c2v_copy_arr_wbstartstruct_t (wbstartstruct_t[] dst, int doff, wbstartstruct_t[] src, int soff, int n) {
