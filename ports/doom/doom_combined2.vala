            block = (((bbox[(int) (__anon_enum_116.BOXLEFT)] - bmaporgx) - (32 * (1 << 16))) >> (16 + 7));
            block = ((block < 0) ? 0 : block);
            sector[_off_sector].blockbox[(int) (__anon_enum_116.BOXLEFT)] = block;
        }
        i++;
        _off_sector++;
    }
}

// c2vala-ptrs: array_buf[ARITH|WR]=>uint8[] dest_buf[ARITH|DEREF|WR]=>uint8[] rejectpad_arr[IDX]=>T[]
void PadRejectArray (uint8[] array, uint32 len) {
    int _off_array = 0;
    uint32 i = 0;
    uint32 byte_num = 0;
    uint8[] dest = new uint8[0];
    int _off_dest = 0;
    uint32 padvalue = 0;
    uint32[] rejectpad = new uint32[] { (uint32) (((((totallines * 4) + 3) & ~3) + 24)), (uint32) 0, (uint32) 50, (uint32) 0x1d4a11 };
    dest = array;
    _off_dest = _off_array;
    for (i = (uint32) 0; (i < len) && (((size_t) i) < ((int) (4) * (int) (4))); ++i) 
    {
        byte_num = (i % ((uint32) 4));
        dest[_off_dest] = (uint8) (((rejectpad[(int) ((i / ((uint32) 4)))] >> (byte_num * ((uint32) 8))) & ((uint32) 0xff)));
        ++_off_dest;
    }
    if (((size_t) len) > ((int) (4) * (int) (4))) 
    {
        stderr.puts (@"PadRejectArray: REJECT lump too short to pad! ($(len) > $(((int) (((int) (4) * (int) (4))))))\n");
        if (M_CheckParm (c_str_to_bytes ("-reject_pad_with_ff")) != 0) 
        {
            padvalue = (uint32) 0xff;
        }
        else 
        {
            padvalue = (uint32) 0xf00;
        }
        c_memset (_c2v_slice_uint8 (array, _off_array + (int) (((int) (4) * (int) (4)))), padvalue, (((size_t) len) - ((int) (4) * (int) (4))));
    }
}

void P_LoadReject (int lumpnum) {
    int minlength = 0;
    int lumplen = 0;
    minlength = (((numsectors * numsectors) + 7) / 8);
    lumplen = W_LumpLength ((uint32) lumpnum);
    if (lumplen >= minlength) 
    {
        rejectmatrix = W_CacheLumpNum (lumpnum, (int) __anon_enum_1.PU_LEVEL);
    }
    else 
    {
        rejectmatrix = Z_Malloc (minlength, (int) __anon_enum_1.PU_LEVEL, new uint8[0]);
        W_ReadLump ((uint32) lumpnum, rejectmatrix);
        PadRejectArray (_c2v_slice_uint8 (rejectmatrix, (int) (lumplen)), (uint32) ((minlength - lumplen)));
    }
}

// c2vala-ptrs: lumpname_buf[IDX|WR]=>uint8[]
void P_SetupLevel (int episode, int map, int playermask, skill_t skill) {
    int i = 0;
    uint8[] lumpname = new uint8[9];
    int lumpnum = 0;
    wminfo.maxfrags = 0;
    totalsecret = wminfo.maxfrags;
    totalitems = totalsecret;
    totalkills = totalitems;
    wminfo.partime = 180;
    for (i = 0; i < 4; i++) 
    {
        players[(int) (i)].itemcount = 0;
        players[(int) (i)].secretcount = players[(int) (i)].itemcount;
        players[(int) (i)].killcount = players[(int) (i)].secretcount;
    }
    players[(int) (consoleplayer)].viewz = 1;
    0;
    Z_FreeTags ((int) __anon_enum_1.PU_LEVEL, (int) ((((int) __anon_enum_1.PU_PURGELEVEL) - 1)));
    P_InitThinkers ();
    if (gamemode == GameMode_t.commercial) 
    {
        if (map < 10) {
            c_snprintf_buf (lumpname, (size_t) (9), ("map0%i").printf (map));
        }
        else {
            c_snprintf_buf (lumpname, (size_t) (9), ("map%i").printf (map));
        }
    }
    else 
    {
        lumpname[(int) (0)] = (uint8) ('E');
        lumpname[(int) (1)] = (uint8) ((((int) '0') + episode));
        lumpname[(int) (2)] = (uint8) ('M');
        lumpname[(int) (3)] = (uint8) ((((int) '0') + map));
        lumpname[(int) (4)] = (uint8) 0;
    }
    lumpnum = W_GetNumForName (lumpname);
    leveltime = 0;
    P_LoadBlockMap ((lumpnum + ((int) __anon_enum_21.ML_BLOCKMAP)));
    P_LoadVertexes ((lumpnum + ((int) __anon_enum_21.ML_VERTEXES)));
    P_LoadSectors ((lumpnum + ((int) __anon_enum_21.ML_SECTORS)));
    P_LoadSideDefs ((lumpnum + ((int) __anon_enum_21.ML_SIDEDEFS)));
    P_LoadLineDefs ((lumpnum + ((int) __anon_enum_21.ML_LINEDEFS)));
    P_LoadSubsectors ((lumpnum + ((int) __anon_enum_21.ML_SSECTORS)));
    P_LoadNodes ((lumpnum + ((int) __anon_enum_21.ML_NODES)));
    P_LoadSegs ((lumpnum + ((int) __anon_enum_21.ML_SEGS)));
    P_GroupLines ();
    P_LoadReject ((lumpnum + ((int) __anon_enum_21.ML_REJECT)));
    bodyqueslot = 0;
    deathmatch_p = deathmatchstarts;
    P_LoadThings ((lumpnum + ((int) __anon_enum_21.ML_THINGS)));
    if (deathmatch != 0) 
    {
        for (i = 0; i < 4; i++) {
            if (playeringame[(int) (i)] != 0) 
            {
                players[(int) (i)].mo = null;
                G_DeathMatchSpawnPlayer (i);
            }
        }
    }
    iquetail = 0;
    iquehead = iquetail;
    P_SpawnSpecials ();
    if (precache != 0) {
        R_PrecacheLevel ();
    }
}

