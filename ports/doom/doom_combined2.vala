    player.mo.angle += (uint32) ((((int) cmd.angleturn) << 16));
    onground = (uint32) (((player.mo.z <= player.mo.floorz)) ? 1 : 0);
    if ((cmd.forwardmove != 0) && (onground != 0)) {
        P_Thrust (player, player.mo.angle, (((int) cmd.forwardmove) * 2048));
    }
    if ((cmd.sidemove != 0) && (onground != 0)) {
        P_Thrust (player, (player.mo.angle - ((uint32) 0x40000000)), (((int) cmd.sidemove) * 2048));
    }
