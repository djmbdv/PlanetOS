    {
        if (HU_Responder (ev) != 0) {
            return (uint32) 1;
        }
        if (ST_Responder (ev) != 0) {
            return (uint32) 1;
        }
        if (AM_Responder (ev) != 0) {
            return (uint32) 1;
        }
    }
    if (gamestate == gamestate_t.GS_FINALE) 
    {
        if (F_Responder (ev) != 0) {
            return (uint32) 1;
        }
    }
    if ((testcontrols != 0) && (ev.type == evtype_t.ev_mouse)) 
    {
        testcontrols_mousespeed = int.abs ((int) (ev.data2));
    }
    if ((ev.type == evtype_t.ev_keydown) && (ev.data1 == key_prevweapon)) 
    {
        next_weapon = -1;
    }
    else 
    if ((ev.type == evtype_t.ev_keydown) && (ev.data1 == key_nextweapon)) 
    {
        next_weapon = 1;
    }
    switch (ev.type) {
        case evtype_t.ev_keydown:
            if (ev.data1 == key_pause) 
            {
                sendpause = (uint32) 1;
            }
            else 
            if (ev.data1 < 256) 
            {
                gamekeydown[(int) (ev.data1)] = (uint32) 1;
            }
            return (uint32) 1;
        case evtype_t.ev_keyup:
            if (ev.data1 < 256) {
                gamekeydown[(int) (ev.data1)] = (uint32) 0;
            }
            return (uint32) 0;
        case evtype_t.ev_mouse:
            SetMouseButtons ((uint32) ev.data1);
            mousex = ((ev.data2 * (mouseSensitivity + 5)) / 10);
            mousey = ((ev.data3 * (mouseSensitivity + 5)) / 10);
            return (uint32) 1;
        case evtype_t.ev_joystick:
            SetJoyButtons ((uint32) ev.data1);
            joyxmove = ev.data2;
            joyymove = ev.data3;
            joystrafemove = ev.data4;
            return (uint32) 1;
        default:
            break;
    }
    return (uint32) 0;
}

// c2vala-ptrs: cmd_obj[DEREF|WR|ARROW]=>T? turbomessage_buf[PLAIN]=>uint8[](ro) player_names_arr[IDX]=>T[]
void G_Ticker () {
    int i = 0;
    int buf = 0;
    ticcmd_t[] cmd = new ticcmd_t[0];
    for (i = 0; i < 4; i++) {
        if ((playeringame[(int) (i)] != 0) && (players[(int) (i)].playerstate == playerstate_t.PST_REBORN)) {
            G_DoReborn (i);
        }
    }
    while (gameaction != gameaction_t.ga_nothing) 
    {
        switch (gameaction) {
            case gameaction_t.ga_loadlevel:
                G_DoLoadLevel ();
                break;
            case gameaction_t.ga_newgame:
                G_DoNewGame ();
                break;
            case gameaction_t.ga_loadgame:
                G_DoLoadGame ();
                break;
            case gameaction_t.ga_savegame:
                G_DoSaveGame ();
                break;
            case gameaction_t.ga_playdemo:
                G_DoPlayDemo ();
                break;
            case gameaction_t.ga_completed:
                G_DoCompleted ();
                break;
            case gameaction_t.ga_victory:
                F_StartFinale ();
                break;
            case gameaction_t.ga_worlddone:
                G_DoWorldDone ();
                break;
            case gameaction_t.ga_screenshot:
                V_ScreenShot (c_str_to_bytes ("DOOM%02i.%s"));
                players[(int) (consoleplayer)].message = "screen shot";
                gameaction = gameaction_t.ga_nothing;
                break;
            case gameaction_t.ga_nothing:
                break;
        }
    }
    buf = ((gametic / ticdup) % 128);
    for (i = 0; i < 4; i++) 
    {
        if (playeringame[(int) (i)] != 0) 
        {
            cmd = _c2v_box_ticcmd_t_arr (players[(int) (i)].cmd);
            cmd[0] = netcmds[(int) (i)];
            if (demoplayback != 0) {
                G_ReadDemoTiccmd (cmd);
            }
            if (demorecording != 0) {
                G_WriteDemoTiccmd (cmd);
            }
            if (((int) cmd[0].forwardmove) > 0x32) 
            {
                turbodetected[(int) (i)] = (uint32) 1;
            }
            if ((((gametic & 31) == 0) && (((gametic >> 5) % 4) == i)) && (turbodetected[(int) (i)] != 0)) 
            {
                uint8[] turbomessage = new uint8[80];
                M_snprintf (turbomessage, ((int) (80) * (int) (1)), c_str_to_bytes ("%s is turbo!"), player_names[(int) (i)]);
                players[(int) (consoleplayer)].message = (string) turbomessage;
                turbodetected[(int) (i)] = (uint32) 0;
            }
            if (((netgame != 0) && (!(netdemo != 0))) && (!((gametic % ticdup) != 0))) 
            {
                if ((gametic > 128) && (consistancy[(int) (i)][(int) (buf)] != cmd[0].consistancy)) 
                {
                    I_Error (c_str_to_bytes ("consistency failure (%i should be %i)"), cmd[0].consistancy, consistancy[(int) (i)][(int) (buf)]);
                }
                if (players[(int) (i)].mo != null) {
                    consistancy[(int) (i)][(int) (buf)] = (uint8) (players[(int) (i)].mo.x);
                }
                else {
                    consistancy[(int) (i)][(int) (buf)] = (uint8) rndindex;
                }
            }
        }
    }
    for (i = 0; i < 4; i++) 
    {
        if (playeringame[(int) (i)] != 0) 
        {
            if ((players[(int) (i)].cmd.buttons & ((int) buttoncode_t.BT_SPECIAL)) != 0) 
            {
                switch ((players[(int) (i)].cmd.buttons & ((int) buttoncode_t.BT_SPECIALMASK))) {
                    case buttoncode_t.BTS_PAUSE:
                        paused ^= (uint32) 1;
                        if (paused != 0) {
                            0;
                        }
                        else {
                            0;
                        }
                        break;
                    case buttoncode_t.BTS_SAVEGAME:
                        if (!(savedescription[(int) (0)] != 0)) 
                        {
                            M_StringCopy (savedescription, c_str_to_bytes ("NET GAME"), ((int) (32) * (int) (1)));
                        }
                        savegameslot = (int) (((players[(int) (i)].cmd.buttons & ((int) buttoncode_t.BTS_SAVEMASK)) >> ((int) buttoncode_t.BTS_SAVESHIFT)));
                        gameaction = gameaction_t.ga_savegame;
                        break;
                }
            }
        }
    }
    if ((oldgamestate == gamestate_t.GS_INTERMISSION) && (gamestate != gamestate_t.GS_INTERMISSION)) 
    {
        WI_End ();
    }
    oldgamestate = gamestate;
    switch (gamestate) {
        case gamestate_t.GS_LEVEL:
            P_Ticker ();
            ST_Ticker ();
            AM_Ticker ();
            HU_Ticker ();
            break;
        case gamestate_t.GS_INTERMISSION:
            WI_Ticker ();
            break;
        case gamestate_t.GS_FINALE:
            F_Ticker ();
            break;
        case gamestate_t.GS_DEMOSCREEN:
            D_PageTicker ();
            break;
    }
}

