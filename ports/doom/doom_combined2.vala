        an += (uint32) ((1 << 26));
        slope = P_AimLineAttack (source, an, ((16 * 64) * (1 << 16)));
        if (!(linetarget != null)) 
        {
            an -= (uint32) ((2 << 26));
            slope = P_AimLineAttack (source, an, ((16 * 64) * (1 << 16)));
        }
        if (!(linetarget != null)) 
        {
            an = source[0].angle;
            slope = 0;
        }
    }
    x = source[0].x;
    y = source[0].y;
    z = (source[0].z + ((4 * 8) * (1 << 16)));
    th = P_SpawnMobj (x, y, z, type);
    if (th[0].info.seesound != 0) {
        0;
    }
    th[0].target = _c2v_box_mobj_s_obj (source);
    th[0].angle = an;
    th[0].momx = FixedMul (th[0].info.speed, finecosine[(int) ((an >> ((uint32) 19)))]);
    th[0].momy = FixedMul (th[0].info.speed, finesine[(int) ((an >> ((uint32) 19)))]);
    th[0].momz = FixedMul (th[0].info.speed, slope);
    P_CheckMissileSpawn (th);
}

// c2vala-ptrs: plat_obj[DEREF|WR|ARROW]=>T?
void T_PlatRaise (plat_t? plat) {
    result_e res = (result_e) 0;
    var _sw_2 = plat.status;
    bool _ft_2 = false;
    do {
        if (_ft_2 || _sw_2 == plat_e.up) {
            _ft_2 = true;
            res = T_MovePlane (plat.sector, plat.speed, plat.high, plat.crush, 0, 1);
            if ((plat.type == plattype_e.raiseAndChange) || (plat.type == plattype_e.raiseToNearestAndChange)) 
            {
                if (!((leveltime & 7) != 0)) {
                    0;
                }
            }
            if ((res == result_e.crushed) && (!(plat.crush != 0))) 
            {
                plat.count = plat.wait;
                plat.status = plat_e.down;
                0;
            }
            else 
            {
                if (res == result_e.pastdest) 
                {
                    plat.count = plat.wait;
                    plat.status = plat_e.waiting;
                    0;
                    switch (plat.type) {
                        case plattype_e.blazeDWUS:
                        case plattype_e.downWaitUpStay:
                            P_RemoveActivePlat (plat);
                            break;
                        case plattype_e.raiseAndChange:
                        case plattype_e.raiseToNearestAndChange:
                            P_RemoveActivePlat (plat);
                            break;
                        default:
                            break;
                    }
                }
            }
            break;
        }
        if (_ft_2 || _sw_2 == plat_e.down) {
            _ft_2 = true;
            res = T_MovePlane (plat.sector, plat.speed, plat.low, (uint32) 0, 0, -1);
            if (res == result_e.pastdest) 
            {
                plat.count = plat.wait;
                plat.status = plat_e.waiting;
                0;
            }
            break;
        }
        if (_ft_2 || _sw_2 == plat_e.waiting) {
            _ft_2 = true;
            if (!(--plat.count != 0)) 
            {
                if (plat.sector.floorheight == plat.low) {
                    plat.status = plat_e.up;
                }
                else {
                    plat.status = plat_e.down;
                }
                0;
            }
        }
        if (_ft_2 || _sw_2 == plat_e.in_stasis) {
            _ft_2 = true;
            break;
        }
    } while (false);
}

// c2vala-ptrs: line_obj[DEREF|ARROW]=>T? plat_obj[DEREF|WR|ARROW]=>T? sec_obj[DEREF|WR|ARROW]=>T?
int EV_DoPlat (line_s[] line, plattype_e type, int amount) {
    plat_t? plat = null;
    int secnum = 0;
    int rtn = 0;
    sector_t[] sec = new sector_t[0];
    secnum = -1;
    rtn = 0;
    switch (type) {
        case plattype_e.perpetualRaise:
            P_ActivateInStasis ((int) (line[0].tag));
            break;
        default:
            break;
    }
    while (c_assign_i (P_FindSectorFromLineTag (line, secnum), ref secnum) >= 0) 
    {
        sec = _c2v_slice_sector_t (sectors, (int) (secnum));
        if (sec[0].specialdata != null) {
            continue;
        }
        rtn = 1;
        plat = new plat_t.at (Z_Malloc ((int) 88, (int) __anon_enum_1.PU_LEVSPEC, new uint8[0]), 0);
        P_AddThinker (plat.thinker);
        plat.type = type;
        plat.sector = _c2v_box_sector_t_obj (sec);
        plat.sector.specialdata = plat;
        plat.thinker.tag = 5;
        plat.thinker.owner = plat;
        plat.crush = (uint32) 0;
        plat.tag = (int) (line[0].tag);
        switch (type) {
            case plattype_e.raiseToNearestAndChange:
                plat.speed = ((1 << 16) / 2);
                sec[0].floorpic = sides[(int) (line[0].sidenum[(int) (0)])].sector.floorpic;
                plat.high = P_FindNextHighestFloor (sec, sec[0].floorheight);
                plat.wait = 0;
                plat.status = plat_e.up;
                sec[0].special = (int16) 0;
                0;
                break;
            case plattype_e.raiseAndChange:
                plat.speed = ((1 << 16) / 2);
                sec[0].floorpic = sides[(int) (line[0].sidenum[(int) (0)])].sector.floorpic;
                plat.high = (sec[0].floorheight + (amount * (1 << 16)));
                plat.wait = 0;
                plat.status = plat_e.up;
                0;
                break;
            case plattype_e.downWaitUpStay:
                plat.speed = ((1 << 16) * 4);
                plat.low = P_FindLowestFloorSurrounding (sec);
                if (plat.low > sec[0].floorheight) {
                    plat.low = sec[0].floorheight;
                }
                plat.high = sec[0].floorheight;
                plat.wait = (35 * 3);
                plat.status = plat_e.down;
                0;
                break;
            case plattype_e.blazeDWUS:
                plat.speed = ((1 << 16) * 8);
                plat.low = P_FindLowestFloorSurrounding (sec);
                if (plat.low > sec[0].floorheight) {
                    plat.low = sec[0].floorheight;
                }
                plat.high = sec[0].floorheight;
                plat.wait = (35 * 3);
                plat.status = plat_e.down;
                0;
                break;
            case plattype_e.perpetualRaise:
                plat.speed = (1 << 16);
                plat.low = P_FindLowestFloorSurrounding (sec);
                if (plat.low > sec[0].floorheight) {
                    plat.low = sec[0].floorheight;
                }
                plat.high = P_FindHighestFloorSurrounding (sec);
                if (plat.high < sec[0].floorheight) {
                    plat.high = sec[0].floorheight;
                }
                plat.wait = (35 * 3);
                plat.status = (plat_e) ((P_Random () & 1));
                0;
                break;
        }
        P_AddActivePlat (plat);
    }
    return rtn;
}

void P_ActivateInStasis (int tag) {
    int i = 0;
    for (i = 0; i < 30; i++) {
        if (((activeplats[(int) (i)] != null) && (activeplats[(int) (i)].tag == tag)) && (activeplats[(int) (i)].status == plat_e.in_stasis)) 
        {
            activeplats[(int) (i)].status = activeplats[(int) (i)].oldstatus;
            activeplats[(int) (i)].thinker.tag = 5;
            activeplats[(int) (i)].thinker.owner = activeplats[(int) (i)];
        }
    }
}

// c2vala-ptrs: line_obj[DEREF|ARROW]=>T?
void EV_StopPlat (line_s[] line) {
    int j = 0;
    for (j = 0; j < 30; j++) {
        if (((activeplats[(int) (j)] != null) && (activeplats[(int) (j)].status != plat_e.in_stasis)) && (activeplats[(int) (j)].tag == ((int) line[0].tag))) 
        {
            activeplats[(int) (j)].oldstatus = activeplats[(int) (j)].status;
            activeplats[(int) (j)].status = plat_e.in_stasis;
            activeplats[(int) (j)].thinker.function.acv = null;
        }
    }
}

// c2vala-ptrs: plat_obj[PLAIN]=>T?
void P_AddActivePlat (plat_t? plat) {
    int i = 0;
    for (i = 0; i < 30; i++) {
        if (activeplats[(int) (i)] == null) 
        {
            activeplats[(int) (i)] = plat;
            return;
        }
    }
    I_Error (c_str_to_bytes ("P_AddActivePlat: no more plats!"));
}

// c2vala-ptrs: plat_obj[NULL]=>T?
void P_RemoveActivePlat (plat_t? plat) {
    int i = 0;
    for (i = 0; i < 30; i++) {
        if (plat == activeplats[(int) (i)]) 
        {
            activeplats[(int) (i)].sector.specialdata = null;
            P_RemoveThinker (activeplats[(int) (i)].thinker);
            activeplats[(int) (i)] = null;
            return;
        }
    }
    I_Error (c_str_to_bytes ("P_RemoveActivePlat: can't find plat!"));
}

