            break;
        }
        if (_ft_1 || _sw_1 == ammotype_t.am_shell) {
            _ft_1 = true;
            if ((player.readyweapon == weapontype_t.wp_fist) || (player.readyweapon == weapontype_t.wp_pistol)) 
            {
                if (player.weaponowned[(int) (weapontype_t.wp_shotgun)] != 0) {
                    player.pendingweapon = weapontype_t.wp_shotgun;
                }
            }
            break;
        }
        if (_ft_1 || _sw_1 == ammotype_t.am_cell) {
            _ft_1 = true;
            if ((player.readyweapon == weapontype_t.wp_fist) || (player.readyweapon == weapontype_t.wp_pistol)) 
            {
                if (player.weaponowned[(int) (weapontype_t.wp_plasma)] != 0) {
                    player.pendingweapon = weapontype_t.wp_plasma;
                }
            }
            break;
        }
        if (_ft_1 || _sw_1 == ammotype_t.am_misl) {
            _ft_1 = true;
            if (player.readyweapon == weapontype_t.wp_fist) 
            {
                if (player.weaponowned[(int) (weapontype_t.wp_missile)] != 0) {
                    player.pendingweapon = weapontype_t.wp_missile;
                }
            }
        }
        if (_ft_1 || (_sw_1 != ammotype_t.am_clip && _sw_1 != ammotype_t.am_shell && _sw_1 != ammotype_t.am_cell && _sw_1 != ammotype_t.am_misl)) {
            _ft_1 = true;
            break;
        }
    } while (false);
    return (uint32) 1;
}

// c2vala-ptrs: player_obj[DEREF|WR|NULL|ARROW]=>T?
uint32 P_GiveWeapon (player_s? player, weapontype_t weapon, uint32 dropped) {
    uint32 gaveammo = 0;
    uint32 gaveweapon = 0;
    if (((netgame != 0) && (deathmatch != 2)) && (!(dropped != 0))) 
    {
        if (player.weaponowned[(int) (weapon)] != 0) {
            return (uint32) 0;
        }
        player.bonuscount += 6;
        player.weaponowned[(int) (weapon)] = (uint32) 1;
        if (deathmatch != 0) {
            P_GiveAmmo (player, weaponinfo[(int) (weapon)].ammo, 5);
        }
        else {
            P_GiveAmmo (player, weaponinfo[(int) (weapon)].ammo, 2);
        }
        player.pendingweapon = weapon;
        if (player == players[(int) (consoleplayer)]) {
            0;
        }
        return (uint32) 0;
    }
    if (weaponinfo[(int) (weapon)].ammo != ammotype_t.am_noammo) 
    {
        if (dropped != 0) {
            gaveammo = P_GiveAmmo (player, weaponinfo[(int) (weapon)].ammo, 1);
        }
        else {
            gaveammo = P_GiveAmmo (player, weaponinfo[(int) (weapon)].ammo, 2);
        }
    }
    else 
    {
        gaveammo = (uint32) 0;
    }
    if (player.weaponowned[(int) (weapon)] != 0) 
    {
        gaveweapon = (uint32) 0;
    }
    else 
    {
        gaveweapon = (uint32) 1;
        player.weaponowned[(int) (weapon)] = (uint32) 1;
        player.pendingweapon = weapon;
    }
    return (uint32) ((((gaveweapon != 0) || (gaveammo != 0))) ? 1 : 0);
}

// c2vala-ptrs: player_obj[DEREF|WR|ARROW]=>T?
uint32 P_GiveBody (player_s? player, int num) {
    if (player.health >= 100) {
        return (uint32) 0;
    }
    player.health += num;
    if (player.health > 100) {
        player.health = 100;
    }
    player.mo.health = player.health;
    return (uint32) 1;
}

// c2vala-ptrs: player_obj[DEREF|WR|ARROW]=>T?
uint32 P_GiveArmor (player_s? player, int armortype) {
    int hits = 0;
    hits = (armortype * 100);
    if (player.armorpoints >= hits) {
        return (uint32) 0;
    }
    player.armortype = armortype;
    player.armorpoints = hits;
    return (uint32) 1;
}

// c2vala-ptrs: player_obj[DEREF|WR|ARROW]=>T?
void P_GiveCard (player_s? player, card_t card) {
    if (player.cards[(int) (card)] != 0) {
        return;
    }
    player.bonuscount = 6;
    player.cards[(int) (card)] = (uint32) 1;
}

// c2vala-ptrs: player_obj[DEREF|ARROW]=>T?
uint32 P_GivePower (player_s? player, int power) {
    if (power == ((int) powertype_t.pw_invulnerability)) 
    {
        player.powers[(int) (power)] = (int) powerduration_t.INVULNTICS;
        return (uint32) 1;
    }
    if (power == ((int) powertype_t.pw_invisibility)) 
    {
        player.powers[(int) (power)] = (int) powerduration_t.INVISTICS;
        player.mo.flags |= (int) mobjflag_t.MF_SHADOW;
        return (uint32) 1;
    }
    if (power == ((int) powertype_t.pw_infrared)) 
    {
        player.powers[(int) (power)] = (int) powerduration_t.INFRATICS;
        return (uint32) 1;
    }
    if (power == ((int) powertype_t.pw_ironfeet)) 
    {
        player.powers[(int) (power)] = (int) powerduration_t.IRONTICS;
        return (uint32) 1;
    }
    if (power == ((int) powertype_t.pw_strength)) 
    {
        P_GiveBody (player, 100);
        player.powers[(int) (power)] = 1;
        return (uint32) 1;
    }
    if (player.powers[(int) (power)] != 0) {
        return (uint32) 0;
    }
    player.powers[(int) (power)] = 1;
    return (uint32) 1;
}

// c2vala-ptrs: special_obj[DEREF|ARROW]=>T? toucher_obj[DEREF|ARROW]=>T? player_obj[DEREF|WR|NULL|ARROW]=>T?
void P_TouchSpecialThing (mobj_s[] special, mobj_s? toucher) {
    player_s? player = null;
    int i = 0;
    int delta = 0;
    int sound = 0;
    delta = (special[0].z - toucher.z);
    if ((delta > toucher.height) || (delta < (-8 * (1 << 16)))) 
    {
        return;
    }
    sound = (int) sfxenum_t.sfx_itemup;
    player = toucher.player;
    if (toucher.health <= 0) {
        return;
    }
    switch (special[0].sprite) {
        case spritenum_t.SPR_ARM1:
            if (!(P_GiveArmor (player, 1) != 0)) {
                return;
            }
            player.message = "Picked up the armor.";
            break;
        case spritenum_t.SPR_ARM2:
            if (!(P_GiveArmor (player, 2) != 0)) {
                return;
            }
            player.message = "Picked up the MegaArmor!";
            break;
        case spritenum_t.SPR_BON1:
            player.health++;
            if (player.health > 200) {
                player.health = 200;
            }
            player.mo.health = player.health;
            player.message = "Picked up a health bonus.";
            break;
        case spritenum_t.SPR_BON2:
            player.armorpoints++;
            if (player.armorpoints > 200) {
                player.armorpoints = 200;
            }
            if (!(player.armortype != 0)) {
                player.armortype = 1;
            }
            player.message = "Picked up an armor bonus.";
            break;
        case spritenum_t.SPR_SOUL:
            player.health += 100;
            if (player.health > 200) {
                player.health = 200;
            }
            player.mo.health = player.health;
            player.message = "Supercharge!";
            sound = (int) sfxenum_t.sfx_getpow;
            break;
        case spritenum_t.SPR_MEGA:
            if (gamemode != GameMode_t.commercial) {
                return;
            }
            player.health = 200;
            player.mo.health = player.health;
            P_GiveArmor (player, 2);
            player.message = "MegaSphere!";
            sound = (int) sfxenum_t.sfx_getpow;
            break;
        case spritenum_t.SPR_BKEY:
            if (!(player.cards[(int) (card_t.it_bluecard)] != 0)) {
                player.message = "Picked up a blue keycard.";
            }
            P_GiveCard (player, card_t.it_bluecard);
            if (!(netgame != 0)) {
                break;
            }
            return;
        case spritenum_t.SPR_YKEY:
            if (!(player.cards[(int) (card_t.it_yellowcard)] != 0)) {
                player.message = "Picked up a yellow keycard.";
            }
            P_GiveCard (player, card_t.it_yellowcard);
            if (!(netgame != 0)) {
                break;
            }
            return;
        case spritenum_t.SPR_RKEY:
            if (!(player.cards[(int) (card_t.it_redcard)] != 0)) {
                player.message = "Picked up a red keycard.";
            }
            P_GiveCard (player, card_t.it_redcard);
            if (!(netgame != 0)) {
                break;
            }
            return;
        case spritenum_t.SPR_BSKU:
            if (!(player.cards[(int) (card_t.it_blueskull)] != 0)) {
                player.message = "Picked up a blue skull key.";
            }
            P_GiveCard (player, card_t.it_blueskull);
            if (!(netgame != 0)) {
                break;
            }
            return;
        case spritenum_t.SPR_YSKU:
            if (!(player.cards[(int) (card_t.it_yellowskull)] != 0)) {
                player.message = "Picked up a yellow skull key.";
            }
            P_GiveCard (player, card_t.it_yellowskull);
            if (!(netgame != 0)) {
                break;
            }
            return;
        case spritenum_t.SPR_RSKU:
            if (!(player.cards[(int) (card_t.it_redskull)] != 0)) {
                player.message = "Picked up a red skull key.";
            }
            P_GiveCard (player, card_t.it_redskull);
            if (!(netgame != 0)) {
                break;
            }
            return;
        case spritenum_t.SPR_STIM:
            if (!(P_GiveBody (player, 10) != 0)) {
                return;
            }
            player.message = "Picked up a stimpack.";
            break;
        case spritenum_t.SPR_MEDI:
            if (!(P_GiveBody (player, 25) != 0)) {
                return;
            }
            if (player.health < 25) {
                player.message = "Picked up a medikit that you REALLY need!";
            }
            else {
                player.message = "Picked up a medikit.";
            }
            break;
        case spritenum_t.SPR_PINV:
            if (!(P_GivePower (player, (int) powertype_t.pw_invulnerability) != 0)) {
                return;
            }
            player.message = "Invulnerability!";
            sound = (int) sfxenum_t.sfx_getpow;
            break;
        case spritenum_t.SPR_PSTR:
            if (!(P_GivePower (player, (int) powertype_t.pw_strength) != 0)) {
                return;
            }
            player.message = "Berserk!";
            if (player.readyweapon != weapontype_t.wp_fist) {
                player.pendingweapon = weapontype_t.wp_fist;
            }
            sound = (int) sfxenum_t.sfx_getpow;
            break;
        case spritenum_t.SPR_PINS:
            if (!(P_GivePower (player, (int) powertype_t.pw_invisibility) != 0)) {
                return;
            }
            player.message = "Partial Invisibility";
            sound = (int) sfxenum_t.sfx_getpow;
            break;
        case spritenum_t.SPR_SUIT:
            if (!(P_GivePower (player, (int) powertype_t.pw_ironfeet) != 0)) {
                return;
            }
            player.message = "Radiation Shielding Suit";
            sound = (int) sfxenum_t.sfx_getpow;
            break;
        case spritenum_t.SPR_PMAP:
            if (!(P_GivePower (player, (int) powertype_t.pw_allmap) != 0)) {
                return;
            }
            player.message = "Computer Area Map";
            sound = (int) sfxenum_t.sfx_getpow;
            break;
        case spritenum_t.SPR_PVIS:
            if (!(P_GivePower (player, (int) powertype_t.pw_infrared) != 0)) {
                return;
            }
            player.message = "Light Amplification Visor";
            sound = (int) sfxenum_t.sfx_getpow;
            break;
        case spritenum_t.SPR_CLIP:
            if ((special[0].flags & ((int) mobjflag_t.MF_DROPPED)) != 0) 
            {
                if (!(P_GiveAmmo (player, ammotype_t.am_clip, 0) != 0)) {
                    return;
                }
            }
            else 
            {
                if (!(P_GiveAmmo (player, ammotype_t.am_clip, 1) != 0)) {
                    return;
                }
            }
            player.message = "Picked up a clip.";
            break;
        case spritenum_t.SPR_AMMO:
            if (!(P_GiveAmmo (player, ammotype_t.am_clip, 5) != 0)) {
                return;
            }
            player.message = "Picked up a box of bullets.";
            break;
        case spritenum_t.SPR_ROCK:
            if (!(P_GiveAmmo (player, ammotype_t.am_misl, 1) != 0)) {
                return;
            }
            player.message = "Picked up a rocket.";
            break;
        case spritenum_t.SPR_BROK:
            if (!(P_GiveAmmo (player, ammotype_t.am_misl, 5) != 0)) {
                return;
            }
            player.message = "Picked up a box of rockets.";
            break;
        case spritenum_t.SPR_CELL:
            if (!(P_GiveAmmo (player, ammotype_t.am_cell, 1) != 0)) {
                return;
            }
            player.message = "Picked up an energy cell.";
            break;
        case spritenum_t.SPR_CELP:
            if (!(P_GiveAmmo (player, ammotype_t.am_cell, 5) != 0)) {
                return;
            }
            player.message = "Picked up an energy cell pack.";
            break;
        case spritenum_t.SPR_SHEL:
            if (!(P_GiveAmmo (player, ammotype_t.am_shell, 1) != 0)) {
                return;
            }
            player.message = "Picked up 4 shotgun shells.";
            break;
        case spritenum_t.SPR_SBOX:
            if (!(P_GiveAmmo (player, ammotype_t.am_shell, 5) != 0)) {
                return;
            }
            player.message = "Picked up a box of shotgun shells.";
            break;
        case spritenum_t.SPR_BPAK:
            if (!(player.backpack != 0)) 
            {
                for (i = 0; i < ((int) ammotype_t.NUMAMMO); i++) {
                    player.maxammo[(int) (i)] *= 2;
                }
                player.backpack = (uint32) 1;
            }
            for (i = 0; i < ((int) ammotype_t.NUMAMMO); i++) {
                P_GiveAmmo (player, (ammotype_t) i, 1);
            }
            player.message = "Picked up a backpack full of ammo!";
            break;
        case spritenum_t.SPR_BFUG:
            if (!(P_GiveWeapon (player, weapontype_t.wp_bfg, (uint32) 0) != 0)) {
                return;
            }
            player.message = "You got the BFG9000!  Oh, yes.";
            sound = (int) sfxenum_t.sfx_wpnup;
            break;
        case spritenum_t.SPR_MGUN:
            if (!(P_GiveWeapon (player, weapontype_t.wp_chaingun, (uint32) ((((special[0].flags & ((int) mobjflag_t.MF_DROPPED)) != 0)) ? 1 : 0)) != 0)) {
                return;
            }
            player.message = "You got the chaingun!";
            sound = (int) sfxenum_t.sfx_wpnup;
            break;
        case spritenum_t.SPR_CSAW:
            if (!(P_GiveWeapon (player, weapontype_t.wp_chainsaw, (uint32) 0) != 0)) {
                return;
            }
            player.message = "A chainsaw!  Find some meat!";
            sound = (int) sfxenum_t.sfx_wpnup;
            break;
        case spritenum_t.SPR_LAUN:
            if (!(P_GiveWeapon (player, weapontype_t.wp_missile, (uint32) 0) != 0)) {
                return;
            }
            player.message = "You got the rocket launcher!";
            sound = (int) sfxenum_t.sfx_wpnup;
            break;
        case spritenum_t.SPR_PLAS:
            if (!(P_GiveWeapon (player, weapontype_t.wp_plasma, (uint32) 0) != 0)) {
                return;
            }
            player.message = "You got the plasma gun!";
            sound = (int) sfxenum_t.sfx_wpnup;
            break;
        case spritenum_t.SPR_SHOT:
            if (!(P_GiveWeapon (player, weapontype_t.wp_shotgun, (uint32) ((((special[0].flags & ((int) mobjflag_t.MF_DROPPED)) != 0)) ? 1 : 0)) != 0)) {
                return;
            }
            player.message = "You got the shotgun!";
            sound = (int) sfxenum_t.sfx_wpnup;
            break;
        case spritenum_t.SPR_SGN2:
            if (!(P_GiveWeapon (player, weapontype_t.wp_supershotgun, (uint32) ((((special[0].flags & ((int) mobjflag_t.MF_DROPPED)) != 0)) ? 1 : 0)) != 0)) {
                return;
            }
            player.message = "You got the super shotgun!";
            sound = (int) sfxenum_t.sfx_wpnup;
            break;
        default:
            I_Error (c_str_to_bytes ("P_SpecialThing: Unknown gettable thing"));
            break;
    }
    if ((special[0].flags & ((int) mobjflag_t.MF_COUNTITEM)) != 0) {
        player.itemcount++;
    }
    P_RemoveMobj (special);
    player.bonuscount += 6;
    if (player == players[(int) (consoleplayer)]) {
        0;
    }
}

// c2vala-ptrs: source_obj[DEREF|NULL|ARROW]=>T? target_obj[DEREF|WR|ARROW]=>T? mo_obj[DEREF|WR|ARROW]=>T?
void P_KillMobj (mobj_s[]? source, mobj_s[] target) {
    mobjtype_t item = (mobjtype_t) 0;
    mobj_s[] mo = new mobj_s[0];
    target[0].flags &= (int) ((~(int) (((mobjflag_t.MF_SHOOTABLE | mobjflag_t.MF_FLOAT) | mobjflag_t.MF_SKULLFLY))));
    if (target[0].type != mobjtype_t.MT_SKULL) {
        target[0].flags &= (int) ((~(int) (mobjflag_t.MF_NOGRAVITY)));
    }
    target[0].flags |= (int) ((mobjflag_t.MF_CORPSE | mobjflag_t.MF_DROPOFF));
    target[0].height >>= 2;
    if ((source != null) && (source[0].player != null)) 
    {
        if ((target[0].flags & ((int) mobjflag_t.MF_COUNTKILL)) != 0) {
            source[0].player.killcount++;
        }
        if (target[0].player != null) 
        {
            int pnum = 0;
            int k = 0;
            for (k = 0; k < 4; k++) {
                if (players[(int) (k)] == target[0].player) {
                    pnum = k;
                }
            }
            source[0].player.frags[(int) (pnum)]++;
        }
    }
    else 
    if ((!(netgame != 0)) && ((target[0].flags & ((int) mobjflag_t.MF_COUNTKILL)) != 0)) 
    {
        players[(int) (0)].killcount++;
    }
    if (target[0].player != null) 
    {
        if (!(source != null)) 
        {
            int pnum = 0;
            int k = 0;
            for (k = 0; k < 4; k++) {
                if (players[(int) (k)] == target[0].player) {
                    pnum = k;
                }
            }
            target[0].player.frags[(int) (pnum)]++;
        }
        target[0].flags &= (int) ((~(int) (mobjflag_t.MF_SOLID)));
        target[0].player.playerstate = playerstate_t.PST_DEAD;
        P_DropWeapon (target[0].player);
        if ((target[0].player == players[(int) (consoleplayer)]) && (automapactive != 0)) 
        {
            AM_Stop ();
        }
    }
    if ((target[0].health < -target[0].info.spawnhealth) && (target[0].info.xdeathstate != 0)) 
    {
        P_SetMobjState (target, (statenum_t) (target[0].info.xdeathstate));
    }
    else {
        P_SetMobjState (target, (statenum_t) (target[0].info.deathstate));
    }
    target[0].tics -= (P_Random () & 3);
    if (target[0].tics < 1) {
        target[0].tics = 1;
    }
    if (gameversion == GameVersion_t.exe_chex) 
    {
        return;
    }
    switch (target[0].type) {
        case mobjtype_t.MT_WOLFSS:
        case mobjtype_t.MT_POSSESSED:
            item = mobjtype_t.MT_CLIP;
            break;
        case mobjtype_t.MT_SHOTGUY:
            item = mobjtype_t.MT_SHOTGUN;
            break;
        case mobjtype_t.MT_CHAINGUY:
            item = mobjtype_t.MT_CHAINGUN;
            break;
        default:
            return;
    }
    mo = P_SpawnMobj (target[0].x, target[0].y, (-2147483647 - 1), item);
    mo[0].flags |= (int) mobjflag_t.MF_DROPPED;
}

// c2vala-ptrs: target_obj[DEREF|WR|ARROW]=>T? inflictor_obj[DEREF|ARROW]=>T? source_obj[DEREF|NULL|ARROW]=>T? player_obj[DEREF|WR|NULL|ARROW]=>T?
void P_DamageMobj (mobj_s[]? target, mobj_s[]? inflictor, mobj_s[]? source, int damage) {
    uint32 ang = 0;
    int saved = 0;
    player_s? player = null;
    int thrust = 0;
    int temp = 0;
    if (!((target[0].flags & ((int) mobjflag_t.MF_SHOOTABLE)) != 0)) {
        return;
    }
    if (target[0].health <= 0) {
        return;
    }
    if ((target[0].flags & ((int) mobjflag_t.MF_SKULLFLY)) != 0) 
    {
        target[0].momz = 0;
        target[0].momy = target[0].momz;
        target[0].momx = target[0].momy;
    }
    player = target[0].player;
    if ((player != null) && (gameskill == skill_t.sk_baby)) {
        damage >>= 1;
    }
    if (((inflictor != null) && (!((target[0].flags & ((int) mobjflag_t.MF_NOCLIP)) != 0))) && (((!(source != null)) || (!(source[0].player != null))) || (source[0].player.readyweapon != weapontype_t.wp_chainsaw))) 
    {
        ang = R_PointToAngle2 (inflictor[0].x, inflictor[0].y, target[0].x, target[0].y);
        thrust = (((damage * ((1 << 16) >> 3)) * 100) / target[0].info.mass);
        if ((((damage < 40) && (damage > target[0].health)) && ((target[0].z - inflictor[0].z) > (64 * (1 << 16)))) && ((P_Random () & 1) != 0)) 
        {
            ang += (uint32) 0x80000000;
            thrust *= 4;
        }
        ang >>= (uint32) 19;
        target[0].momx += FixedMul (thrust, finecosine[(int) (ang)]);
        target[0].momy += FixedMul (thrust, finesine[(int) (ang)]);
    }
    if (player != null) 
    {
        if ((((int) target[0].subsector.sector.special) == 11) && (damage >= target[0].health)) 
        {
            damage = (target[0].health - 1);
        }
        if ((damage < 1000) && (((player.cheats & ((int) cheat_t.CF_GODMODE)) != 0) || (player.powers[(int) (powertype_t.pw_invulnerability)] != 0))) 
        {
            return;
        }
        if (player.armortype != 0) 
        {
            if (player.armortype == 1) {
                saved = (damage / 3);
            }
            else {
                saved = (damage / 2);
            }
            if (player.armorpoints <= saved) 
            {
                saved = player.armorpoints;
                player.armortype = 0;
            }
            player.armorpoints -= saved;
            damage -= saved;
        }
        player.health -= damage;
        if (player.health < 0) {
            player.health = 0;
        }
        player.attacker = (source != null) ? _c2v_box_mobj_s_obj ((!) source) : null;
        player.damagecount += damage;
        if (player.damagecount > 100) {
            player.damagecount = 100;
        }
        temp = ((damage < 100) ? damage : 100);
