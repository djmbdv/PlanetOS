                    return 0;
                }
                if (gameversion != GameVersion_t.exe_final) {
                    thing[0].z = thing[0].floorz;
                }
                if (thing[0].player != null) {
                    thing[0].player.viewz = (thing[0].z + thing[0].player.viewheight);
                }
                fog = P_SpawnMobj (oldx, oldy, oldz, mobjtype_t.MT_TFOG);
                0;
                an = (m.angle >> ((uint32) 19));
                fog = P_SpawnMobj ((m.x + (20 * finecosine[(int) (an)])), (m.y + (20 * finesine[(int) (an)])), thing[0].z, mobjtype_t.MT_TFOG);
                0;
                if (thing[0].player != null) {
                    thing[0].reactiontime = 18;
                }
                thing[0].angle = m.angle;
                thing[0].momz = 0;
                thing[0].momy = thing[0].momz;
                thing[0].momx = thing[0].momy;
                return 1;
            }
        }
    }
    return 0;
}

void P_InitThinkers () {
    thinkercap.next = thinkercap;
    thinkercap.prev = thinkercap.next;
}

// c2vala-ptrs: thinker_obj[DEREF|WR|ARROW]=>T?
void P_AddThinker (thinker_s? thinker) {
    thinkercap.prev.next = thinker;
    thinker.next = thinkercap;
    thinker.prev = thinkercap.prev;
    thinkercap.prev = thinker;
}

// c2vala-ptrs: thinker_obj[DEREF|WR|ARROW]=>T?
void P_RemoveThinker (thinker_s? thinker) {
    thinker.tag = -1;
}

// c2vala-ptrs: thinker_obj[PLAIN]=>T?
void P_AllocateThinker (thinker_s? thinker) {
}

// c2vala-ptrs: currentthinker_obj[DEREF|NULL|ARROW]=>T?
void P_RunThinkers () {
    thinker_s? currentthinker = null;
    currentthinker = thinkercap.next;
    while (currentthinker != null && (Object) currentthinker != (Object) thinkercap) 
    {
        if (currentthinker.tag == -1) 
        {
            currentthinker.next.prev = currentthinker.prev;
            currentthinker.prev.next = currentthinker.next;
        }
        else 
        {
            switch (currentthinker.tag) {
                case 1:
                    P_MobjThinker ((!) currentthinker.owner_mobj);
                    break;
                case 2:
                    T_MoveCeiling ((ceiling_t) ((!) currentthinker.owner));
                    break;
                case 3:
                    T_VerticalDoor ((vldoor_t) ((!) currentthinker.owner));
                    break;
                case 4:
                    T_MoveFloor ((floormove_t) ((!) currentthinker.owner));
                    break;
                case 5:
                    T_PlatRaise ((plat_t) ((!) currentthinker.owner));
                    break;
                case 6:
                    T_LightFlash ((lightflash_t) ((!) currentthinker.owner));
                    break;
                case 7:
                    T_StrobeFlash ((strobe_t) ((!) currentthinker.owner));
                    break;
                case 8:
                    T_Glow ((glow_t) ((!) currentthinker.owner));
                    break;
                case 9:
                    T_FireFlicker ((fireflicker_t) ((!) currentthinker.owner));
                    break;
            }
        }
        currentthinker = currentthinker.next;
    }
}

void P_Ticker () {
    int i = 0;
    if (paused != 0) {
        return;
    }
    if ((((!(netgame != 0)) && (menuactive != 0)) && (!(demoplayback != 0))) && (players[(int) (consoleplayer)].viewz != 1)) 
    {
        return;
    }
    for (i = 0; i < 4; i++) {
        if (playeringame[(int) (i)] != 0) {
            P_PlayerThink (_c2v_box_player_s_obj (_c2v_slice_player_s (players, (int) (i))));
        }
    }
    P_RunThinkers ();
    P_UpdateSpecials ();
    P_RespawnSpecials ();
    leveltime++;
}

