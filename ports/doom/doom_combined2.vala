uint32 CheckBossEnd (mobjtype_t motype) {
    if (gameversion < GameVersion_t.exe_ultimate) 
    {
        if (gamemap != 8) 
        {
            return (uint32) 0;
        }
        if ((motype == mobjtype_t.MT_BRUISER) && (gameepisode != 1)) 
        {
            return (uint32) 0;
        }
        return (uint32) 1;
    }
    else 
    {
        switch (gameepisode) {
            case 1:
                return (uint32) ((((gamemap == 8) && (motype == mobjtype_t.MT_BRUISER))) ? 1 : 0);
            case 2:
                return (uint32) ((((gamemap == 8) && (motype == mobjtype_t.MT_CYBORG))) ? 1 : 0);
            case 3:
                return (uint32) ((((gamemap == 8) && (motype == mobjtype_t.MT_SPIDER))) ? 1 : 0);
            case 4:
                return (uint32) (((((gamemap == 6) && (motype == mobjtype_t.MT_CYBORG)) || ((gamemap == 8) && (motype == mobjtype_t.MT_SPIDER)))) ? 1 : 0);
            default:
                return (uint32) (((gamemap == 8)) ? 1 : 0);
        }
    }
}

// c2vala-ptrs: mo_obj[DEREF|ARROW]=>T? th_ptr[DEREF|CAST|NULL|ARROW->mobj_s]=>mobj_s.at mo2_obj[DEREF|NULL|ARROW]=>T?
void A_BossDeath (mobj_s? mo) {
    thinker_s? th = null;
    mobj_s? mo2 = null;
    line_s junk = new line_s ();
    int i = 0;
    if (gamemode == GameMode_t.commercial) 
    {
        if (gamemap != 7) {
            return;
        }
        if ((mo.type != mobjtype_t.MT_FATSO) && (mo.type != mobjtype_t.MT_BABY)) {
            return;
        }
    }
    else 
    {
        if (!(CheckBossEnd (mo.type) != 0)) 
        {
            return;
        }
    }
    for (i = 0; i < 4; i++) {
        if ((playeringame[(int) (i)] != 0) && (players[(int) (i)].health > 0)) {
            break;
        }
    }
    if (i == 4) {
        return;
    }
    for (th = thinkercap.next; th != thinkercap; th = th.next) 
    {
        if (th.tag != 1) {
            continue;
        }
        mo2 = ((mobj_s?) th);
        if (((mo2 != mo) && (mo2.type == mo.type)) && (mo2.health > 0)) 
        {
            return;
        }
    }
    if (gamemode == GameMode_t.commercial) 
    {
        if (gamemap == 7) 
        {
            if (mo.type == mobjtype_t.MT_FATSO) 
            {
                junk.tag = (int16) 666;
                EV_DoFloor (_c2v_box_line_s_arr (junk), floor_e.lowerFloorToLowest);
                return;
            }
            if (mo.type == mobjtype_t.MT_BABY) 
            {
                junk.tag = (int16) 667;
                EV_DoFloor (_c2v_box_line_s_arr (junk), floor_e.raiseToTexture);
                return;
            }
        }
    }
    else 
    {
        switch (gameepisode) {
            case 1:
                junk.tag = (int16) 666;
                EV_DoFloor (_c2v_box_line_s_arr (junk), floor_e.lowerFloorToLowest);
                return;
                break;
            case 4:
                switch (gamemap) {
                    case 6:
                        junk.tag = (int16) 666;
                        EV_DoDoor (_c2v_box_line_s_arr (junk), vldoor_e.vld_blazeOpen);
                        return;
                        break;
                    case 8:
                        junk.tag = (int16) 666;
                        EV_DoFloor (_c2v_box_line_s_arr (junk), floor_e.lowerFloorToLowest);
                        return;
                        break;
                }
                break;
        }
    }
    G_ExitLevel ();
}

