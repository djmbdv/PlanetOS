            eatkey = chat_on;
            HUlib_resetIText (w_chat);
            HU_queueChatChar ((char) 5);
        }
        else 
        if ((netgame != 0) && (numplayers > 2)) 
        {
            for (i = 0; i < 4; i++) 
            {
                if (ev.data2 == key_multi_msgplayer[(int) (i)]) 
                {
                    if ((playeringame[(int) (i)] != 0) && (i != consoleplayer)) 
                    {
                        chat_on = 1;
                        eatkey = chat_on;
                        HUlib_resetIText (w_chat);
                        HU_queueChatChar ((char) ((i + 1)));
                        break;
                    }
                    else 
                    if (i == consoleplayer) 
                    {
                        num_nobrainers++;
                        if (num_nobrainers < 3) {
                            plr.message = "You mumble to yourself";
                        }
                        else 
                        if (num_nobrainers < 6) {
                            plr.message = "Who's there?";
                        }
                        else 
                        if (num_nobrainers < 9) {
                            plr.message = "You scare yourself";
                        }
                        else 
                        if (num_nobrainers < 32) {
                            plr.message = "You start to rave";
                        }
                        else {
                            plr.message = "You've lost it...";
                        }
                    }
                }
            }
        }
    }
    else 
    {
        if (altdown != 0) 
        {
            c = (uchar) ((ev.data1 - ((int) '0')));
            if (((int) c) > 9) {
                return (uint32) 0;
            }
            macromessage = c_str_to_bytes (chat_macros[(int) (c)]);
            _off_macromessage = 0;
            HU_queueChatChar ((char) 13);
            while (macromessage[_off_macromessage] != 0) {
                HU_queueChatChar (macromessage[_off_macromessage++]);
            }
            HU_queueChatChar ((char) 13);
            chat_on = (uint32) 0;
            M_StringCopy (lastmessage, c_str_to_bytes (chat_macros[(int) (c)]), ((int) ((80 + 1)) * (int) (1)));
            plr.message = (string) lastmessage;
            eatkey = (uint32) 1;
        }
        else 
        {
            c = (uchar) ev.data2;
            eatkey = HUlib_keyInIText (w_chat, c);
            if (eatkey != 0) 
            {
                HU_queueChatChar ((char) c);
            }
            if (((int) c) == 13) 
            {
                chat_on = (uint32) 0;
                if (w_chat.l.len != 0) 
                {
                    M_StringCopy (lastmessage, w_chat.l.l, ((int) ((80 + 1)) * (int) (1)));
                    plr.message = (string) lastmessage;
                }
            }
