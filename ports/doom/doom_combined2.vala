    {
        angle = R_PointToAngle2 (player.mo.x, player.mo.y, player.attacker.x, player.attacker.y);
        delta = (angle - player.mo.angle);
        if ((delta < ((uint32) (0x40000000 / 18))) || (delta > ((uint32) (-(0x40000000 / 18))))) 
        {
