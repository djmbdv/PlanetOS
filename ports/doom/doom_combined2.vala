// c2vala-ptrs: skytexturename_obj[PLAIN]=>T?
void G_InitNew (skill_t skill, int episode, int map) {
    uint8[] skytexturename = new uint8[0];
    int i = 0;
    if (paused != 0) 
    {
        paused = (uint32) 0;
        0;
    }
    if (skill > skill_t.sk_nightmare) {
        skill = skill_t.sk_nightmare;
    }
    if (gameversion >= GameVersion_t.exe_ultimate) 
    {
        if (episode == 0) 
        {
            episode = 4;
        }
    }
    else 
    {
        if (episode < 1) 
        {
            episode = 1;
        }
        if (episode > 3) 
        {
            episode = 3;
        }
    }
    if ((episode > 1) && (gamemode == GameMode_t.shareware)) 
    {
        episode = 1;
    }
    if (map < 1) {
        map = 1;
    }
    if ((map > 9) && (gamemode != GameMode_t.commercial)) {
        map = 9;
    }
    M_ClearRandom ();
    if ((skill == skill_t.sk_nightmare) || (respawnparm != 0)) {
        respawnmonsters = (uint32) 1;
    }
    else {
        respawnmonsters = (uint32) 0;
    }
    if ((fastparm != 0) || ((skill == skill_t.sk_nightmare) && (gameskill != skill_t.sk_nightmare))) 
    {
        for (i = (int) statenum_t.S_SARG_RUN1; i <= ((int) statenum_t.S_SARG_PAIN2); i++) {
            states[(int) (i)].tics >>= 1;
        }
        mobjinfo[(int) (mobjtype_t.MT_BRUISERSHOT)].speed = (20 * (1 << 16));
        mobjinfo[(int) (mobjtype_t.MT_HEADSHOT)].speed = (20 * (1 << 16));
        mobjinfo[(int) (mobjtype_t.MT_TROOPSHOT)].speed = (20 * (1 << 16));
    }
    else 
    if ((skill != skill_t.sk_nightmare) && (gameskill == skill_t.sk_nightmare)) 
    {
        for (i = (int) statenum_t.S_SARG_RUN1; i <= ((int) statenum_t.S_SARG_PAIN2); i++) {
            states[(int) (i)].tics <<= 1;
        }
        mobjinfo[(int) (mobjtype_t.MT_BRUISERSHOT)].speed = (15 * (1 << 16));
        mobjinfo[(int) (mobjtype_t.MT_HEADSHOT)].speed = (10 * (1 << 16));
        mobjinfo[(int) (mobjtype_t.MT_TROOPSHOT)].speed = (10 * (1 << 16));
    }
    for (i = 0; i < 4; i++) {
        players[(int) (i)].playerstate = playerstate_t.PST_REBORN;
    }
    usergame = (uint32) 1;
    paused = (uint32) 0;
    demoplayback = (uint32) 0;
    automapactive = (uint32) 0;
    viewactive = (uint32) 1;
    gameepisode = episode;
    gamemap = map;
    gameskill = skill;
    viewactive = (uint32) 1;
    if (gamemode == GameMode_t.commercial) 
    {
        if (gamemap < 12) {
            skytexturename = c_str_to_bytes ("SKY1");
        }
        else 
        if (gamemap < 21) {
            skytexturename = c_str_to_bytes ("SKY2");
        }
        else {
            skytexturename = c_str_to_bytes ("SKY3");
        }
    }
    else 
    {
        switch (gameepisode) {
            default:
            case 1:
                skytexturename = c_str_to_bytes ("SKY1");
                break;
            case 2:
                skytexturename = c_str_to_bytes ("SKY2");
                break;
            case 3:
                skytexturename = c_str_to_bytes ("SKY3");
                break;
            case 4:
                skytexturename = c_str_to_bytes ("SKY4");
                break;
        }
    }
    skytexturename = skytexturename;
    skytexture = R_TextureNumForName (skytexturename);
    G_DoLoadLevel ();
}

