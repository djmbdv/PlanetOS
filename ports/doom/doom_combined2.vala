// c2vala-ptrs: player_obj[DEREF|ARROW]=>T?
void P_Thrust (player_s? player, uint32 angle, int move) {
    angle >>= (uint32) 19;
    player.mo.momx += FixedMul (move, finecosine[(int) (angle)]);
    player.mo.momy += FixedMul (move, finesine[(int) (angle)]);
