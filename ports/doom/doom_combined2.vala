        case 108:
            return c_str_to_bytes ("v1.8");
        case 109:
            return c_str_to_bytes ("v1.9");
        default:
            break;
    }
    if ((version >= 0) && (version <= 4)) 
    {
        return c_str_to_bytes ("v1.0/v1.1/v1.2");
    }
    else 
    {
        M_snprintf (resultbuf, ((int) (16) * (int) (1)), c_str_to_bytes ("%i.%i (unknown)"), (version / 100), (version % 100));
        return resultbuf;
    }
