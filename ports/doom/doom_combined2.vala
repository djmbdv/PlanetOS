void D_Display () {
    uint32 viewactivestate = (uint32) 0;
    uint32 menuactivestate = (uint32) 0;
    uint32 inhelpscreensstate = (uint32) 0;
    uint32 fullscreen = (uint32) 0;
    gamestate_t oldgamestate = (gamestate_t) (-1);
    int borderdrawcount = 0;
    int nowtime = 0;
    int tics = 0;
    int wipestart = 0;
    int y = 0;
    uint32 done = 0;
    uint32 wipe = 0;
    uint32 redrawsbar = 0;
    if (nodrawers != 0) {
        return;
    }
    redrawsbar = (uint32) 0;
    if (setsizeneeded != 0) 
    {
        R_ExecuteSetViewSize ();
        oldgamestate = (gamestate_t) (-1);
        borderdrawcount = 3;
    }
    if (gamestate != wipegamestate) 
    {
        wipe = (uint32) 1;
        wipe_StartScreen (0, 0, 320, 200);
    }
    else {
        wipe = (uint32) 0;
    }
    if ((gamestate == gamestate_t.GS_LEVEL) && (gametic != 0)) {
        HU_Erase ();
    }
    switch (gamestate) {
        case gamestate_t.GS_LEVEL:
            if (!(gametic != 0)) {
                break;
            }
            if (automapactive != 0) {
                AM_Drawer ();
            }
            if ((wipe != 0) || ((viewheight != 200) && (fullscreen != 0))) {
                redrawsbar = (uint32) 1;
            }
            if ((inhelpscreensstate != 0) && (!(inhelpscreens != 0))) {
                redrawsbar = (uint32) 1;
            }
            ST_Drawer ((uint32) (((viewheight == 200)) ? 1 : 0), redrawsbar);
            fullscreen = (uint32) (((viewheight == 200)) ? 1 : 0);
            break;
        case gamestate_t.GS_INTERMISSION:
            WI_Drawer ();
            break;
        case gamestate_t.GS_FINALE:
            F_Drawer ();
            break;
        case gamestate_t.GS_DEMOSCREEN:
            D_PageDrawer ();
            break;
    }
    I_UpdateNoBlit ();
    if (((gamestate == gamestate_t.GS_LEVEL) && (!(automapactive != 0))) && (gametic != 0)) {
        R_RenderPlayerView (_c2v_box_player_s_obj (_c2v_slice_player_s (players, (int) (displayplayer))));
    }
    if ((gamestate == gamestate_t.GS_LEVEL) && (gametic != 0)) {
        HU_Drawer ();
    }
    if ((gamestate != oldgamestate) && (gamestate != gamestate_t.GS_LEVEL)) {
        I_SetPalette (W_CacheLumpName (c_str_to_bytes ("PLAYPAL"), (int) __anon_enum_1.PU_CACHE));
    }
    if ((gamestate == gamestate_t.GS_LEVEL) && (oldgamestate != gamestate_t.GS_LEVEL)) 
    {
        viewactivestate = (uint32) 0;
        R_FillBackScreen ();
    }
    if (((gamestate == gamestate_t.GS_LEVEL) && (!(automapactive != 0))) && (scaledviewwidth != 320)) 
    {
        if (((menuactive != 0) || (menuactivestate != 0)) || (!(viewactivestate != 0))) {
            borderdrawcount = 3;
        }
        if (borderdrawcount != 0) 
        {
            R_DrawViewBorder ();
            borderdrawcount--;
        }
    }
    if (testcontrols != 0) 
    {
        V_DrawMouseSpeedBox (testcontrols_mousespeed);
    }
    menuactivestate = menuactive;
    viewactivestate = viewactive;
    inhelpscreensstate = inhelpscreens;
    wipegamestate = gamestate;
    oldgamestate = wipegamestate;
    if (paused != 0) 
    {
        if (automapactive != 0) {
            y = 4;
        }
        else {
            y = (viewwindowy + 4);
        }
        V_DrawPatchDirect ((viewwindowx + ((scaledviewwidth - 68) / 2)), y, new patch_t.at (W_CacheLumpName (c_str_to_bytes ("M_PAUSE"), (int) __anon_enum_1.PU_CACHE), 0));
    }
    M_Drawer ();
    NetUpdate ();
    if (!(wipe != 0)) 
    {
        I_FinishUpdate ();
        return;
    }
    wipe_EndScreen (0, 0, 320, 200);
    wipestart = (I_GetTime () - 1);
    do {
        do {
            nowtime = I_GetTime ();
            tics = (nowtime - wipestart);
            I_Sleep (1);
        } while (tics <= 0);
        wipestart = nowtime;
        done = (uint32) (wipe_ScreenWipe ((int) __anon_enum_102.wipe_Melt, 0, 0, 320, 200, tics));
        I_UpdateNoBlit ();
        M_Drawer ();
        I_FinishUpdate ();
    } while (!(done != 0));
}

