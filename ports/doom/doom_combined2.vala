        STlib_updateMultIcon (_c2v_box_st_multicon_t_obj (_c2v_slice_st_multicon_t (w_keyboxes, (int) (i))), refresh);
    }
    STlib_updateNum (w_frags, refresh);
}

void ST_doRefresh () {
    st_firsttime = (uint32) 0;
    ST_refreshBackground ();
    ST_drawWidgets ((uint32) 1);
}

void ST_diffDraw () {
    ST_drawWidgets ((uint32) 0);
}

void ST_Drawer (uint32 fullscreen, uint32 refresh) {
    st_statusbaron = (uint32) ((((!(fullscreen != 0)) || (automapactive != 0))) ? 1 : 0);
    st_firsttime = (uint32) ((((st_firsttime != 0) || (refresh != 0))) ? 1 : 0);
    ST_doPaletteStuff ();
    if (st_firsttime != 0) {
