int cht_CheckCheat (cheatseq_t? cht, char key) {
    if ((cht.parameter_chars > 0) && (((size_t) c_strlen ((string) cht.sequence)) < cht.sequence_len)) {
        return 0;
    }
    if (cht.chars_read < ((size_t) c_strlen ((string) cht.sequence))) 
    {
        if (key == cht.sequence[(int) (cht.chars_read)]) {
            ++cht.chars_read;
        }
        else {
            cht.chars_read = (size_t) 0;
        }
        cht.param_chars_read = 0;
    }
    else 
    if (cht.param_chars_read < cht.parameter_chars) 
    {
        cht.parameter_buf[(int) (cht.param_chars_read)] = (uint8) key;
        ++cht.param_chars_read;
    }
    if ((cht.chars_read >= ((size_t) c_strlen ((string) cht.sequence))) && (cht.param_chars_read >= cht.parameter_chars)) 
    {
        cht.param_chars_read = 0;
        cht.chars_read = cht.param_chars_read;
        return 1;
    }
    return 0;
}

