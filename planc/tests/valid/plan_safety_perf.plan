// Regression tests for Plan safety & performance improvements:
// 1. SliceExpr on refcounted string[] (no double-free / UAF)
// 2. SIMD_ARR_COPY on string[] (must not raw-memcpy refs) & uint8[]/uint16[] SIMD_ARR_FILL (-O2)
// 3. defer in void fallthrough, try/catch scoping, and break/continue
// 4. Effects analysis with defer modifying index inside requires-BCE function
// 5. Simd [NoAlloc] usage

[NoAlloc]
int simd_noalloc_test (uint64 mask) {
    return Simd.popcount (mask)
}

int simd_vec_test () {
    var v1 = Simd.u32x4.splat (3u)
    var v2 = Simd.u32x4.make (1u, 2u, 3u, 4u)
    var v3 = v1.add (v2)
    return (int) v3.w
}

void test_defer_fallthrough (int[] log) {
    defer log[0] = log[0] + 10
    log[0] = 1
}

int test_defer_try_catch! () {
    int trace = 0
    defer trace = trace * 10 + 9
    try {
        defer trace = trace * 10 + 1
        errdefer trace = trace * 10 + 2
        throws -5
    } catch (int e) {
        trace = trace * 10 + 3
    }
    return trace
}

int test_defer_loop () {
    int acc = 0
    for (int i = 0; i < 4; i++) {
        defer acc += 1
        if (i == 1) continue
        if (i == 2) break
        acc += 10
    }
    return acc
}

int test_slice_strings () {
    string[] arr = { "alpha" + "1", "beta" + "2", "gamma" + "3", "delta" + "4" }
    string[] sub = arr[1:3]
    int ok = (sub.length == 2 && sub[0] == "beta2" && sub[1] == "gamma3") ? 1 : 0
    return ok
}

int test_copy_strings_o2 () {
    string[] src = { "one" + "!", "two" + "!", "three" + "!" }
    string[] dst = new string[3]
    for (int i = 0; i < dst.length; i++)
        dst[i] = src[i]
    return (dst[0] == "one!" && dst[2] == "three!") ? 1 : 0
}

int test_fill_u8_u16_o2 () {
    uint8[] b = new uint8[35]
    for (int i = 0; i < b.length; i++)
        b[i] = 0x5A
    uint16[] w = new uint16[19]
    for (int i = 0; i < w.length; i++)
        w[i] = 0x1234
    return (b[0] == 0x5A && b[34] == 0x5A && w[0] == 0x1234 && w[18] == 0x1234) ? 1 : 0
}

int main () {
    int[] log = new int[1]
    test_defer_fallthrough (log)
    if (log[0] != 11) return 1

    int tr = 0
    try {
        tr = test_defer_try_catch! ()
    } catch (int e) {
        return 2
    }
    // LIFO inside try: errdefer (2) then defer (1), then catch (3) -> 213.
    // Outer defer (9) runs on return after tr is evaluated.
    if (tr != 213) return 3

    // i=0: acc+=10 (10), defer acc+=1 (11)
    // i=1: continue -> defer acc+=1 (12)
    // i=2: break -> defer acc+=1 (13)
    if (test_defer_loop () != 13) return 4

    if (test_slice_strings () != 1) return 5
    if (test_copy_strings_o2 () != 1) return 6
    if (test_fill_u8_u16_o2 () != 1) return 7

    if (simd_noalloc_test (0xF0UL) != 4) return 8
    if (simd_vec_test () != 7) return 9

    print ("plan_safety_perf OK\n")
    return 0
}
