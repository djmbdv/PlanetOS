# planc build output
/planc/build/

# Experiment temporary outputs
/experiments/e01-dialect/ejecutables/*
!/experiments/e01-dialect/ejecutables/.gitkeep

# Vala / C / ELF intermediate and binary artifacts
*.vala.c
*.o
*.a
*.so
/build/
/out/

# Editor and OS files
*~
*.swp
.DS_Store

# Python bytecode
__pycache__/
*.pyc

# c2vala: third-party corpus fetched on demand
tools/c2vala_tests/cases/jsmn/jsmn.h
tools/c2vala/build/

# c2vala test runner generated artifacts
tools/c2vala_tests/cases/*/*.exe
tools/c2vala_tests/cases/*/translated.vala
