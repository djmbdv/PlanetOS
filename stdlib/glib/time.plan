// Pure-Vala GLib.Time (valadoc.org/glib-2.0/GLib.Time.html) and clock helpers.
using Planet;

namespace GLib {

    public struct Time {
        public int second;
        public int minute;
        public int hour;
        public int day;
        public int month;
        public int year;
        public int weekday;
        public int day_of_year;
        public int isdst;

        private static bool is_leap (int full_year) {
            if (full_year % 4 != 0)
                return false;
            if (full_year % 100 != 0)
                return true;
            return (full_year % 400 == 0);
        }

        private static int days_in_month (int full_year, int mon0) {
            switch (mon0) {
                case 0: return 31;
                case 1: return is_leap (full_year) ? 29 : 28;
                case 2: return 31;
                case 3: return 30;
                case 4: return 31;
                case 5: return 30;
                case 6: return 31;
                case 7: return 31;
                case 8: return 30;
                case 9: return 31;
                case 10: return 30;
                case 11: return 31;
                default: return 30;
            }
        }

        private static int64 floor_div (int64 a, int64 b) {
            int64 q = a / b;
            int64 r = a % b;
            if (r != 0 && ((r < 0) != (b < 0)))
                q--;
            return q;
        }

        private static int64 floor_mod (int64 a, int64 b) {
            int64 r = a % b;
            if (r != 0 && ((r < 0) != (b < 0)))
                r += b;
            return r;
        }

        public static Time gm (int64 time) {
            int64 days = floor_div (time, 86400);
            int64 rem = floor_mod (time, 86400);

            Time tm = Time ();
            tm.hour = (int) (rem / 3600);
            rem = rem % 3600;
            tm.minute = (int) (rem / 60);
            tm.second = (int) (rem % 60);
            tm.isdst = 0;

            // 1970-01-01 was a Thursday (weekday = 4).
            tm.weekday = (int) floor_mod (days + 4, 7);

            // Howard Hinnant's civil-from-days algorithm (epoch 1970-01-01).
            int64 z = days + 719468;
            int64 era = (z >= 0 ? z : z - 146096) / 146097;
            int64 doe = z - era * 146097;
            int64 yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
            int64 y = yoe + era * 400;
            int64 doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
            int64 mp = (5 * doy + 2) / 153;
            int d = (int) (doy - (153 * mp + 2) / 5 + 1);
            int m = (int) (mp + (mp < 10 ? 3 : -9));
            int full_y = (int) (y + (m <= 2 ? 1 : 0));

            tm.year = full_y - 1900;
            tm.month = m - 1;
            tm.day = d;

            int yday = 0;
            for (int i = 0; i < tm.month; i++)
                yday += days_in_month (full_y, i);
            tm.day_of_year = yday + (d - 1);
            return tm;
        }

        // Local time as configured by TZ/PLANET_TZ; UTC when unset.
        public static Time local (int64 time) {
            var tz = TimeZone.new_local ();
            return gm (time + (int64) tz.get_offset (time));
        }

        public int64 mktime () {
            int full_y = year + 1900;
            int m = month + 1;
            int d = day;

            // Normalize month overflow/underflow into full_y.
            if (m < 1 || m > 12) {
                int adj_y = (int) floor_div ((int64) (m - 1), 12);
                full_y += adj_y;
                m = (int) floor_mod ((int64) (m - 1), 12) + 1;
            }

            int64 y = (int64) full_y - (m <= 2 ? 1 : 0);
            int64 era = (y >= 0 ? y : y - 399) / 400;
            int64 yoe = y - era * 400;
            int64 doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;
            int64 doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
            int64 days = era * 146097 + doe - 719468;

            return days * 86400 + (int64) hour * 3600 + (int64) minute * 60 + (int64) second;
        }

        private static string pad2 (int v) {
            if (v < 0)
                return v.to_string ();
            if (v < 10)
                return "0" + v.to_string ();
            return v.to_string ();
        }

        private static string pad4 (int v) {
            if (v < 0)
                return v.to_string ();
            if (v < 10) return "000" + v.to_string ();
            if (v < 100) return "00" + v.to_string ();
            if (v < 1000) return "0" + v.to_string ();
            return v.to_string ();
        }

        private static string pad_space2 (int v) {
            if (v >= 0 && v < 10)
                return " " + v.to_string ();
            return v.to_string ();
        }

        private static string pad3 (int v) {
            if (v < 0) return v.to_string ();
            if (v < 10) return "00" + v.to_string ();
            if (v < 100) return "0" + v.to_string ();
            return v.to_string ();
        }

        private static string abbr_wday (int w) {
            switch (w) {
                case 0: return "Sun";
                case 1: return "Mon";
                case 2: return "Tue";
                case 3: return "Wed";
                case 4: return "Thu";
                case 5: return "Fri";
                case 6: return "Sat";
                default: return "?";
            }
        }

        private static string full_wday (int w) {
            switch (w) {
                case 0: return "Sunday";
                case 1: return "Monday";
                case 2: return "Tuesday";
                case 3: return "Wednesday";
                case 4: return "Thursday";
                case 5: return "Friday";
                case 6: return "Saturday";
                default: return "?";
            }
        }

        private static string abbr_month (int m) {
            switch (m) {
                case 0: return "Jan";
                case 1: return "Feb";
                case 2: return "Mar";
                case 3: return "Apr";
                case 4: return "May";
                case 5: return "Jun";
                case 6: return "Jul";
                case 7: return "Aug";
                case 8: return "Sep";
                case 9: return "Oct";
                case 10: return "Nov";
                case 11: return "Dec";
                default: return "?";
            }
        }

        private static string full_month (int m) {
            switch (m) {
                case 0: return "January";
                case 1: return "February";
                case 2: return "March";
                case 3: return "April";
                case 4: return "May";
                case 5: return "June";
                case 6: return "July";
                case 7: return "August";
                case 8: return "September";
                case 9: return "October";
                case 10: return "November";
                case 11: return "December";
                default: return "?";
            }
        }

        public string format (string fmt) {
            var sb = new StringBuilder ();
            int n = fmt.length;
            int full_y = year + 1900;
            for (int i = 0; i < n; i++) {
                char c = fmt[i];
                if (c != '%' || i + 1 >= n) {
                    sb.append_c (c);
                    continue;
                }
                i++;
                char sp = fmt[i];
                if (sp == '%') {
                    sb.append_c ('%');
                } else if (sp == 'Y') {
                    sb.append (pad4 (full_y));
                } else if (sp == 'y') {
                    int yy = full_y % 100;
                    if (yy < 0) yy += 100;
                    sb.append (pad2 (yy));
                } else if (sp == 'm') {
                    sb.append (pad2 (month + 1));
                } else if (sp == 'd') {
                    sb.append (pad2 (day));
                } else if (sp == 'e') {
                    sb.append (pad_space2 (day));
                } else if (sp == 'H') {
                    sb.append (pad2 (hour));
                } else if (sp == 'I') {
                    int h12 = hour % 12;
                    if (h12 == 0) h12 = 12;
                    sb.append (pad2 (h12));
                } else if (sp == 'M') {
                    sb.append (pad2 (minute));
                } else if (sp == 'S') {
                    sb.append (pad2 (second));
                } else if (sp == 'p') {
                    sb.append (hour < 12 ? "AM" : "PM");
                } else if (sp == 'P') {
                    sb.append (hour < 12 ? "am" : "pm");
                } else if (sp == 'j') {
                    sb.append (pad3 (day_of_year + 1));
                } else if (sp == 'w') {
                    sb.append (weekday.to_string ());
                } else if (sp == 'u') {
                    sb.append ((weekday == 0 ? 7 : weekday).to_string ());
                } else if (sp == 'a') {
                    sb.append (abbr_wday (weekday));
                } else if (sp == 'A') {
                    sb.append (full_wday (weekday));
                } else if (sp == 'b' || sp == 'h') {
                    sb.append (abbr_month (month));
                } else if (sp == 'B') {
                    sb.append (full_month (month));
                } else if (sp == 'F') {
                    sb.append (pad4 (full_y));
                    sb.append_c ('-');
                    sb.append (pad2 (month + 1));
                    sb.append_c ('-');
                    sb.append (pad2 (day));
                } else if (sp == 'T' || sp == 'X') {
                    sb.append (pad2 (hour));
                    sb.append_c (':');
                    sb.append (pad2 (minute));
                    sb.append_c (':');
                    sb.append (pad2 (second));
                } else if (sp == 'R') {
                    sb.append (pad2 (hour));
                    sb.append_c (':');
                    sb.append (pad2 (minute));
                } else if (sp == 'D' || sp == 'x') {
                    int yy = full_y % 100;
                    if (yy < 0) yy += 100;
                    sb.append (pad2 (month + 1));
                    sb.append_c ('/');
                    sb.append (pad2 (day));
                    sb.append_c ('/');
                    sb.append (pad2 (yy));
                } else if (sp == 'c') {
                    sb.append (format ("%a %b %e %H:%M:%S %Y"));
                } else if (sp == 'n') {
                    sb.append_c ('\n');
                } else if (sp == 't') {
                    sb.append_c ('\t');
                } else if (sp == 's') {
                    sb.append (mktime ().to_string ());
                } else if (sp == 'Z') {
                    sb.append ("UTC");
                } else if (sp == 'z') {
                    sb.append ("+0000");
                } else {
                    sb.append_c ('%');
                    sb.append_c (sp);
                }
            }
            return sb.str;
        }

        public size_t strftime (uint8[] s, string fmt) {
            if (s.length == 0)
                return 0;
            string out_s = format (fmt);
            int n = out_s.length;
            if (n >= s.length)
                return 0;
            for (int i = 0; i < n; i++)
                s[i] = (uint8) out_s[i];
            s[n] = 0;
            return (size_t) n;
        }

        private static bool parse_digits (string buf, ref int pos, int max_digits, out int val) {
            val = 0;
            int n = buf.length;
            int count = 0;
            while (pos < n && count < max_digits) {
                char c = buf[pos];
                if (c < '0' || c > '9')
                    break;
                val = val * 10 + (int) (c - '0');
                pos++;
                count++;
            }
            return count > 0;
        }

        public string? strptime (string buf, string fmt) {
            int bi = 0;
            int bn = buf.length;
            int fn = fmt.length;
            for (int fi = 0; fi < fn; fi++) {
                char fc = fmt[fi];
                if (fc == ' ' || fc == '\t' || fc == '\n') {
                    while (bi < bn && (buf[bi] == ' ' || buf[bi] == '\t' || buf[bi] == '\n'))
                        bi++;
                    continue;
                }
                if (fc != '%' || fi + 1 >= fn) {
                    if (bi >= bn || buf[bi] != fc)
                        return null;
                    bi++;
                    continue;
                }
                fi++;
                char sp = fmt[fi];
                int v = 0;
                if (sp == '%') {
                    if (bi >= bn || buf[bi] != '%')
                        return null;
                    bi++;
                } else if (sp == 'Y') {
                    if (!parse_digits (buf, ref bi, 4, out v)) return null;
                    year = v - 1900;
                } else if (sp == 'm') {
                    if (!parse_digits (buf, ref bi, 2, out v) || v < 1 || v > 12) return null;
                    month = v - 1;
                } else if (sp == 'd') {
                    if (!parse_digits (buf, ref bi, 2, out v) || v < 1 || v > 31) return null;
                    day = v;
                } else if (sp == 'H') {
                    if (!parse_digits (buf, ref bi, 2, out v) || v < 0 || v > 23) return null;
                    hour = v;
                } else if (sp == 'M') {
                    if (!parse_digits (buf, ref bi, 2, out v) || v < 0 || v > 59) return null;
                    minute = v;
                } else if (sp == 'S') {
                    if (!parse_digits (buf, ref bi, 2, out v) || v < 0 || v > 60) return null;
                    second = v;
                } else if (sp == 'F') {
                    int yv = 0;
                    int mv = 0;
                    int dv = 0;
                    if (!parse_digits (buf, ref bi, 4, out yv)) return null;
                    if (bi >= bn || buf[bi] != '-') return null;
                    bi++;
                    if (!parse_digits (buf, ref bi, 2, out mv) || mv < 1 || mv > 12) return null;
                    if (bi >= bn || buf[bi] != '-') return null;
                    bi++;
                    if (!parse_digits (buf, ref bi, 2, out dv) || dv < 1 || dv > 31) return null;
                    year = yv - 1900;
                    month = mv - 1;
                    day = dv;
                } else if (sp == 'T') {
                    int hv = 0;
                    int mv = 0;
                    int sv = 0;
                    if (!parse_digits (buf, ref bi, 2, out hv) || hv < 0 || hv > 23) return null;
                    if (bi >= bn || buf[bi] != ':') return null;
                    bi++;
                    if (!parse_digits (buf, ref bi, 2, out mv) || mv < 0 || mv > 59) return null;
                    if (bi >= bn || buf[bi] != ':') return null;
                    bi++;
                    if (!parse_digits (buf, ref bi, 2, out sv) || sv < 0 || sv > 60) return null;
                    hour = hv;
                    minute = mv;
                    second = sv;
                } else {
                    return null;
                }
            }
            return buf.substring (bi);
        }

        public string to_string () {
            return format ("%Y-%m-%d %H:%M:%S");
        }
    }

    /**
     * Seconds since the Unix epoch, decoded from the packed RTC fields the
     * kernel returns through SYS_RTC_TIME.
     */
    public int64 get_real_time_seconds () {
        int pk = Sys.rtc_time ();
        Time tm = Time ();
        tm.year = 2000 + ((pk >> 26) & 0x3f) - 1900;
        tm.month = ((pk >> 22) & 0x0f) - 1;
        tm.day = (pk >> 17) & 0x1f;
        tm.hour = (pk >> 12) & 0x1f;
        tm.minute = (pk >> 6) & 0x3f;
        tm.second = pk & 0x3f;
        return tm.mktime ();
    }

    public int64 get_real_time () {
        return get_real_time_seconds () * 1000000L;
    }

    public const int64 TIME_SPAN_DAY = 86400000000L;
    public const int64 TIME_SPAN_HOUR = 3600000000L;
    public const int64 TIME_SPAN_MINUTE = 60000000L;
    public const int64 TIME_SPAN_SECOND = 1000000L;
    public const int64 TIME_SPAN_MILLISECOND = 1000L;

    /**
     * Immutable UTC date/time with microsecond resolution (GLib.DateTime).
     */
    public class DateTime : Object {
        private int64 usec;
        private Time tm;
        private TimeZone zone;

        private static int64 floor_secs (int64 us) {
            int64 secs = us / TIME_SPAN_SECOND;
            if (us < 0 && (us % TIME_SPAN_SECOND) != 0)
                secs--;
            return secs;
        }

        private void refresh () {
            int64 secs = floor_secs (usec);
            tm = Time.gm (secs + (int64) zone.get_offset (secs));
        }

        private DateTime (int64 us) {
            usec = us;
            zone = TimeZone.utc ();
            refresh ();
        }

        private DateTime.zoned (int64 us, TimeZone tz) {
            usec = us;
            zone = tz;
            refresh ();
        }

        public static DateTime now_utc () {
            return new DateTime (get_real_time ());
        }

        public static DateTime now_local () {
            return new DateTime.zoned (get_real_time (), TimeZone.new_local ());
        }

        public static DateTime from_unix_utc (int64 t) {
            return new DateTime (t * TIME_SPAN_SECOND);
        }

        public static DateTime from_unix_local (int64 t) {
            return new DateTime.zoned (t * TIME_SPAN_SECOND, TimeZone.new_local ());
        }

        public DateTime to_local () {
            return new DateTime.zoned (usec, TimeZone.new_local ());
        }

        public DateTime to_utc () {
            return new DateTime.zoned (usec, TimeZone.utc ());
        }

        public DateTime to_timezone (TimeZone tz) {
            return new DateTime.zoned (usec, tz);
        }

        public TimeZone get_timezone () {
            return zone;
        }

        public DateWeekday get_weekday () {
            int d = tm.weekday;
            return (d == 0) ? DateWeekday.SUNDAY : (DateWeekday) d;
        }

        public int get_day_of_week () {
            return tm.weekday;
        }

        public int get_day_of_year () {
            return tm.day_of_year;
        }

        public string format (string fmt) {
            return tm.format (fmt);
        }

        public int64 to_unix () {
            return floor_secs (usec);
        }

        public int get_year () { return tm.year + 1900; }
        public int get_month () { return tm.month + 1; }
        public int get_day_of_month () { return tm.day; }
        public int get_hour () { return tm.hour; }
        public int get_minute () { return tm.minute; }
        public int get_second () { return tm.second; }

        public int get_microsecond () {
            int64 rem = usec % TIME_SPAN_SECOND;
            if (rem < 0) rem += TIME_SPAN_SECOND;
            return (int) rem;
        }

        public DateTime add (int64 span) {
            return new DateTime.zoned (usec + span, zone);
        }

        public DateTime add_seconds (double seconds) {
            return new DateTime.zoned (usec + (int64) (seconds * 1000000.0), zone);
        }

        public int64 difference (DateTime begin) {
            return usec - begin.usec;
        }

        public int compare (DateTime other) {
            if (usec < other.usec) return -1;
            if (usec > other.usec) return 1;
            return 0;
        }

        public bool equal (DateTime other) {
            return usec == other.usec;
        }

        public string format_iso8601 () {
            string stamp = tm.format ("%Y-%m-%dT%H:%M:%S");
            if (zone.is_utc ())
                return stamp + "Z";
            return stamp + zone.offset_string (to_unix ());
        }
    }

    public enum DateDMY {
        DAY = 0,
        MONTH = 1,
        YEAR = 2
    }

    public enum DateMonth {
        BAD_MONTH = 0,
        JANUARY,
        FEBRUARY,
        MARCH,
        APRIL,
        MAY,
        JUNE,
        JULY,
        AUGUST,
        SEPTEMBER,
        OCTOBER,
        NOVEMBER,
        DECEMBER
    }

    public enum DateWeekday {
        BAD_WEEKDAY = 0,
        MONDAY,
        TUESDAY,
        WEDNESDAY,
        THURSDAY,
        FRIDAY,
        SATURDAY,
        SUNDAY
    }

    /**
     * Gregorian calendar date (GLib.Date). Months and days are 1-based; a zero
     * field means "invalid", the same convention `g_date_clear` uses.
     * Struct constructors are not part of the dialect, so the factories below
     * replace `new Date.dmy (...)`.
    /**
     * Gregorian calendar date (GLib.Date). Months and days are 1-based; a zero
     * field means "invalid", the same convention `g_date_clear` uses.
     *
     * GLib's Date is a struct, but `planc` passes struct `this` by value, so a
     * mutating method could not change the caller's copy. This shim is a class
     * with the same API surface; factories replace `new Date.dmy (...)`.
     */
    public class Date : Object {
        public int day;
        public int month;
        public int year;

        public Date () {
            day = 0;
            month = 0;
            year = 0;
        }

        private static int64 days_from_civil (int y, int m, int d) {
            int64 yy = (int64) y - (m <= 2 ? 1 : 0);
            int64 era = (yy >= 0 ? yy : yy - 399) / 400;
            int64 yoe = yy - era * 400;
            int64 doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;
            int64 doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
            return era * 146097 + doe - 719468;
        }

        private static (int, int, int) civil_from_days (int64 days) {
            int64 z = days + 719468;
            int64 era = (z >= 0 ? z : z - 146096) / 146097;
            int64 doe = z - era * 146097;
            int64 yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
            int64 yr = yoe + era * 400;
            int64 doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
            int64 mp = (5 * doy + 2) / 153;
            int d = (int) (doy - (153 * mp + 2) / 5 + 1);
            int m = (int) (mp + (mp < 10 ? 3 : -9));
            int y = (int) (yr + (m <= 2 ? 1 : 0));
            return (y, m, d);
        }

        [NoAlloc]
        public static bool is_leap (int full_year) {
            if (full_year % 4 != 0)
                return false;
            if (full_year % 100 != 0)
                return true;
            return (full_year % 400 == 0);
        }

        [NoAlloc]
        public static int days_in_month (int full_year, int mon) {
            switch (mon) {
                case 1: return 31;
                case 2: return is_leap (full_year) ? 29 : 28;
                case 3: return 31;
                case 4: return 30;
                case 5: return 31;
                case 6: return 30;
                case 7: return 31;
                case 8: return 31;
                case 9: return 30;
                case 10: return 31;
                case 11: return 30;
                case 12: return 31;
                default: return 0;
            }
        }

        public static DateWeekday weekday_of (int full_year, int mon, int day) {
            int64 dow0 = (days_from_civil (full_year, mon, day) + 4) % 7;
            if (dow0 < 0)
                dow0 += 7;
            return (dow0 == 0) ? DateWeekday.SUNDAY : (DateWeekday) dow0;
        }

        public static Date dmy (int day, int month, int year) {
            var res = new Date ();
            res.day = day;
            res.month = month;
            res.year = year;
            return res;
        }

        public static Date from_days (int64 days) {
            var (y, m, d) = civil_from_days (days);
            return dmy (d, m, y);
        }

        public static Date today () {
            return from_days (get_real_time_seconds () / 86400);
        }

        public bool valid () {
            if (year < 1 || month < 1 || month > 12 || day < 1)
                return false;
            return day <= get_days_in_month ();
        }

        public bool is_leap_year () {
            return is_leap (year);
        }

        public int get_days_in_month () {
            return days_in_month (year, month);
        }

        public static int get_days_in_month_of (DateMonth mon, int full_year) {
            return days_in_month (full_year, (int) mon);
        }

        public int64 to_days () {
            return days_from_civil (year, month, day);
        }

        public int get_day_of_year () {
            return (int) (to_days () - days_from_civil (year, 1, 1)) + 1;
        }

        public DateWeekday get_weekday () {
            return weekday_of (year, month, day);
        }

        public void set_dmy (int day, int month, int year) {
            this.day = day;
            this.month = month;
            this.year = year;
        }

        public void add_days (int n_days) {
            var moved = from_days (to_days () + n_days);
            day = moved.day;
            month = moved.month;
            year = moved.year;
        }

        public void subtract_days (int n_days) {
            add_days (-n_days);
        }

        public void add_months (int n_months) {
            int m = month - 1 + n_months;
            int y = year + (m >= 0 ? m / 12 : (m - 11) / 12);
            int mm = m - (y - year) * 12;
            month = mm + 1;
            year = y;
            int dim = get_days_in_month ();
            if (day > dim)
                day = dim;
        }

        public void add_years (int n_years) {
            year = year + n_years;
            int dim = get_days_in_month ();
            if (day > dim)
                day = dim;
        }

        public int compare (Date other) {
            int64 a = to_days ();
            int64 b = other.to_days ();
            if (a < b) return -1;
            if (a > b) return 1;
            return 0;
        }

        public int days_between (Date other) {
            return (int) (other.to_days () - to_days ());
        }

        public void clamp (Date min, Date max) {
            if (compare (min) < 0) {
                day = min.day;
                month = min.month;
                year = min.year;
            } else if (compare (max) > 0) {
                day = max.day;
                month = max.month;
                year = max.year;
            }
        }

        public string format (string fmt) {
            Time t = Time ();
            t.year = year - 1900;
            t.month = month - 1;
            t.day = day;
            t.weekday = ((int) get_weekday ()) % 7;
            t.day_of_year = get_day_of_year () - 1;
            return t.format (fmt);
        }

        public string to_string () {
            return format ("%Y-%m-%d");
        }
    }

    /**
     * UTC offset lookup (GLib.TimeZone). PlanetOS has no tzdata binary, so this
     * ships a small table of common identifiers plus fixed offsets, and applies
     * the standard EU/US-style DST rules to the zones that observe it.
     */
    public class TimeZone : Object {
        private string id;
        private int32 base_offset;
        private int32 dst_offset;
        private string abbr_std;
        private string abbr_dst;
        private bool southern;

        private static TimeZone? utc_singleton;

        private TimeZone.full (string identifier, int32 std_offset, int32 dst, string std_abbr, string dst_abbr, bool is_southern) {
            id = identifier;
            base_offset = std_offset;
            dst_offset = dst;
            abbr_std = std_abbr;
            abbr_dst = (dst_abbr.length > 0) ? dst_abbr : std_abbr;
            southern = is_southern;
        }

        public static TimeZone utc () {
            if (utc_singleton == null)
                utc_singleton = new TimeZone.full ("UTC", 0, 0, "UTC", "UTC", false);
            return (!) utc_singleton;
        }

        public static TimeZone new_utc () {
            return utc ();
        }

        private static string two (int v) {
            if (v >= 0 && v < 10)
                return "0" + v.to_string ();
            return v.to_string ();
        }

        public static TimeZone new_offset (int32 seconds) {
            string sign = (seconds < 0) ? "-" : "+";
            int32 abs_s = (seconds < 0) ? -seconds : seconds;
            int hh = abs_s / 3600;
            int mm = (abs_s % 3600) / 60;
            string name = @"$sign$(two (hh)):$(two (mm))";
            return new TimeZone.full (name, seconds, 0, name, name, false);
        }

        private static int32 parse_offset! (in string text) {
            if (text.length < 3)
                throws -1;
            char sign = text[0];
            if (sign != '+' && sign != '-')
                throws -1;
            int hh = 0;
            int mm = 0;
            int i = 1;
            int digits = 0;
            while (i < text.length && text[i] >= '0' && text[i] <= '9' && digits < 2) {
                hh = hh * 10 + (int) (text[i] - '0');
                i++;
                digits++;
            }
            if (digits != 2)
                throws -1;
            if (i < text.length && text[i] == ':')
                i++;
            digits = 0;
            while (i < text.length && text[i] >= '0' && text[i] <= '9' && digits < 2) {
                mm = mm * 10 + (int) (text[i] - '0');
                i++;
                digits++;
            }
            if (i != text.length || hh > 14 || mm > 59)
                throws -1;
            int32 total = (int32) (hh * 3600 + mm * 60);
            return (int32) ((sign == '-') ? -total : total);
        }

        public static TimeZone? new_identifier (string? identifier) {
            if (identifier == null)
                return null;
            string key = Str.strip (identifier);
            if (key.length == 0)
                return null;
            if (key == "UTC" || key == "Etc/UTC" || key == "GMT" || key == "Etc/GMT"
                    || key == "UCT" || key == "Universal" || key == "Z")
                return utc ();
            try {
                int32 off = parse_offset! (key);
                return new_offset (off);
            } catch {
            }
            if (key == "America/Caracas")
                return new TimeZone.full (key, -4 * 3600, 0, "-04", "-04", false);
            if (key == "America/Sao_Paulo")
                return new TimeZone.full (key, -3 * 3600, 0, "-03", "-03", false);
            if (key == "America/Mexico_City")
                return new TimeZone.full (key, -6 * 3600, 0, "CST", "CST", false);
            if (key == "America/New_York")
                return new TimeZone.full (key, -5 * 3600, 3600, "EST", "EDT", false);
            if (key == "America/Chicago")
                return new TimeZone.full (key, -6 * 3600, 3600, "CST", "CDT", false);
            if (key == "America/Denver")
                return new TimeZone.full (key, -7 * 3600, 3600, "MST", "MDT", false);
            if (key == "America/Los_Angeles")
                return new TimeZone.full (key, -8 * 3600, 3600, "PST", "PDT", false);
            if (key == "Europe/London")
                return new TimeZone.full (key, 0, 3600, "GMT", "BST", false);
            if (key == "Europe/Lisbon")
                return new TimeZone.full (key, 0, 3600, "WET", "WEST", false);
            if (key == "Europe/Madrid" || key == "Europe/Paris" || key == "Europe/Berlin"
                    || key == "Europe/Rome" || key == "Europe/Amsterdam")
                return new TimeZone.full (key, 3600, 3600, "CET", "CEST", false);
            if (key == "Europe/Kyiv" || key == "Europe/Athens")
                return new TimeZone.full (key, 2 * 3600, 3600, "EET", "EEST", false);
            if (key == "Europe/Moscow")
                return new TimeZone.full (key, 3 * 3600, 0, "MSK", "MSK", false);
            if (key == "Africa/Cairo")
                return new TimeZone.full (key, 2 * 3600, 3600, "EET", "EEST", false);
            if (key == "Africa/Lagos" || key == "Africa/Johannesburg")
                return new TimeZone.full (key, 3600, 0, "WAT", "WAT", false);
            if (key == "Asia/Dubai")
                return new TimeZone.full (key, 4 * 3600, 0, "+04", "+04", false);
            if (key == "Asia/Kolkata" || key == "Asia/Calcutta")
                return new TimeZone.full (key, 5 * 3600 + 1800, 0, "IST", "IST", false);
            if (key == "Asia/Shanghai" || key == "Asia/Hong_Kong")
                return new TimeZone.full (key, 8 * 3600, 0, "CST", "CST", false);
            if (key == "Asia/Tokyo")
                return new TimeZone.full (key, 9 * 3600, 0, "JST", "JST", false);
            if (key == "Australia/Perth")
                return new TimeZone.full (key, 8 * 3600, 0, "AWST", "AWST", false);
            if (key == "Australia/Sydney" || key == "Australia/Melbourne")
                return new TimeZone.full (key, 10 * 3600, 3600, "AEST", "AEDT", true);
            if (key == "Pacific/Auckland")
                return new TimeZone.full (key, 12 * 3600, 3600, "NZST", "NZDT", true);
            return null;
        }

        // Local zone from TZ (or PLANET_TZ), UTC when unset or unknown.
        public static TimeZone new_local () {
            var name = Environment.get_variable ("TZ");
            if (name == null || ((!) name).length == 0)
                name = Environment.get_variable ("PLANET_TZ");
            if (name == null)
                return utc ();
            var tz = new_identifier (name);
            return (tz != null) ? (!) tz : utc ();
        }

        public string get_identifier () {
            return id;
        }

        public bool is_utc () {
            return base_offset == 0 && dst_offset == 0;
        }

        private static int last_sunday (int full_year, int mon) {
            int dim = Date.days_in_month (full_year, mon);
            for (int d = dim; d >= 1; d--) {
                if (Date.weekday_of (full_year, mon, d) == DateWeekday.SUNDAY)
                    return d;
            }
            return dim;
        }

        private static int first_sunday (int full_year, int mon) {
            int dim = Date.days_in_month (full_year, mon);
            for (int d = 1; d <= dim; d++) {
                if (Date.weekday_of (full_year, mon, d) == DateWeekday.SUNDAY)
                    return d;
            }
            return 1;
        }

        private static int64 utc_at (int full_year, int mon, int day, int hour) {
            Time t = Time ();
            t.year = full_year - 1900;
            t.month = mon - 1;
            t.day = day;
            t.hour = hour;
            return t.mktime ();
        }

        private bool in_dst (int64 interval) {
            if (dst_offset == 0)
                return false;
            Time lt = Time.gm (interval + (int64) base_offset);
            int yr = lt.year + 1900;
            if (!southern) {
                int64 start = utc_at (yr, 3, last_sunday (yr, 3), 1);
                int64 end = utc_at (yr, 10, last_sunday (yr, 10), 1);
                return interval >= start && interval < end;
            }
            int64 start = utc_at (yr, 10, first_sunday (yr, 10), 2);
            int64 end = utc_at (yr, 4, first_sunday (yr, 4), 2);
            return interval >= start || interval < end;
        }

        public int32 get_offset (int64 interval) {
            return in_dst (interval) ? (base_offset + dst_offset) : base_offset;
        }

        public string get_abbreviation (int64 interval) {
            return in_dst (interval) ? abbr_dst : abbr_std;
        }

        // "+HH:MM" / "-HH:MM", the ISO-8601 numeric offset at that instant.
        public string offset_string (int64 interval) {
            int32 off = get_offset (interval);
            string sign = (off < 0) ? "-" : "+";
            int32 abs_s = (off < 0) ? -off : off;
            return @"$sign$(two (abs_s / 3600)):$(two ((abs_s % 3600) / 60))";
        }

        public int64 adjust_time (int64 time) {
            return time + (int64) get_offset (time);
        }
    }
}
